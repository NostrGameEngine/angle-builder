 // Shader utilities
 
+// Passthrough varyings carry exact test payloads. Integer bit transport avoids
+// interpolation/validation restrictions on floating NaN and infinity values.
+static void generateTransportDecl(std::ostream &src, const glu::VarType &type, const std::string &qualifier,
+                                  const std::string &name, bool useIntegerTransport)
+{
+    if (useIntegerTransport && type.isBasicType() && glu::isDataTypeFloatOrVec(type.getBasicType()))
+    {
+        const int size = glu::getDataTypeScalarSize(type.getBasicType());
+        const glu::VarType bits(size > 1 ? glu::getDataTypeUintVec(size) : glu::TYPE_UINT, glu::PRECISION_HIGHP);
+        src << qualifier << " " << glu::declare(bits, name) << ";\n";
+    }
+    else if (useIntegerTransport && type.isBasicType() && glu::isDataTypeMatrix(type.getBasicType()))
+    {
+        const int rows = glu::getDataTypeMatrixNumRows(type.getBasicType());
+        const int cols = glu::getDataTypeMatrixNumColumns(type.getBasicType());
+        const glu::VarType bits(glu::getDataTypeUintVec(rows), glu::PRECISION_HIGHP);
+        for (int col = 0; col < cols; ++col)
+            src << qualifier << " " << glu::declare(bits, name + "_c" + de::toString(col)) << ";\n";
+    }
+    else
+        src << qualifier << " " << glu::declare(type, name) << ";\n";
+}
+
+static void generateTransportStore(std::ostream &src, const glu::VarType &type, const std::string &value,
+                                   const std::string &name, bool useIntegerTransport)
+{
+    if (useIntegerTransport && type.isBasicType() && glu::isDataTypeFloatOrVec(type.getBasicType()))
+        src << "\t" << name << " = floatBitsToUint(" << value << ");\n";
+    else if (useIntegerTransport && type.isBasicType() && glu::isDataTypeMatrix(type.getBasicType()))
+    {
+        const int cols = glu::getDataTypeMatrixNumColumns(type.getBasicType());
+        for (int col = 0; col < cols; ++col)
+            src << "\t" << name << "_c" << col << " = floatBitsToUint(" << value << "[" << col << "]);\n";
+    }
+    else
+        src << "\t" << name << " = " << value << ";\n";
+}
+
+static void generateTransportLoad(std::ostream &src, const glu::VarType &type, const std::string &value,
+                                  const std::string &name, bool useIntegerTransport)
+{
+    src << "\t" << glu::declare(type, value) << " = ";
+    if (useIntegerTransport && type.isBasicType() && glu::isDataTypeFloatOrVec(type.getBasicType()))
+        src << "uintBitsToFloat(" << name << ")";
+    else if (useIntegerTransport && type.isBasicType() && glu::isDataTypeMatrix(type.getBasicType()))
+    {
+        const int cols = glu::getDataTypeMatrixNumColumns(type.getBasicType());
+        src << glu::getDataTypeName(type.getBasicType()) << "(";
+        for (int col = 0; col < cols; ++col)
+            src << (col ? ", " : "") << "uintBitsToFloat(" << name << "_c" << col << ")";
+        src << ")";
+    }
+    else if (type.isBasicType() && glu::isDataTypeBoolOrBVec(type.getBasicType()))
+        src << glu::getDataTypeName(type.getBasicType()) << "(" << name << ")";
+    else
+        src << name;
+    src << ";\n";
+}
+
