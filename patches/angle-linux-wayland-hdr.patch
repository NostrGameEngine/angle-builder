+namespace
+{
+// Keep registry dispatch on a private queue. EGL initialization must not dispatch
+// the application's default queue (SDL, GLFW or another toolkit owns it).
+class ScopedWaylandFormatQuery
+{
+  public:
+    explicit ScopedWaylandFormatQuery(wl_display *display) : mDisplay(display) {}
+
+    ~ScopedWaylandFormatQuery()
+    {
+        if (mVkSurface != VK_NULL_HANDLE)
+        {
+            VK_CALL(vkDestroySurfaceKHR, mInstance, mVkSurface, nullptr);
+        }
+        if (mSurface)
+        {
+            wl_surface_destroy(mSurface);
+        }
+        if (mCompositor)
+        {
+            wl_compositor_destroy(mCompositor);
+        }
+        if (mRegistry)
+        {
+            wl_registry_destroy(mRegistry);
+        }
+        if (mWrapper)
+        {
+            wl_proxy_wrapper_destroy(mWrapper);
+        }
+        if (mQueue)
+        {
+            wl_event_queue_destroy(mQueue);
+        }
+    }
+
+    bool initialize(VkInstance instance)
+    {
+        mInstance = instance;
+        mQueue = wl_display_create_queue(mDisplay);
+        if (!mQueue)
+        {
+            return false;
+        }
+        mWrapper = static_cast<wl_display *>(wl_proxy_create_wrapper(mDisplay));
+        if (!mWrapper)
+        {
+            return false;
+        }
+        wl_proxy_set_queue(reinterpret_cast<wl_proxy *>(mWrapper), mQueue);
+        mRegistry = wl_display_get_registry(mWrapper);
+        if (!mRegistry)
+        {
+            return false;
+        }
+        static const wl_registry_listener listener = {HandleGlobal, HandleGlobalRemove};
+        if (wl_registry_add_listener(mRegistry, &listener, this) < 0 ||
+            wl_display_roundtrip_queue(mDisplay, mQueue) < 0 || !mCompositor)
+        {
+            return false;
+        }
+        mSurface = wl_compositor_create_surface(mCompositor);
+        if (!mSurface)
+        {
+            return false;
+        }
+        VkWaylandSurfaceCreateInfoKHR info = {};
+        info.sType = VK_STRUCTURE_TYPE_WAYLAND_SURFACE_CREATE_INFO_KHR;
+        info.display = mDisplay;
+        info.surface = mSurface;
+        return VK_CALL(vkCreateWaylandSurfaceKHR, mInstance, &info, nullptr, &mVkSurface) ==
+               VK_SUCCESS;
+    }
+
+    VkSurfaceKHR get() const { return mVkSurface; }
+
+  private:
+    static void HandleGlobal(void *data, wl_registry *registry, uint32_t name,
+                             const char *interface, uint32_t version)
+    {
+        auto *self = static_cast<ScopedWaylandFormatQuery *>(data);
+        if (!self->mCompositor && std::strcmp(interface, wl_compositor_interface.name) == 0)
+        {
+            self->mCompositor = static_cast<wl_compositor *>(
+                wl_registry_bind(registry, name, &wl_compositor_interface, std::min(version, 4u)));
+        }
+    }
+    static void HandleGlobalRemove(void *, wl_registry *, uint32_t) {}
+
+    wl_display *mDisplay;
+    wl_display *mWrapper = nullptr;
+    wl_event_queue *mQueue = nullptr;
+    wl_registry *mRegistry = nullptr;
+    wl_compositor *mCompositor = nullptr;
+    wl_surface *mSurface = nullptr;
+    VkInstance mInstance = VK_NULL_HANDLE;
+    VkSurfaceKHR mVkSurface = VK_NULL_HANDLE;
+};
+}  // namespace
