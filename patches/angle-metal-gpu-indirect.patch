@@ -0,0 +1,252 @@
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Backend tests for GPU argument buffers. These use native MSL kernels and do
+// not establish public GLES compute or multi-draw-indirect support.
+
+#include "test_utils/ANGLETest.h"
+
+#include <cstddef>
+#include <cstring>
+
+#ifdef UNSAFE_BUFFERS_BUILD
+#    pragma allow_unsafe_buffers
+#endif
+
+#include "common/apple_platform_utils.h"
+#include "libANGLE/Context.h"
+#include "libANGLE/Display.h"
+#include "libANGLE/renderer/metal/ContextMtl.h"
+#include "libANGLE/renderer/metal/DisplayMtl.h"
+
+using namespace angle;
+using namespace rx;
+
+namespace
+{
+
+static_assert(sizeof(MTLDispatchThreadgroupsIndirectArguments) == 12);
+static_assert(sizeof(MTLDrawPrimitivesIndirectArguments) == 16);
+static_assert(sizeof(MTLDrawIndexedPrimitivesIndirectArguments) == 20);
+static_assert(offsetof(MTLDrawIndexedPrimitivesIndirectArguments, baseVertex) == 12);
+
+constexpr char kShaders[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+// All offsets are in uints, independently of Metal's host argument structs.
+kernel void prepare(device uint *commands [[buffer(0)]])
+{
+    commands[4] = 3;
+    commands[5] = 2;
+    commands[6] = 2;
+}
+
+kernel void generate(device uint *commands [[buffer(0)]],
+                     constant uint &mask [[buffer(1)]],
+                     uint3 id [[thread_position_in_grid]],
+                     uint3 groups [[threadgroups_per_grid]])
+{
+    if (id.x >= 2 || id.y != 0 || id.z != 0)
+        return;
+    uint slot = id.x;
+    uint visible = ((mask >> slot) & 1u) * uint(all(groups == uint3(3, 2, 2)));
+    uint count = (mask & 8u) != 0 ? 0 : 3;
+    uint a = 16 + slot * 8;
+    commands[a + 0] = count;
+    commands[a + 1] = visible;
+    commands[a + 2] = 3;
+    commands[a + 3] = 0;
+    uint e = 40 + slot * 8;
+    commands[e + 0] = count;
+    commands[e + 1] = visible;
+    commands[e + 2] = 1;
+    commands[e + 3] = as_type<uint>(-5);
+    commands[e + 4] = 0;
+}
+
+constant float2 positions[] = {float2(-1, -1), float2(3, -1), float2(-1, 3)};
+vertex float4 arraysVertex(uint id [[vertex_id]])
+{
+    return id >= 3 && id < 6 ? float4(positions[id - 3], 0, 1) : float4(4, 4, 0, 1);
+}
+vertex float4 indexedVertex(uint id [[vertex_id]])
+{
+    return id < 3 ? float4(positions[id], 0, 1) : float4(4, 4, 0, 1);
+}
+fragment float4 colorFragment() { return float4(1, 0, 0, 1); }
+)";
+
+class IndirectCommandTestMetal : public ANGLETest<>
+{
+  protected:
+    IndirectCommandTestMetal()
+    {
+        setWindowWidth(8);
+        setWindowHeight(8);
+    }
+
+    void runCommands(bool replaceStorage)
+    {
+        ANGLE_SKIP_TEST_IF(!IsMetalRendererAvailable());
+        auto *display           = static_cast<egl::Display *>(getEGLWindow()->getDisplay());
+        gl::ContextID contextID = {
+            static_cast<GLuint>(reinterpret_cast<uintptr_t>(getEGLWindow()->getContext()))};
+        gl::Context *glContext = display->getContext(contextID);
+        ContextMtl *context    = mtl::GetImpl(glContext);
+        ASSERT_NE(context, nullptr);
+
+        NSError *error = nil;
+        auto library   = angle::adoptObjCPtr([context->getMetalDevice()
+            newLibraryWithSource:[NSString stringWithUTF8String:kShaders]
+                         options:nil
+                           error:&error]);
+        ASSERT_NE(library.get(), nil) << (error ? error.localizedDescription.UTF8String : "");
+        auto prepareFunction = angle::adoptObjCPtr([library.get() newFunctionWithName:@"prepare"]);
+        auto generateFunction =
+            angle::adoptObjCPtr([library.get() newFunctionWithName:@"generate"]);
+        auto prepare = angle::adoptObjCPtr([context->getMetalDevice()
+            newComputePipelineStateWithFunction:prepareFunction.get()
+                                          error:&error]);
+        ASSERT_NE(prepare.get(), nil) << (error ? error.localizedDescription.UTF8String : "");
+        auto generate = angle::adoptObjCPtr([context->getMetalDevice()
+            newComputePipelineStateWithFunction:generateFunction.get()
+                                          error:&error]);
+        ASSERT_NE(generate.get(), nil) << (error ? error.localizedDescription.UTF8String : "");
+
+        auto fragment = angle::adoptObjCPtr([library.get() newFunctionWithName:@"colorFragment"]);
+        std::array<angle::ObjCPtr<id<MTLRenderPipelineState>>, 2> pipelines;
+        for (size_t indexed = 0; indexed < pipelines.size(); ++indexed)
+        {
+            auto vertex = angle::adoptObjCPtr(
+                [library.get() newFunctionWithName:indexed ? @"indexedVertex" : @"arraysVertex"]);
+            auto desc = angle::adoptObjCPtr([[MTLRenderPipelineDescriptor alloc] init]);
+            desc.get().vertexFunction                  = vertex.get();
+            desc.get().fragmentFunction                = fragment.get();
+            desc.get().colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+            pipelines[indexed] = angle::adoptObjCPtr([context->getMetalDevice()
+                newRenderPipelineStateWithDescriptor:desc.get()
+                                               error:&error]);
+            ASSERT_NE(pipelines[indexed].get(), nil)
+                << (error ? error.localizedDescription.UTF8String : "");
+        }
+
+        constexpr size_t kFrames        = 16;
+        constexpr size_t kBytesPerRow   = 256;
+        constexpr size_t kBytesPerImage = kBytesPerRow * 8;
+        mtl::BufferRef commands, indices, readback;
+        ASSERT_EQ(
+            mtl::Buffer::MakeBufferWithStorageMode(context, MTLStorageModePrivate, 256, &commands),
+            angle::Result::Continue);
+        ASSERT_EQ(mtl::Buffer::MakeBuffer(context, 5 * sizeof(uint32_t), &indices),
+                  angle::Result::Continue);
+        const std::array<uint32_t, 5> indexData = {99, 99, 5, 6, 7};
+        auto mapped                             = indices->map(context);
+        ASSERT_GE(mapped.size(), sizeof(indexData));
+        std::memcpy(mapped.data(), indexData.data(), sizeof(indexData));
+        indices->unmap(context);
+        ASSERT_EQ(mtl::Buffer::MakeBuffer(context, kFrames * kBytesPerImage, &readback),
+                  angle::Result::Continue);
+
+        mtl::TextureRef target;
+        ASSERT_EQ(mtl::Texture::Make2DTexture(
+                      context, context->getPixelFormat(angle::FormatID::R8G8B8A8_UNORM), 8, 8, 1,
+                      true, false, &target),
+                  angle::Result::Continue);
+
+        // Queue every frame before the sole final CPU readback. This covers
+        // render -> compute reuse of the same underlying allocation.
+        for (uint32_t frame = 0; frame < kFrames; ++frame)
+        {
+            if (replaceStorage && frame != 0)
+            {
+                commands.reset();
+                ASSERT_EQ(mtl::Buffer::MakeBufferWithStorageMode(context, MTLStorageModePrivate,
+                                                                 256, &commands),
+                          angle::Result::Continue);
+            }
+            auto *compute = context->getComputeCommandEncoder();
+            compute->setComputePipelineState(prepare.get())
+                .setBufferForWrite(commands, 0, 0)
+                .dispatch(MTLSizeMake(1, 1, 1), MTLSizeMake(1, 1, 1));
+            // Separate encoders establish the producer/consumer dependency
+            // using ANGLE's tracked Metal resources, without a CPU wait.
+            context->endEncoding(true);
+            compute             = context->getComputeCommandEncoder();
+            const uint32_t mask = frame;
+            compute->setComputePipelineState(generate.get())
+                .setBufferForWrite(commands, 0, 0)
+                .setData(mask, 1)
+                .dispatchIndirect(commands, 16, MTLSizeMake(2, 1, 1));
+
+            auto *render =
+                context->getTextureRenderCommandEncoder(target, mtl::MipmapNativeLevel(0), 0);
+            render->setColorLoadAction(MTLLoadActionClear, MTLClearColorMake(0, 0, 1, 1), 0);
+            render->setColorStoreAction(MTLStoreActionStore, 0);
+            const bool indexed = (frame / 4) % 2 != 0;
+            render->setRenderPipelineState(pipelines[indexed].get());
+            render->setScissorRect(MTLScissorRect{0, 0, 8, 8});
+            for (size_t slot = 0; slot < 2; ++slot)
+            {
+                render->setViewport(MTLViewport{double(slot * 4), 0, 4, 8, 0, 1});
+                if (indexed)
+                {
+                    render->drawIndexedIndirect(MTLPrimitiveTypeTriangle, MTLIndexTypeUInt32,
+                                                indices, sizeof(uint32_t), commands,
+                                                160 + slot * 32);
+                }
+                else
+                {
+                    render->drawIndirect(MTLPrimitiveTypeTriangle, commands, 64 + slot * 32);
+                }
+            }
+            // The render stream must retain each argument allocation until it
+            // has replayed, even if the application drops its reference.
+            if (replaceStorage)
+            {
+                commands.reset();
+            }
+            context->getBlitCommandEncoder()->copyTextureToBuffer(
+                target, 0, mtl::MipmapNativeLevel(0), MTLOriginMake(0, 0, 0), MTLSizeMake(8, 8, 1),
+                readback, frame * kBytesPerImage, kBytesPerRow, kBytesPerImage, MTLBlitOptionNone);
+        }
+
+        auto pixels = readback->mapReadOnly(context);
+        ASSERT_GE(pixels.size(), kFrames * kBytesPerImage);
+        for (size_t frame = 0; frame < kFrames; ++frame)
+        {
+            for (size_t y = 0; y < 8; ++y)
+            {
+                for (size_t x = 0; x < 8; ++x)
+                {
+                    const size_t offset = frame * kBytesPerImage + y * kBytesPerRow + x * 4;
+                    const bool visible  = (frame & 8) == 0 && (((frame % 4) >> (x / 4)) & 1);
+                    EXPECT_EQ(pixels[offset + 0], visible ? 255 : 0)
+                        << frame << ":" << x << ":" << y;
+                    EXPECT_EQ(pixels[offset + 1], 0);
+                    EXPECT_EQ(pixels[offset + 2], visible ? 0 : 255)
+                        << frame << ":" << x << ":" << y;
+                    EXPECT_EQ(pixels[offset + 3], 255);
+                }
+            }
+        }
+        readback->unmap(context);
+        EXPECT_EQ(context->checkCommandBufferError(), angle::Result::Continue);
+        context->invalidateState(glContext);
+    }
+};
+
+TEST_P(IndirectCommandTestMetal, ReuseGPUGeneratedArguments)
+{
+    runCommands(false);
+}
+
+TEST_P(IndirectCommandTestMetal, RetainGPUGeneratedArguments)
+{
+    runCommands(true);
+}
+
+}  // namespace
+
+ANGLE_INSTANTIATE_TEST(IndirectCommandTestMetal, ES3_METAL());
