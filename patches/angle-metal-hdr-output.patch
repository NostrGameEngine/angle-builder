--- a/src/libANGLE/renderer/metal/DisplayMtl.mm
+++ b/src/libANGLE/renderer/metal/DisplayMtl.mm
@@ -464,6 +464,13 @@ bool IsMetalDisplayAvailable()
 
 void DisplayMtl::generateExtensions(egl::DisplayExtensions *outExtensions) const
 {
+    outExtensions->pixelFormatFloat = true;
+    outExtensions->glColorspace     = true;
+#if TARGET_OS_OSX || TARGET_OS_MACCATALYST
+    outExtensions->glColorspaceScrgbLinear = true;
+#elif TARGET_OS_IOS && !TARGET_OS_TV && !TARGET_OS_WATCH
+    if (@available(iOS 16.0, *)) outExtensions->glColorspaceScrgbLinear = true;
+#endif
     outExtensions->createContextRobustness    = true;
     outExtensions->iosurfaceClientBuffer      = true;
     outExtensions->surfacelessContext         = true;
@@ -631,6 +638,17 @@ bool IsMetalDisplayAvailable()
         configs.add(config);
     }
 
+    // Native EDR requires float drawables; leave all existing SDR configurations intact.
+    config.renderTargetFormat = GL_RGBA16F;
+    config.colorComponentType = EGL_COLOR_COMPONENT_TYPE_FLOAT_EXT;
+    config.redSize = config.greenSize = config.blueSize = config.alphaSize = 16;
+    config.bufferSize = 64;
+    config.samples = config.sampleBuffers = 0;
+    configs.add(config);
+    config.depthSize = 24;
+    config.stencilSize = 8;
+    config.depthStencilFormat = GL_DEPTH24_STENCIL8;
+    configs.add(config);
     return configs;
 }
 
