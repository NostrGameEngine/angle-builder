--- /dev/null
+++ b/src/tests/gl_tests/ComputeShaderTestMetal.mm
@@ -0,0 +1,342 @@
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Execute MSL translated from GLSL compute shaders without enabling an
+// incomplete public GLES profile. GL program/dispatch tests are separate.
+
+#ifdef UNSAFE_BUFFERS_BUILD
+#    pragma allow_unsafe_buffers
+#endif
+
+#include "test_utils/ANGLETest.h"
+
+#include <cstring>
+#include <memory>
+
+#include "GLSLANG/ShaderLang.h"
+#include "compiler/translator/msl/TranslatorMSL.h"
+#include "libANGLE/Context.h"
+#include "libANGLE/Display.h"
+#include "libANGLE/renderer/metal/ContextMtl.h"
+#include "libANGLE/renderer/metal/DisplayMtl.h"
+
+using namespace angle;
+using namespace rx;
+
+namespace
+{
+
+constexpr char kInvocationShader[] = R"(#version 310 es
+precision highp int;
+layout(local_size_x = 4, local_size_y = 3, local_size_z = 2) in;
+layout(rgba32ui, binding = 0) uniform writeonly highp uimage2D globalResult;
+layout(rgba32ui, binding = 1) uniform writeonly highp uimage2D groupResult;
+
+uvec4 globals() {
+    bool gridMatches = all(equal(gl_NumWorkGroups, uvec3(3, 2, 2)));
+    bool localSizeMatches = all(equal(gl_WorkGroupSize, uvec3(4, 3, 2)));
+    return uvec4(gl_GlobalInvocationID,
+                 gridMatches && localSizeMatches ? gl_LocalInvocationIndex : 0xffffffffu);
+}
+uvec4 groups() {
+    uint localCode = gl_LocalInvocationID.x + 7u * gl_LocalInvocationID.y +
+                     31u * gl_LocalInvocationID.z;
+    return uvec4(gl_WorkGroupID, localCode);
+}
+void main() {
+    ivec2 pixel = ivec2(gl_GlobalInvocationID.x,
+                       gl_GlobalInvocationID.y + 6u * gl_GlobalInvocationID.z);
+    imageStore(globalResult, pixel, globals());
+    imageStore(groupResult, pixel, groups());
+}
+)";
+
+constexpr char kDispatchProducer[] = R"(#version 310 es
+precision highp int;
+layout(local_size_x = 1) in;
+layout(rgba32ui, binding = 0) uniform writeonly highp uimage2D result;
+void main() { imageStore(result, ivec2(0), uvec4(3, 2, 2, 0)); }
+)";
+
+constexpr char kSharedProducer[] = R"(#version 310 es
+precision highp int;
+layout(local_size_x = 128) in;
+layout(rgba32ui, binding = 0) uniform writeonly highp uimage2D result;
+void main() {
+    imageStore(result, ivec2(gl_LocalInvocationIndex, gl_WorkGroupID.x),
+               uvec4(1000u * gl_WorkGroupID.x + 17u));
+}
+)";
+
+// 128 threads span multiple SIMD groups, including 64-wide Metal hardware. Each thread reads a
+// different thread's value, twice, with group-specific seeds to detect leaks
+// between groups as well as missing execution or memory synchronization.
+constexpr char kSharedShader[] = R"(#version 310 es
+precision highp int;
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 2) in;
+layout(rgba32ui, binding = 0) uniform writeonly highp uimage2D result;
+layout(rgba32ui, binding = 1) uniform readonly highp uimage2D sourceImage;
+shared uint scratch[128];
+uint readPartner(uint index) { return scratch[127u - index]; }
+void writeValue(uint index, uint value) { scratch[index] = value; }
+void synchronize() { barrier(); }
+void main() {
+    uint index = gl_LocalInvocationIndex;
+    uint seed = imageLoad(sourceImage, ivec2(index, gl_WorkGroupID.x)).x;
+    writeValue(index, seed + index);
+    synchronize();
+    uint first = readPartner(index);
+    // Prevent a fast thread overwriting a value still needed by another.
+    synchronize();
+    writeValue(index, first + 100u);
+    synchronize();
+    uint second = readPartner(index);
+    imageStore(result, ivec2(index, gl_WorkGroupID.x),
+               uvec4(first, second, index, gl_WorkGroupID.x));
+}
+)";
+
+struct ComputeKernel
+{
+    angle::ObjCPtr<id<MTLLibrary>> library;
+    angle::ObjCPtr<id<MTLComputePipelineState>> pipeline;
+    MTLSize localSize;
+    std::array<int, 8> imageBindings;
+};
+
+class ComputeShaderTestMetal : public ANGLETest<>
+{
+  protected:
+    ComputeShaderTestMetal()
+    {
+        setWindowWidth(8);
+        setWindowHeight(8);
+    }
+
+    ContextMtl *contextMtl()
+    {
+        auto *display    = static_cast<egl::Display *>(getEGLWindow()->getDisplay());
+        gl::ContextID id = {
+            static_cast<GLuint>(reinterpret_cast<uintptr_t>(getEGLWindow()->getContext()))};
+        return mtl::GetImpl(display->getContext(id));
+    }
+
+    void compileKernel(const char *source, ComputeKernel *result)
+    {
+        ASSERT_TRUE(sh::Initialize());
+        ShBuiltInResources resources;
+        sh::InitBuiltInResources(&resources);
+        std::unique_ptr<void, decltype(&sh::Destruct)> compiler(
+            sh::ConstructCompiler(GL_COMPUTE_SHADER, SH_GLES3_1_SPEC, SH_MSL_METAL_OUTPUT,
+                                  &resources),
+            sh::Destruct);
+        ASSERT_NE(compiler, nullptr);
+        ShCompileOptions options                     = {};
+        options.objectCode                           = true;
+        options.validateAST                          = true;
+        options.rescopeGlobalVariables               = true;
+        options.simplifyLoopConditions               = true;
+        options.initializeUninitializedLocals        = true;
+        options.separateCompoundStructDeclarations   = true;
+        options.forceDeferNonConstGlobalInitializers = true;
+        options.removeInactiveVariables              = true;
+        ASSERT_TRUE(sh::Compile(compiler.get(), &source, 1, options))
+            << sh::GetInfoLog(compiler.get());
+        const auto size = sh::GetComputeShaderLocalGroupSize(compiler.get());
+        ASSERT_GT(size[0], 0);
+        ASSERT_GT(size[1], 0);
+        ASSERT_GT(size[2], 0);
+        result->localSize = MTLSizeMake(size[0], size[1], size[2]);
+
+        auto *translator = static_cast<sh::TShHandleBase *>(compiler.get())->getAsTranslatorMSL();
+        ASSERT_NE(translator, nullptr);
+        for (size_t binding = 0; binding < result->imageBindings.size(); ++binding)
+        {
+            result->imageBindings[binding] =
+                translator->getTranslatorMetalReflection()->getRWTextureBinding(binding);
+        }
+
+        const std::string &msl             = sh::GetObjectCode(compiler.get());
+        auto metalOptions                  = angle::adoptObjCPtr([[MTLCompileOptions alloc] init]);
+        metalOptions.get().languageVersion = MTLLanguageVersion2_1;
+        NSError *error                     = nil;
+        result->library                    = angle::adoptObjCPtr([contextMtl()->getMetalDevice()
+            newLibraryWithSource:[NSString stringWithUTF8String:msl.c_str()]
+                         options:metalOptions.get()
+                           error:&error]);
+        ASSERT_NE(result->library.get(), nil)
+            << (error ? error.localizedDescription.UTF8String : "") << "\n"
+            << msl;
+        auto function = angle::adoptObjCPtr([result->library.get() newFunctionWithName:@"main0"]);
+        ASSERT_NE(function.get(), nil);
+        result->pipeline = angle::adoptObjCPtr([contextMtl()->getMetalDevice()
+            newComputePipelineStateWithFunction:function.get()
+                                          error:&error]);
+        ASSERT_NE(result->pipeline.get(), nil)
+            << (error ? error.localizedDescription.UTF8String : "");
+    }
+
+    mtl::TextureRef image(size_t width, size_t height)
+    {
+        auto desc              = angle::adoptObjCPtr([[MTLTextureDescriptor alloc] init]);
+        desc.get().pixelFormat = MTLPixelFormatRGBA32Uint;
+        desc.get().width       = width;
+        desc.get().height      = height;
+        desc.get().storageMode = MTLStorageModePrivate;
+        desc.get().usage       = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+        auto texture           = angle::adoptObjCPtr(
+            [contextMtl()->getMetalDevice() newTextureWithDescriptor:desc.get()]);
+        return mtl::Texture::MakeFromMetal(texture.get());
+    }
+
+    void runSharedMemory()
+    {
+        ComputeKernel kernel, producer;
+        ASSERT_NO_FATAL_FAILURE(compileKernel(kSharedShader, &kernel));
+        ASSERT_NO_FATAL_FAILURE(compileKernel(kSharedProducer, &producer));
+        ASSERT_GE(producer.imageBindings[0], 0);
+        ASSERT_GE(kernel.imageBindings[0], 0);
+        ASSERT_GE(kernel.imageBindings[1], 0);
+        // Ensure this regression actually spans SIMD groups on the tested GPU.
+        ASSERT_GT(kernel.localSize.width * kernel.localSize.height * kernel.localSize.depth,
+                  kernel.pipeline.get().threadExecutionWidth);
+        ASSERT_GT(kernel.pipeline.get().staticThreadgroupMemoryLength, 0u);
+        ContextMtl *context = contextMtl();
+        auto result         = image(128, 4);
+        auto source         = image(128, 4);
+        ASSERT_NE(result, nullptr);
+        ASSERT_NE(source, nullptr);
+        context->getComputeCommandEncoder()
+            ->setComputePipelineState(producer.pipeline.get())
+            .setTextureForWrite(source, producer.imageBindings[0])
+            .dispatch(MTLSizeMake(4, 1, 1), producer.localSize);
+        context->getComputeCommandEncoder()
+            ->setComputePipelineState(kernel.pipeline.get())
+            .setTextureForWrite(result, kernel.imageBindings[0])
+            .setTexture(source, kernel.imageBindings[1])
+            .dispatch(MTLSizeMake(4, 1, 1), kernel.localSize);
+        constexpr size_t kRow = 128 * 4 * sizeof(uint32_t);
+        mtl::BufferRef readback;
+        ASSERT_EQ(mtl::Buffer::MakeBuffer(context, 4 * kRow, &readback), angle::Result::Continue);
+        context->getBlitCommandEncoder()->copyTextureToBuffer(
+            result, 0, mtl::MipmapNativeLevel(0), MTLOriginMake(0, 0, 0), MTLSizeMake(128, 4, 1),
+            readback, 0, kRow, 4 * kRow, MTLBlitOptionNone);
+        auto data = readback->mapReadOnly(context);
+        ASSERT_GE(data.size(), 4 * kRow);
+        for (uint32_t group = 0; group < 4; ++group)
+        {
+            for (uint32_t index = 0; index < 128; ++index)
+            {
+                std::array<uint32_t, 4> actual;
+                std::memcpy(actual.data(), data.data() + group * kRow + index * sizeof(actual),
+                            sizeof(actual));
+                const uint32_t seed                    = 1000 * group + 17;
+                const std::array<uint32_t, 4> expected = {seed + 127 - index, seed + index + 100,
+                                                          index, group};
+                EXPECT_EQ(actual, expected) << group << ":" << index;
+            }
+        }
+        readback->unmap(context);
+        EXPECT_EQ(context->checkCommandBufferError(), angle::Result::Continue);
+    }
+
+    void runInvocations(bool indirect)
+    {
+        ComputeKernel kernel;
+        ASSERT_NO_FATAL_FAILURE(compileKernel(kInvocationShader, &kernel));
+        ASSERT_GE(kernel.imageBindings[0], 0);
+        ASSERT_GE(kernel.imageBindings[1], 0);
+        ContextMtl *context = contextMtl();
+        auto globalResult   = image(12, 24);
+        auto groupResult    = image(12, 24);
+        ASSERT_NE(globalResult, nullptr);
+        ASSERT_NE(groupResult, nullptr);
+
+        mtl::BufferRef arguments;
+        if (indirect)
+        {
+            ComputeKernel producer;
+            ASSERT_NO_FATAL_FAILURE(compileKernel(kDispatchProducer, &producer));
+            ASSERT_GE(producer.imageBindings[0], 0);
+            auto dispatchImage = image(1, 1);
+            ASSERT_EQ(mtl::Buffer::MakeBufferWithStorageMode(context, MTLStorageModePrivate, 512,
+                                                             &arguments),
+                      angle::Result::Continue);
+            context->getComputeCommandEncoder()
+                ->setComputePipelineState(producer.pipeline.get())
+                .setTextureForWrite(dispatchImage, producer.imageBindings[0])
+                .dispatch(MTLSizeMake(1, 1, 1), producer.localSize);
+            context->getBlitCommandEncoder()->copyTextureToBuffer(
+                dispatchImage, 0, mtl::MipmapNativeLevel(0), MTLOriginMake(0, 0, 0),
+                MTLSizeMake(1, 1, 1), arguments, 256, 256, 256, MTLBlitOptionNone);
+        }
+
+        auto *compute = context->getComputeCommandEncoder();
+        compute->setComputePipelineState(kernel.pipeline.get())
+            .setTextureForWrite(globalResult, kernel.imageBindings[0])
+            .setTextureForWrite(groupResult, kernel.imageBindings[1]);
+        if (indirect)
+        {
+            compute->dispatchIndirect(arguments, 256, kernel.localSize);
+        }
+        else
+        {
+            compute->dispatch(MTLSizeMake(3, 2, 2), kernel.localSize);
+        }
+
+        constexpr size_t kRow   = 256;
+        constexpr size_t kImage = 24 * kRow;
+        mtl::BufferRef readback;
+        ASSERT_EQ(mtl::Buffer::MakeBuffer(context, 2 * kImage, &readback), angle::Result::Continue);
+        auto *blit = context->getBlitCommandEncoder();
+        blit->copyTextureToBuffer(globalResult, 0, mtl::MipmapNativeLevel(0),
+                                  MTLOriginMake(0, 0, 0), MTLSizeMake(12, 24, 1), readback, 0, kRow,
+                                  kImage, MTLBlitOptionNone);
+        blit->copyTextureToBuffer(groupResult, 0, mtl::MipmapNativeLevel(0), MTLOriginMake(0, 0, 0),
+                                  MTLSizeMake(12, 24, 1), readback, kImage, kRow, kImage,
+                                  MTLBlitOptionNone);
+        auto data = readback->mapReadOnly(context);
+        ASSERT_GE(data.size(), 2 * kImage);
+        for (uint32_t z = 0; z < 4; ++z)
+        {
+            for (uint32_t y = 0; y < 6; ++y)
+            {
+                for (uint32_t x = 0; x < 12; ++x)
+                {
+                    std::array<uint32_t, 4> global, group;
+                    const size_t offset = (y + 6 * z) * kRow + x * sizeof(global);
+                    std::memcpy(global.data(), data.data() + offset, sizeof(global));
+                    std::memcpy(group.data(), data.data() + kImage + offset, sizeof(group));
+                    const std::array<uint32_t, 4> expectedGlobal = {
+                        x, y, z, x % 4 + 4 * (y % 3 + 3 * (z % 2))};
+                    const std::array<uint32_t, 4> expectedGroup = {
+                        x / 4, y / 3, z / 2, x % 4 + 7 * (y % 3) + 31 * (z % 2)};
+                    EXPECT_EQ(global, expectedGlobal) << x << ":" << y << ":" << z;
+                    EXPECT_EQ(group, expectedGroup) << x << ":" << y << ":" << z;
+                }
+            }
+        }
+        readback->unmap(context);
+        EXPECT_EQ(context->checkCommandBufferError(), angle::Result::Continue);
+    }
+};
+
+TEST_P(ComputeShaderTestMetal, GLSLSharedMemoryAcrossSIMDGroups)
+{
+    runSharedMemory();
+}
+
+TEST_P(ComputeShaderTestMetal, GLSLInvocationBuiltins)
+{
+    runInvocations(false);
+}
+
+TEST_P(ComputeShaderTestMetal, GLSLGPUGeneratedDispatch)
+{
+    runInvocations(true);
+}
+
+}  // namespace
+
+ANGLE_INSTANTIATE_TEST(ComputeShaderTestMetal, ES3_METAL());
