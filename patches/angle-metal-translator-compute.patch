+class MSLComputeOutputTest : public MSLOutputTestBase
+{
+  public:
+    MSLComputeOutputTest() : MSLOutputTestBase(GL_COMPUTE_SHADER) {}
+};
+
+TEST_F(MSLComputeOutputTest, EmptyKernel)
+{
+    compile(R"(#version 310 es
+        layout(local_size_x = 2, local_size_y = 3, local_size_z = 4) in;
+        void main() {}
+    )");
+    EXPECT_TRUE(foundInCode("kernel void main0("));
+}
+
+// Kernel inputs must be forwarded through helper functions without creating
+// module-scope per-invocation variables or graphics stage inputs.
+TEST_F(MSLComputeOutputTest, InvocationBuiltinsInHelper)
+{
+    compile(R"(#version 310 es
+        layout(local_size_x = 2, local_size_y = 3, local_size_z = 4) in;
+        layout(rgba32ui, binding = 0) uniform writeonly highp uimage2D result;
+        uvec4 values() {
+            return uvec4(gl_WorkGroupID + gl_LocalInvocationID + gl_NumWorkGroups,
+                         gl_LocalInvocationIndex + gl_WorkGroupSize.z);
+        }
+        void main() {
+            imageStore(result, ivec2(gl_GlobalInvocationID.xy), values());
+        }
+    )");
+    EXPECT_TRUE(foundInCode("[[threadgroups_per_grid]]"));
+    EXPECT_TRUE(foundInCode("[[threadgroup_position_in_grid]]"));
+    EXPECT_TRUE(foundInCode("[[thread_position_in_threadgroup]]"));
+    EXPECT_TRUE(foundInCode("[[thread_position_in_grid]]"));
+    EXPECT_TRUE(foundInCode("[[thread_index_in_threadgroup]]"));
+    EXPECT_TRUE(notFoundInCode("[[stage_in]]"));
+    EXPECT_TRUE(notFoundInCode("gl_WorkGroupSize"));
+}
+
+TEST_F(MSLComputeOutputTest, SharedMemoryInHelpers)
+{
+    compile(R"(#version 310 es
+        layout(local_size_x = 64) in;
+        layout(rgba32ui, binding = 0) uniform writeonly highp uimage2D result;
+        shared uint scratch[64];
+        void storeValue(uint i) { scratch[i] = i; }
+        uint loadValue(uint i) { return scratch[63u - i]; }
+        void synchronize() { barrier(); }
+        void main() {
+            storeValue(gl_LocalInvocationIndex);
+            synchronize();
+            imageStore(result, ivec2(gl_LocalInvocationIndex, 0),
+                       uvec4(loadValue(gl_LocalInvocationIndex)));
+        }
+    )");
+    EXPECT_TRUE(foundInCode("threadgroup ANGLE_SharedGlobals"));
+    EXPECT_TRUE(foundInCode("threadgroup_barrier(metal::mem_flags::mem_threadgroup)"));
+    EXPECT_TRUE(notFoundInCode("simdgroup_barrier"));
+}
+
 // Test that having dynamic indexing of a vector inside the right hand side of logical or doesn't
