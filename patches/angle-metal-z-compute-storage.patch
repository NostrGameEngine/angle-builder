+angle::Result ProgramExecutableMtl::getComputePipeline(
+    ContextMtl *context,
+    angle::ObjCPtr<id<MTLComputePipelineState>> *pipelineOut)
+{
+    ANGLE_CHECK(context, mExecutable->hasLinkedShaderStage(gl::ShaderType::Compute),
+                "Program has no linked compute stage", GL_INVALID_OPERATION);
+    if (!mComputePipeline)
+    {
+        auto &info = mMslShaderTranslateInfo[gl::ShaderType::Compute];
+        if (!info.metalLibrary)
+        {
+            ANGLE_TRY(CreateMslShaderLib(context, mExecutable->getInfoLog(), &info, {}));
+        }
+        mComputeFunction =
+            angle::adoptObjCPtr([info.metalLibrary.get() newFunctionWithName:@"main0"]);
+        ANGLE_CHECK(context, mComputeFunction, "Metal compute entry point is missing",
+                    GL_INVALID_OPERATION);
+        ANGLE_TRY(context->getPipelineCache().getComputePipeline(context, mComputeFunction.get(),
+                                                                 &mComputePipeline));
+    }
+    *pipelineOut = mComputePipeline;
+    return angle::Result::Continue;
+}
