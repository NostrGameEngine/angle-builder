+TEST_P(ComputeShaderTestMetal, GraphicsUniformAndBinaryRegression)
+{
+    constexpr char vertex[]   = R"(#version 300 es
+        in vec4 position;
+        uniform float offset;
+        void main() { gl_Position = vec4(position.xy + vec2(offset), 0, 1); }
+    )";
+    constexpr char fragment[] = R"(#version 300 es
+        precision highp float;
+        uniform vec4 color;
+        out vec4 result;
+        void main() { result = color; }
+    )";
+    ANGLE_GL_PROGRAM(program, vertex, fragment);
+    glUseProgram(program);
+    glUniform1f(glGetUniformLocation(program, "offset"), 0);
+    glUniform4f(glGetUniformLocation(program, "color"), 0, 1, 0, 1);
+    drawQuad(program, "position", 0);
+    ASSERT_GL_NO_ERROR();
+    EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::green);
+    GLint length = 0;
+    glGetProgramiv(program, GL_PROGRAM_BINARY_LENGTH, &length);
+    ASSERT_GT(length, 0);
+    std::vector<uint8_t> bytes(length);
+    GLenum format   = 0;
+    GLsizei written = 0;
+    glGetProgramBinary(program, length, &written, &format, bytes.data());
+    ASSERT_GL_NO_ERROR();
+    ASSERT_GT(written, 0);
+    GLProgram loaded;
+    glProgramBinary(loaded, format, bytes.data(), written);
+    GLint status = 0;
+    glGetProgramiv(loaded, GL_LINK_STATUS, &status);
+    ASSERT_EQ(status, GL_TRUE);
+    glUseProgram(loaded);
+    glUniform1f(glGetUniformLocation(loaded, "offset"), 0);
+    glUniform4f(glGetUniformLocation(loaded, "color"), 1, 0, 0, 1);
+    drawQuad(loaded, "position", 0);
+    ASSERT_GL_NO_ERROR();
+    EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::red);
+}
