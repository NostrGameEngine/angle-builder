+TEST_F(MSLComputeOutputTest, StorageBufferScalarAndVectorAccess)
+{
+    compile(R"(#version 310 es
+        layout(local_size_x = 8) in;
+        layout(std430, binding = 0) buffer Data {
+            vec3 normal;
+            uint count;
+            float weights[];
+        } data;
+        void storeValue(uint index, float value) { data.weights[index] = value; }
+        void main() {
+            uint index = gl_GlobalInvocationID.x;
+            vec3 value = data.normal;
+            storeValue(index, value.x + float(data.count) + float(data.weights.length()));
+            if (index == 0u) data.normal = value * 2.0;
+        }
+    )");
+    EXPECT_TRUE(foundInCode("device uchar *"));
+    EXPECT_TRUE(foundInCode("reinterpret_cast<device"));
+    EXPECT_TRUE(foundInCode("[[buffer(0)]]"));
+    EXPECT_TRUE(notFoundInCode("constant Data"));
+}
