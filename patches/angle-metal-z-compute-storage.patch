+#ifndef COMPILER_TRANSLATOR_MSL_STORAGEBUFFER_H_
+#define COMPILER_TRANSLATOR_MSL_STORAGEBUFFER_H_
+
+#include "compiler/translator/IntermNode.h"
+#include "compiler/translator/msl/Layout.h"
+
+namespace sh
+{
+class SymbolEnv;
+class TCompiler;
+class DriverUniformMetal;
+
+// Compute reserves slots 0..7 for storage, 19/17 for default/driver uniforms,
+// and 24 for the UBO argument buffer. GL binding points are resolved at link time.
+constexpr size_t kMetalComputeStorageBuffers = 8;
+
+struct StorageBufferInfo
+{
+    size_t index;
+    TLayoutBlockStorage storage;
+    TLayoutMatrixPacking packing;
+    bool readonly;
+    std::string blockName;
+};
+
+struct StorageBufferAccess
+{
+    const StorageBufferInfo *buffer = nullptr;
+    TIntermTyped *base              = nullptr;
+    size_t offset                   = 0;
+    std::vector<std::pair<TIntermTyped *, size_t>> indices;
+    TLayoutBlockStorage storage  = EbsStd430;
+    TLayoutMatrixPacking packing = EmpColumnMajor;
+    // A row-major matrix column is not contiguous, unlike a GLSL vector.
+    size_t componentStride = 4;
+};
+
+bool WrapStorageOutArguments(TCompiler &compiler, TIntermBlock &root, SymbolEnv &env);
+
+bool LowerStorageArrayLength(TCompiler &compiler,
+                             TIntermBlock &root,
+                             SymbolEnv &env,
+                             DriverUniformMetal &uniforms);
+
+Layout StorageBufferLayout(const TType &type,
+                           TLayoutBlockStorage storage,
+                           TLayoutMatrixPacking packing);
+size_t StorageBufferArrayStride(const TType &type,
+                                TLayoutBlockStorage storage,
+                                TLayoutMatrixPacking packing);
+bool GetStorageBufferAccess(TIntermTyped *node, const SymbolEnv &env, StorageBufferAccess *access);
+}  // namespace sh
+#endif
