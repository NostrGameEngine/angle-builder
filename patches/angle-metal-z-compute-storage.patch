diff --git a/src/compiler/translator/msl/StorageBuffer.cpp b/src/compiler/translator/msl/StorageBuffer.cpp
new file mode 100644
index 0000000..c10cbb1
--- /dev/null
+++ b/src/compiler/translator/msl/StorageBuffer.cpp
@@ -0,0 +1,350 @@
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "compiler/translator/msl/StorageBuffer.h"
+#include <limits>
+#include "compiler/translator/IntermRebuild.h"
+#include "compiler/translator/msl/DriverUniformMetal.h"
+#include "compiler/translator/msl/SymbolEnv.h"
+#include "compiler/translator/tree_util/IntermNode_util.h"
+
+namespace sh
+{
+namespace
+{
+size_t Aligned(size_t size, size_t alignment)
+{
+    return (size + alignment - 1) / alignment * alignment;
+}
+
+Layout StructLayout(const TFieldList &fields,
+                    TLayoutBlockStorage storage,
+                    TLayoutMatrixPacking packing,
+                    size_t count)
+{
+    Layout result = {0, storage == EbsStd140 ? 16u : 1u};
+    for (size_t i = 0; i < count; ++i)
+    {
+        Layout field   = StorageBufferLayout(*fields[i]->type(), storage, packing);
+        result.sizeOf  = Aligned(result.sizeOf, field.alignOf) + field.sizeOf;
+        result.alignOf = std::max(result.alignOf, field.alignOf);
+    }
+    return result;
+}
+}  // namespace
+
+size_t StorageBufferArrayStride(const TType &type,
+                                TLayoutBlockStorage storage,
+                                TLayoutMatrixPacking packing)
+{
+    TType element(type);
+    element.toArrayElementType();
+    Layout layout    = StorageBufferLayout(element, storage, packing);
+    size_t alignment = storage == EbsStd140 ? std::max(size_t(16), layout.alignOf) : layout.alignOf;
+    return Aligned(layout.sizeOf, alignment);
+}
+
+Layout StorageBufferLayout(const TType &type,
+                           TLayoutBlockStorage storage,
+                           TLayoutMatrixPacking packing)
+{
+    storage = Overlay(storage, type);
+    packing = Overlay(packing, type);
+    if (type.isArray())
+    {
+        TType element(type);
+        element.toArrayElementType();
+        Layout layout = StorageBufferLayout(element, storage, packing);
+        if (storage == EbsStd140)
+        {
+            layout.alignOf = std::max(size_t(16), layout.alignOf);
+        }
+        layout.sizeOf = Aligned(layout.sizeOf, layout.alignOf) * type.getOutermostArraySize();
+        return layout;
+    }
+    if (const TStructure *structure = type.getStruct())
+    {
+        Layout layout =
+            StructLayout(structure->fields(), storage, packing, structure->fields().size());
+        layout.sizeOf = Aligned(layout.sizeOf, layout.alignOf);
+        return layout;
+    }
+    if (type.isMatrix())
+    {
+        size_t width     = packing == EmpRowMajor ? type.getCols() : type.getRows();
+        size_t vectors   = packing == EmpRowMajor ? type.getRows() : type.getCols();
+        size_t alignment = width == 2 ? 8 : 16;
+        if (storage == EbsStd140)
+        {
+            alignment = 16;
+        }
+        return {vectors * Aligned(width * 4, alignment), alignment};
+    }
+    size_t width = type.getNominalSize();
+    // vec3 occupies 12 bytes, but starts at a 16-byte boundary. Treating its
+    // size as 16 would move a following scalar and break storage aliasing.
+    return {width * 4, width == 3 ? 16 : width * 4};
+}
+
+bool GetStorageBufferAccess(TIntermTyped *node, const SymbolEnv &env, StorageBufferAccess *access)
+{
+    if (auto *swizzle = node->getAsSwizzleNode())
+    {
+        if (swizzle->getSwizzleOffsets().size() != 1 ||
+            !GetStorageBufferAccess(swizzle->getOperand(), env, access))
+        {
+            return false;
+        }
+        access->offset += swizzle->getSwizzleOffsets()[0] * access->componentStride;
+        access->componentStride = 4;
+        return true;
+    }
+    if (auto *symbol = node->getAsSymbolNode())
+    {
+        if (const auto *info = env.getStorageBuffer(symbol->variable()))
+        {
+            access->buffer  = info;
+            access->base    = node;
+            access->storage = info->storage;
+            access->packing = info->packing;
+            return true;
+        }
+        return false;
+    }
+    auto *binary = node->getAsBinaryNode();
+    if (!binary)
+    {
+        return false;
+    }
+    TOperator op = binary->getOp();
+    if (op != EOpIndexDirectStruct && op != EOpIndexDirectInterfaceBlock && op != EOpIndexDirect &&
+        op != EOpIndexIndirect)
+    {
+        return false;
+    }
+    const TType &leftType = binary->getLeft()->getType();
+    if (op == EOpIndexDirectStruct)
+    {
+        const auto &fields = leftType.getStruct()->fields();
+        size_t index       = binary->getRight()->getAsConstantUnion()->getIConst(0);
+        if (const auto *info = env.getStorageBuffer(*fields[index]))
+        {
+            access->buffer  = info;
+            access->base    = node;
+            access->storage = info->storage;
+            access->packing = info->packing;
+            return true;
+        }
+    }
+    if (!GetStorageBufferAccess(binary->getLeft(), env, access))
+    {
+        return false;
+    }
+    if (op == EOpIndexDirectStruct || op == EOpIndexDirectInterfaceBlock)
+    {
+        const auto &fields = op == EOpIndexDirectStruct ? leftType.getStruct()->fields()
+                                                        : leftType.getInterfaceBlock()->fields();
+        size_t index       = binary->getRight()->getAsConstantUnion()->getIConst(0);
+        const TType &field = *fields[index]->type();
+        Layout previous    = StructLayout(fields, access->storage, access->packing, index);
+        Layout layout      = StorageBufferLayout(field, access->storage, access->packing);
+        access->offset += Aligned(previous.sizeOf, layout.alignOf);
+        access->storage = Overlay(access->storage, field);
+        access->packing = Overlay(access->packing, field);
+    }
+    else
+    {
+        size_t stride;
+        if (leftType.isArray())
+        {
+            stride = StorageBufferArrayStride(leftType, access->storage, access->packing);
+        }
+        else if (leftType.isMatrix())
+        {
+            Layout layout = StorageBufferLayout(leftType, access->storage, access->packing);
+            if (access->packing == EmpRowMajor)
+            {
+                stride                  = 4;
+                access->componentStride = layout.sizeOf / leftType.getRows();
+            }
+            else
+            {
+                stride = layout.sizeOf / leftType.getCols();
+            }
+        }
+        else
+        {
+            stride                  = access->componentStride;
+            access->componentStride = 4;
+        }
+        access->indices.emplace_back(binary->getRight(), stride);
+    }
+    return true;
+}
+namespace
+{
+class LowerArrayLength : public TIntermRebuild
+{
+  public:
+    LowerArrayLength(TCompiler &compiler, SymbolEnv &env, DriverUniformMetal &uniforms)
+        : TIntermRebuild(compiler, true, true), mEnv(env), mUniforms(uniforms)
+    {}
+    bool valid() const { return mValid; }
+
+  private:
+    PostResult visitUnaryPost(TIntermUnary &node) override
+    {
+        if (node.getOp() != EOpArrayLength)
+        {
+            return node;
+        }
+        StorageBufferAccess access;
+        if (!GetStorageBufferAccess(node.getOperand(), mEnv, &access))
+        {
+            return node;
+        }
+        auto *size = new TIntermBinary(EOpIndexDirect, mUniforms.getStorageBufferSizes(),
+                                       CreateIndexNode(static_cast<int>(access.buffer->index)));
+        const size_t stride =
+            StorageBufferArrayStride(node.getOperand()->getType(), access.storage, access.packing);
+        if (!stride || stride > std::numeric_limits<unsigned int>::max() ||
+            access.offset > std::numeric_limits<unsigned int>::max())
+        {
+            mCompiler.getInfoSink().info << "Metal storage array range exceeds 32-bit metadata.\n";
+            mValid = false;
+            return node;
+        }
+        auto *length = new TIntermBinary(
+            EOpDiv,
+            new TIntermBinary(EOpSub, size->deepCopy(),
+                              CreateUIntNode(static_cast<unsigned int>(access.offset))),
+            CreateUIntNode(static_cast<unsigned int>(stride)));
+        auto *clamped = new TIntermTernary(
+            new TIntermBinary(EOpGreaterThanEqual, size,
+                              CreateUIntNode(static_cast<unsigned int>(access.offset))),
+            length, CreateUIntNode(0));
+        return *TIntermAggregate::CreateConstructor(TType(EbtInt, EbpHigh),
+                                                    new TIntermSequence{clamped});
+    }
+    bool mValid = true;
+    SymbolEnv &mEnv;
+    DriverUniformMetal &mUniforms;
+};
+}  // namespace
+
+namespace
+{
+class WrapStorageArguments : public TIntermRebuild
+{
+  public:
+    WrapStorageArguments(TCompiler &compiler, SymbolEnv &env)
+        : TIntermRebuild(compiler, false, true), mEnv(env)
+    {}
+
+  private:
+    PostResult visitBinaryPost(TIntermBinary &node) override
+    {
+        const TType &type = node.getLeft()->getType();
+        StorageBufferAccess access;
+        if (type.isArray() || !type.isVector() || type.getNominalSize() != 3 ||
+            !GetStorageBufferAccess(node.getLeft(), mEnv, &access))
+        {
+            return node;
+        }
+        TOperator operation;
+        switch (node.getOp())
+        {
+            case EOpAddAssign:
+                operation = EOpAdd;
+                break;
+            case EOpSubAssign:
+                operation = EOpSub;
+                break;
+            case EOpMulAssign:
+                operation = EOpMul;
+                break;
+            case EOpDivAssign:
+                operation = EOpDiv;
+                break;
+            case EOpIModAssign:
+                operation = EOpIMod;
+                break;
+            case EOpVectorTimesScalarAssign:
+                operation = EOpVectorTimesScalar;
+                break;
+            case EOpVectorTimesMatrixAssign:
+                operation = EOpVectorTimesMatrix;
+                break;
+            case EOpBitShiftLeftAssign:
+                operation = EOpBitShiftLeft;
+                break;
+            case EOpBitShiftRightAssign:
+                operation = EOpBitShiftRight;
+                break;
+            case EOpBitwiseAndAssign:
+                operation = EOpBitwiseAnd;
+                break;
+            case EOpBitwiseOrAssign:
+                operation = EOpBitwiseOr;
+                break;
+            case EOpBitwiseXorAssign:
+                operation = EOpBitwiseXor;
+                break;
+            default:
+                return node;
+        }
+        // SeparateCompoundExpressions has already hoisted index side effects.
+        // Read as a logical vector and assign back to the packed device value.
+        return *new TIntermBinary(
+            EOpAssign, node.getLeft(),
+            new TIntermBinary(operation, node.getLeft()->deepCopy(), node.getRight()));
+    }
+    PostResult visitAggregatePost(TIntermAggregate &node) override
+    {
+        const TFunction *function = node.getFunction();
+        if (!function || function->symbolType() == SymbolType::AngleInternal)
+        {
+            return node;
+        }
+        auto &arguments = *node.getSequence();
+        for (size_t i = 0; i < arguments.size(); ++i)
+        {
+            TQualifier qualifier = function->getParam(i)->getType().getQualifier();
+            if (qualifier != EvqParamOut && qualifier != EvqParamInOut)
+            {
+                continue;
+            }
+            auto *argument = arguments[i]->getAsTyped();
+            StorageBufferAccess access;
+            if (!GetStorageBufferAccess(argument, mEnv, &access))
+            {
+                continue;
+            }
+            TemplateArg type(argument->getType());
+            arguments[i] = &mEnv.callFunctionOverload(
+                Name(qualifier == EvqParamOut ? "storage_out" : "storage_inout"),
+                argument->getType(), *new TIntermSequence{argument}, 1, &type);
+        }
+        return node;
+    }
+    SymbolEnv &mEnv;
+};
+}  // namespace
+
+bool WrapStorageOutArguments(TCompiler &compiler, TIntermBlock &root, SymbolEnv &env)
+{
+    WrapStorageArguments wrap(compiler, env);
+    return wrap.rebuildRoot(root);
+}
+
+bool LowerStorageArrayLength(TCompiler &compiler,
+                             TIntermBlock &root,
+                             SymbolEnv &env,
+                             DriverUniformMetal &uniforms)
+{
+    LowerArrayLength lower(compiler, env, uniforms);
+    return lower.rebuildRoot(root) && lower.valid();
+}
+
+}  // namespace sh
