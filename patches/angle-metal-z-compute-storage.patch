+bool GenMetalTraverser::emitStorageAccess(TIntermTyped *node)
+{
+    StorageBufferAccess access;
+    if (!GetStorageBufferAccess(node, mSymbolEnv, &access) || access.base == node)
+    {
+        return false;
+    }
+    const TType &type = node->getType();
+    if (type.isArray() || type.getStruct() || type.isMatrix() ||
+        (type.isVector() && access.componentStride != 4))
+    {
+        // Aggregate loads/stores and row-major column values need explicit
+        // gather/scatter lowering. Never silently use the native Metal layout.
+        mStorageAccessSupported = false;
+        mOut << "0 /* unsupported storage aggregate access */";
+        return true;
+    }
+    auto *parent       = getParentNode();
+    const auto *binary = parent ? parent->getAsBinaryNode() : nullptr;
+    const bool write   = binary && binary->getLeft() == node && IsAssignment(binary->getOp());
+    const bool vector3 = type.isVector() && type.getNominalSize() == 3;
+    auto *call         = parent ? parent->getAsAggregate() : nullptr;
+    const TFunction *function   = call ? call->getFunction() : nullptr;
+    const bool storageReference = function && function->symbolType() == SymbolType::AngleInternal &&
+                                  (function->name().beginsWith("storage_out<") ||
+                                   function->name().beginsWith("storage_inout<"));
+    const bool cast = (vector3 || type.getBasicType() == EbtBool) && !write && !storageReference &&
+                      !(parent && parent->getAsSwizzleNode());
+    if (cast)
+    {
+        emitType(type, {});
+        mOut << "(";
+    }
+    mOut << "(*reinterpret_cast<";
+    if (access.buffer->readonly)
+    {
+        mOut << "const ";
+    }
+    mOut << "device ";
+    TType memoryType(type);
+    if (memoryType.getBasicType() == EbtBool)
+    {
+        memoryType.setBasicType(EbtUInt);
+    }
+    EmitVariableDeclarationConfig config;
+    config.isPacked = vector3;
+    emitType(memoryType, EmitTypeConfig{&config});
+    mOut << " *>((";
+    groupedTraverse(*access.base);
+    mOut << ") + " << access.offset << "u";
+    for (const auto &index : access.indices)
+    {
+        mOut << " + size_t(";
+        groupedTraverse(*index.first);
+        mOut << ") * " << index.second << "u";
+    }
+    mOut << "))";
+    if (cast)
+    {
+        mOut << ")";
+    }
+    return true;
+}
+
 bool GenMetalTraverser::visitBinary(Visit, TIntermBinary *binaryNode)
 {
+    if (emitStorageAccess(binaryNode))
+    {
+        return false;
+    }
     const TOperator op      = binaryNode->getOp();
     TIntermTyped &leftNode  = *binaryNode->getLeft();
     TIntermTyped &rightNode = *binaryNode->getRight();
@@ -2881,6 +2973,12 @@ bool sh::EmitMetal(TCompiler &compiler,
