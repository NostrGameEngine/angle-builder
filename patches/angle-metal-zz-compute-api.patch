+TEST_P(ComputeDispatchTestMetal, GPUGeneratedIndirectDispatch)
+{
+    constexpr char producer[] = R"(#version 310 es
+        layout(local_size_x = 1) in;
+        layout(std430, binding = 0) buffer Arguments { uint prefix[64]; uint x; uint y; uint z; } arguments;
+        void main() { arguments.x = 3u; arguments.y = 2u; arguments.z = 2u; }
+    )";
+    constexpr char consumer[] = R"(#version 310 es
+        layout(local_size_x = 4, local_size_y = 3, local_size_z = 2) in;
+        layout(std430, binding = 1) buffer Results { uvec4 values[]; } results;
+        void main() {
+            uvec3 p = gl_GlobalInvocationID;
+            uint i = p.x + 12u * (p.y + 6u * p.z);
+            bool valid = all(equal(gl_NumWorkGroups, uvec3(3,2,2))) && results.values.length() == 288;
+            results.values[i] = uvec4(p, valid ? gl_LocalInvocationIndex : 0xffffffffu);
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(a, producer);
+    ANGLE_GL_COMPUTE_PROGRAM(b, consumer);
+    GLBuffer arguments, results;
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, arguments);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, 512, nullptr, GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, arguments);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, results);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, 288 * 16, nullptr, GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 1, results);
+    glUseProgram(a);
+    glDispatchCompute(1, 1, 1);
+    glMemoryBarrier(GL_COMMAND_BARRIER_BIT | GL_SHADER_STORAGE_BARRIER_BIT);
+    glBindBuffer(GL_DISPATCH_INDIRECT_BUFFER, arguments);
+    glUseProgram(b);
+    glDispatchComputeIndirect(256);
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    ASSERT_GL_NO_ERROR();
+    auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, 288 * 16, GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (uint32_t z = 0; z < 4; ++z)
+    {
+        for (uint32_t y = 0; y < 6; ++y)
+        {
+            for (uint32_t x = 0; x < 12; ++x)
+            {
+                const size_t i = 4 * (x + 12 * (y + 6 * z));
+                EXPECT_EQ(actual[i], x);
+                EXPECT_EQ(actual[i + 1], y);
+                EXPECT_EQ(actual[i + 2], z);
+                EXPECT_EQ(actual[i + 3], x % 4 + 4 * (y % 3 + 3 * (z % 2)));
+            }
+        }
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
