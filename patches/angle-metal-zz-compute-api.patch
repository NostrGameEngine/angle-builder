+TEST_P(ComputeDispatchTestMetal, GPUGeneratedDrawAndMultiDrawIndirect)
+{
+    constexpr char producer[] = R"(#version 310 es
+        layout(local_size_x = 1) in;
+        layout(std430, binding = 0) buffer Commands { uint words[]; } commands;
+        layout(std430, binding = 1) buffer Indices { uint values[]; } indices;
+        uniform bool indexed;
+        uniform bool visible;
+        void main() {
+            // Two commands at offset 256, stride 32. The second is always empty.
+            commands.words[64] = 3u;
+            commands.words[65] = visible ? 1u : 0u;
+            commands.words[66] = indexed ? 2u : 3u;
+            commands.words[67] = indexed ? 0xffffffffu : 0u;
+            commands.words[68] = 0u;
+            commands.words[72] = 0u; commands.words[73] = 1u;
+            commands.words[74] = 0u; commands.words[75] = 0u; commands.words[76] = 0u;
+            indices.values[2] = 4u; indices.values[3] = 5u; indices.values[4] = 6u;
+        }
+    )";
+    constexpr char vertex[]   = R"(#version 310 es
+        void main() {
+            int i = gl_VertexID - 3;
+            vec2 p = i == 0 ? vec2(-1,-1) : i == 1 ? vec2(3,-1) : vec2(-1,3);
+            gl_Position = vec4(p,0,1);
+        }
+    )";
+    constexpr char fragment[] = R"(#version 310 es
+        precision highp float;
+        out vec4 color;
+        void main() { color = vec4(0,1,0,1); }
+    )";
+    ASSERT_TRUE(EnsureGLExtensionEnabled("GL_EXT_multi_draw_indirect"));
+    ANGLE_GL_COMPUTE_PROGRAM(compute, producer);
+    ANGLE_GL_PROGRAM(render, vertex, fragment);
+    GLVertexArray vao;
+    glBindVertexArray(vao);
+    GLBuffer commands, indices;
+    glBindBuffer(GL_DRAW_INDIRECT_BUFFER, commands);
+    glBufferData(GL_DRAW_INDIRECT_BUFFER, 512, nullptr, GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, commands);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, indices);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER, 128, nullptr, GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 1, indices);
+    for (uint32_t frame = 0; frame < 8; ++frame)
+    {
+        const bool indexed = (frame & 1) != 0;
+        const bool multi   = (frame & 2) != 0;
+        const bool visible = frame < 4;
+        glClearColor(1, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glUseProgram(compute);
+        glUniform1i(glGetUniformLocation(compute, "indexed"), indexed);
+        glUniform1i(glGetUniformLocation(compute, "visible"), visible);
+        glDispatchCompute(1, 1, 1);
+        glMemoryBarrier(GL_COMMAND_BARRIER_BIT | GL_ELEMENT_ARRAY_BARRIER_BIT);
+        glUseProgram(render);
+        const void *offset = reinterpret_cast<const void *>(256);
+        if (indexed)
+        {
+            if (multi)
+            {
+                glMultiDrawElementsIndirectEXT(GL_TRIANGLES, GL_UNSIGNED_INT, offset, 2, 32);
+            }
+            else
+            {
+                glDrawElementsIndirect(GL_TRIANGLES, GL_UNSIGNED_INT, offset);
+            }
+        }
+        else
+        {
+            if (multi)
+            {
+                glMultiDrawArraysIndirectEXT(GL_TRIANGLES, offset, 2, 32);
+            }
+            else
+            {
+                glDrawArraysIndirect(GL_TRIANGLES, offset);
+            }
+        }
+        ASSERT_GL_NO_ERROR();
+        EXPECT_PIXEL_RECT_EQ(0, 0, 16, 16, visible ? GLColor::green : GLColor::red);
+    }
+}
+
+// Each branch executes memory-only fences before a common execution barrier.
+// Replacing a fence with a rendezvous can hang this valid divergent shader.
+TEST_P(ComputeDispatchTestMetal, DivergentMemoryFences)
+{
+    constexpr char source[] = R"(#version 310 es
+        layout(local_size_x = 64) in;
+        layout(std430, binding = 0) coherent buffer Data { uint values[64]; uint result[64]; } data;
+        shared uint scratch[64];
+        void main() {
+            uint i = gl_LocalInvocationIndex;
+            data.values[i] = i + 13u; scratch[i] = i + 17u;
+            if ((i & 1u) == 0u) {
+                memoryBarrier();
+            } else {
+                memoryBarrierShared(); memoryBarrierBuffer();
+                memoryBarrierAtomicCounter(); memoryBarrierImage(); groupMemoryBarrier();
+            }
+            barrier();
+            data.result[i] = data.values[63u-i] + scratch[63u-i];
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(program, source);
+    GLBuffer allocation;
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, 128 * 4, nullptr, GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, allocation);
+    glUseProgram(program);
+    GLProgram restored;
+    for (uint32_t frame = 0; frame < 8; ++frame)
+    {
+        if (frame == 4)
+        {
+            reloadProgram(program, restored);
+            glUseProgram(restored);
+        }
+        glDispatchCompute(1, 1, 1);
+        glMemoryBarrier(GL_SHADER_STORAGE_BARRIER_BIT);
+    }
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    ASSERT_GL_NO_ERROR();
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, 128 * 4, GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (uint32_t i = 0; i < 64; ++i)
+    {
+        EXPECT_EQ(actual[i], i + 13);
+        EXPECT_EQ(actual[64 + i], 2 * (63 - i) + 30);
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
+
+TEST_P(ComputeDispatchTestMetal, AtomicReturnValuesAndCompareSwap)
+{
+    constexpr char source[] = R"(#version 310 es
+        layout(local_size_x = 1) in;
+        layout(std430, binding = 0) buffer Data { uint memory; uint results[8]; } data;
+        shared int memory;
+        void main() {
+            data.memory = 0xf0u;
+            data.results[0] = atomicAnd(data.memory, 0x3fu);
+            data.results[1] = atomicXor(data.memory, 0x0fu);
+            data.results[2] = atomicExchange(data.memory, 17u);
+            data.results[3] = atomicCompSwap(data.memory, 16u, 2u);
+            data.results[4] = atomicCompSwap(data.memory, 17u, 3u);
+            memory = -7;
+            data.results[5] = uint(atomicExchange(memory, -11));
+            data.results[6] = uint(atomicCompSwap(memory, -11, -19));
+            data.results[7] = uint(atomicAdd(memory, 0));
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(program, source);
+    GLBuffer allocation;
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, 9 * 4, nullptr, GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, allocation);
+    glUseProgram(program);
+    glDispatchCompute(1, 1, 1);
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    ASSERT_GL_NO_ERROR();
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, 9 * 4, GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    const std::array<uint32_t, 9> expected = {3,
+                                              0xf0,
+                                              0x30,
+                                              0x3f,
+                                              17,
+                                              17,
+                                              static_cast<uint32_t>(-7),
+                                              static_cast<uint32_t>(-11),
+                                              static_cast<uint32_t>(-19)};
+    for (size_t i = 0; i < expected.size(); ++i)
+    {
+        EXPECT_EQ(actual[i], expected[i]);
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
+
+TEST_P(ComputeDispatchTestMetal, ZeroDispatchAndFrontendValidation)
+{
+    constexpr char source[] = R"(#version 310 es
+        layout(local_size_x = 1) in;
+        layout(std430, binding = 0) buffer Output { uint value; } outputData;
+        void main() { outputData.value = 99u; }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(program, source);
+    GLBuffer buffer;
+    const std::array<uint32_t, 8> sentinel = {17, 0, 0, 0, 0, 0, 0, 0};
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, buffer);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(sentinel), sentinel.data(), GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, buffer);
+    glUseProgram(program);
+    glDispatchCompute(0, 1, 1);
+    glDispatchCompute(1, 0, 1);
+    glDispatchCompute(1, 1, 0);
+    GLint limit;
+    glGetIntegeri_v(GL_MAX_COMPUTE_WORK_GROUP_COUNT, 0, &limit);
+    glDispatchCompute(static_cast<GLuint>(limit) + 1, 1, 1);
+    EXPECT_GL_ERROR(GL_INVALID_VALUE);
+    glBindBuffer(GL_DISPATCH_INDIRECT_BUFFER, buffer);
+    glDispatchComputeIndirect(2);
+    EXPECT_GL_ERROR(GL_INVALID_VALUE);
+    auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, 4, GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    EXPECT_EQ(*actual, sentinel[0]);
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
