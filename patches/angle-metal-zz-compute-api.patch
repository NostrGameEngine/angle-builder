+angle::Result ProgramExecutableMtl::setupDispatch(const gl::Context *glContext,
+                                                  mtl::ComputeCommandEncoder **encoderOut)
+{
+    ContextMtl *context = mtl::GetImpl(glContext);
+    angle::ObjCPtr<id<MTLComputePipelineState>> pipeline;
+    ANGLE_TRY(getComputePipeline(context, &pipeline));
+    const auto &size         = mExecutable->getComputeShaderLocalSize();
+    const size_t invocations = size[0] * size[1] * size[2];
+    ANGLE_CHECK(context, invocations <= pipeline.get().maxTotalThreadsPerThreadgroup,
+                "Compute local size exceeds this Metal pipeline's limit", GL_INVALID_OPERATION);
+    const auto &glState = glContext->getState();
+    const auto &info    = getComputeShaderInfo();
+    mtl::ComputeDriverUniforms driver;
+    std::array<mtl::BufferRef, mtl::kMaxComputeStorageBuffers> buffers;
+    std::array<size_t, mtl::kMaxComputeStorageBuffers> offsets = {};
+    const auto &blocks = mExecutable->getShaderStorageBlocks();
+    for (size_t block = 0; block < blocks.size(); ++block)
+    {
+        const uint32_t slot = info.actualSSBOBindings[block];
+        if (slot >= mtl::kMaxComputeStorageBuffers)
+        {
+            continue;
+        }
+        const auto &binding =
+            glState.getIndexedShaderStorageBuffer(mExecutable->getShaderStorageBlockBinding(block));
+        ANGLE_CHECK(context, binding.get(), "Missing shader storage buffer", GL_INVALID_OPERATION);
+        buffers[slot] = mtl::GetImpl(binding.get())->getCurrentBuffer();
+        offsets[slot] = static_cast<size_t>(binding.getOffset());
+        driver.storageBufferSizes[slot] =
+            static_cast<uint32_t>(gl::GetBoundBufferAvailableSize(binding));
+    }
+    // Resource classes share the same allocation and dependency tracking used by
+    // graphics. MarkShaderStorageUsage in the frontend invalidates GL caches.
+    auto &uniform = mDefaultUniformBlocks[gl::ShaderType::Compute].uniformData;
+    mtl::BufferSlice uploaded;
+    if (uniform.size() > mtl::kInlineConstDataMaxSize)
+    {
+        auto *pool = getBufferPool(context, gl::ShaderType::Compute);
+        pool->releaseInFlightBuffers(context);
+        angle::Span<uint8_t> mapped;
+        ANGLE_TRY(pool->allocateAndMap(context, uniform.size(), &mapped, &uploaded));
+        angle::SpanMemcpy(mapped, uniform.span());
+        ANGLE_TRY(pool->commit(context));
+    }
+    std::array<mtl::BufferRef, mtl::kMaxShaderBuffers> uniformBuffers;
+    std::array<size_t, mtl::kMaxShaderBuffers> uniformOffsets = {};
+    for (size_t i = 0; i < mExecutable->getUniformBlocks().size(); ++i)
+    {
+        const uint32_t slot = info.actualUBOBindings[i];
+        if (slot >= mtl::kMaxShaderBuffers)
+        {
+            continue;
+        }
+        const auto &binding =
+            glState.getIndexedUniformBuffer(mExecutable->getUniformBlockBinding(i));
+        ANGLE_CHECK(context, binding.get(), "Missing compute uniform buffer", GL_INVALID_OPERATION);
+        uniformBuffers[slot] = mtl::GetImpl(binding.get())->getCurrentBuffer();
+        uniformOffsets[slot] = static_cast<size_t>(binding.getOffset());
+    }
+    struct SampledTexture
+    {
+        TextureMtl *texture;
+        gl::Sampler *sampler;
+        uint32_t textureSlot;
+        uint32_t samplerSlot;
+    };
+    std::vector<SampledTexture> sampledTextures;
+    const auto &completeTextures = glState.getActiveTexturesCache();
+    for (size_t i = 0; i < mExecutable->getSamplerBindings().size(); ++i)
+    {
+        const auto &binding      = mExecutable->getSamplerBindings()[i];
+        const auto &metalBinding = info.actualSamplerBindings[i];
+        if (metalBinding.textureBinding >= mtl::kMaxShaderSamplers)
+        {
+            continue;
+        }
+        for (uint32_t element = 0; element < binding.textureUnitsCount; ++element)
+        {
+            const GLuint unit =
+                binding.getTextureUnit(mExecutable->getSamplerBoundTextureUnits(), element);
+            gl::Texture *texture = completeTextures[unit];
+            if (!texture)
+            {
+                ANGLE_TRY(context->getIncompleteTexture(glContext, binding.textureType,
+                                                        binding.format, &texture));
+            }
+            TextureMtl *backend = mtl::GetImpl(texture);
+            ANGLE_TRY(backend->ensureNativeStorageCreated(glContext, true,
+                                                          ImageMipLevels::EnabledLevels));
+            sampledTextures.push_back({backend, context->getState().getSampler(unit),
+                                       metalBinding.textureBinding + element,
+                                       metalBinding.samplerBinding + element});
+        }
+    }
+    struct StorageImage
+    {
+        TextureMtl *texture;
+        const gl::ImageUnit *unit;
+        uint32_t slot;
+    };
+    std::vector<StorageImage> storageImages;
+    for (size_t i = 0; i < mExecutable->getImageBindings().size(); ++i)
+    {
+        const uint32_t slot = info.actualComputeImageBindings[i];
+        if (slot >= mtl::kMaxShaderImages)
+        {
+            continue;
+        }
+        const auto &binding = mExecutable->getImageBindings()[i];
+        ANGLE_CHECK(context, binding.boundImageUnits.size() == 1,
+                    "Compute image arrays are not implemented", GL_INVALID_OPERATION);
+        const auto &unit = glState.getImageUnit(binding.boundImageUnits[0]);
+        ANGLE_CHECK(context, unit.texture.get() && !unit.layered,
+                    "Compute image requires a bound non-layered texture", GL_INVALID_OPERATION);
+        TextureMtl *texture = mtl::GetImpl(unit.texture.get());
+        ANGLE_TRY(
+            texture->ensureNativeStorageCreated(glContext, true, ImageMipLevels::EnabledLevels));
+        storageImages.push_back({texture, &unit, slot});
+    }
+    // Texture allocation/uploads can end the current compute encoder. Obtain
+    // it only after every resource is ready, then bind this dispatch's state.
+    auto *encoder = context->getComputeCommandEncoder();
+    encoder->setComputePipelineState(pipeline.get());
+    for (size_t slot = 0; slot < buffers.size(); ++slot)
+    {
+        if (buffers[slot])
+        {
+            encoder->setBufferForWrite(buffers[slot], offsets[slot], static_cast<uint32_t>(slot));
+        }
+    }
+    for (size_t slot = 0; slot < uniformBuffers.size(); ++slot)
+    {
+        if (uniformBuffers[slot])
+        {
+            encoder->setBuffer(uniformBuffers[slot], uniformOffsets[slot],
+                               static_cast<uint32_t>(slot));
+        }
+    }
+    encoder->setData(driver, mtl::kDriverUniformsBindingIndex);
+    if (uniform.size())
+    {
+        if (uploaded.buffer())
+        {
+            encoder->setBuffer(uploaded.buffer(), uploaded.offset(),
+                               mtl::kDefaultUniformsBindingIndex);
+        }
+        else
+        {
+            encoder->setBytes(uniform.data(), uniform.size(), mtl::kDefaultUniformsBindingIndex);
+        }
+    }
+    for (const auto &texture : sampledTextures)
+    {
+        ANGLE_TRY(texture.texture->bindToComputeShader(glContext, encoder, texture.sampler,
+                                                       texture.textureSlot, texture.samplerSlot));
+    }
+    for (const auto &image : storageImages)
+    {
+        ANGLE_TRY(image.texture->bindToComputeImage(glContext, encoder, image.slot,
+                                                    image.unit->level, image.unit->layer,
+                                                    image.unit->format));
+    }
+    *encoderOut = encoder;
+    return angle::Result::Continue;
+}
