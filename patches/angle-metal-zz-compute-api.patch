+{
+class ComputeDispatchTestMetal : public ANGLETest<>
+{
+  protected:
+    ComputeDispatchTestMetal()
+    {
+        setWindowWidth(16);
+        setWindowHeight(16);
+    }
+
+    void reloadProgram(GLuint source, GLuint destination)
+    {
+        GLint length = 0;
+        glGetProgramiv(source, GL_PROGRAM_BINARY_LENGTH, &length);
+        ASSERT_GT(length, 0);
+        std::vector<uint8_t> bytes(length);
+        GLenum format   = 0;
+        GLsizei written = 0;
+        glGetProgramBinary(source, length, &written, &format, bytes.data());
+        glProgramBinary(destination, format, bytes.data(), written);
+        GLint linked = GL_FALSE;
+        glGetProgramiv(destination, GL_LINK_STATUS, &linked);
+        ASSERT_EQ(linked, GL_TRUE);
+        ASSERT_GL_NO_ERROR();
+    }
+};
+
+// Exercise actual GL compilation, linking, remapping, uniforms, program binary
+// reload and dispatch. Two SSBO ranges alias one allocation; readback is final.
+TEST_P(ComputeDispatchTestMetal, StorageRangesUniformsAndBinary)
+{
+    RecordProperty("GLVersion", reinterpret_cast<const char *>(glGetString(GL_VERSION)));
+    RecordProperty("GLRenderer", reinterpret_cast<const char *>(glGetString(GL_RENDERER)));
+    RecordProperty("Profile", "internal integration profile; not GLES 3.1 conformance");
+    for (auto limit : {GL_MAX_COMPUTE_WORK_GROUP_INVOCATIONS, GL_MAX_COMPUTE_SHARED_MEMORY_SIZE,
+                       GL_MAX_SHADER_STORAGE_BUFFER_BINDINGS, GL_MAX_COMPUTE_UNIFORM_BLOCKS,
+                       GL_MAX_COMPUTE_IMAGE_UNIFORMS})
+    {
+        GLint value = 0;
+        glGetIntegerv(limit, &value);
+        RecordProperty("Limit_" + std::to_string(limit), value);
+    }
+    constexpr char source[] = R"(#version 310 es
+        layout(local_size_x = 8) in;
+        layout(std430, binding = 5) readonly buffer InputData { uint prefix; uint values[]; } inputData;
+        layout(std430, binding = 2) buffer OutputData { uvec4 header; uint values[]; } outputData;
+        uniform uint scale;
+        uniform highp vec4 bias;
+        void main() {
+            uint i = gl_LocalInvocationIndex;
+            bool valid = inputData.values.length() == 8 && outputData.values.length() == 8;
+            outputData.values[i] = valid ? (inputData.values[i] + inputData.prefix) * scale + uint(bias.x) : 0xffffffffu;
+            if (i == 0u) outputData.header = uvec4(1, 2, 3, 4);
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(program, source);
+    GLBuffer allocation;
+    std::array<uint32_t, 1024> expected;
+    expected.fill(0xcdcdcdcdu);
+    expected[256 / 4] = 13;
+    for (uint32_t i = 0; i < 8; ++i)
+    {
+        expected[256 / 4 + 1 + i] = 100 + i;
+    }
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(expected), expected.data(), GL_DYNAMIC_DRAW);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 5, allocation, 256, 36);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 2, allocation, 768, 48);
+    ASSERT_GL_NO_ERROR();
+    GLProgram restored;
+    GLuint active = program;
+    for (uint32_t frame = 0; frame < 4; ++frame)
+    {
+        if (frame == 2)
+        {
+            GLint length;
+            glGetProgramiv(program, GL_PROGRAM_BINARY_LENGTH, &length);
+            ASSERT_GT(length, 0);
+            std::vector<uint8_t> bytes(length);
+            GLenum format;
+            GLsizei written;
+            glGetProgramBinary(program, length, &written, &format, bytes.data());
+            glProgramBinary(restored, format, bytes.data(), written);
+            GLint linked;
+            glGetProgramiv(restored, GL_LINK_STATUS, &linked);
+            ASSERT_EQ(linked, GL_TRUE);
+            active = restored;
+        }
+        glUseProgram(active);
+        glUniform1ui(glGetUniformLocation(active, "scale"), 7 + frame);
+        glUniform4f(glGetUniformLocation(active, "bias"), 3, 0, 0, 0);
+        glDispatchCompute(1, 1, 1);
+        glMemoryBarrier(GL_SHADER_STORAGE_BARRIER_BIT);
+        ASSERT_GL_NO_ERROR();
+    }
+    for (uint32_t i = 0; i < 4; ++i)
+    {
+        expected[768 / 4 + i] = i + 1;
+    }
+    for (uint32_t i = 0; i < 8; ++i)
+    {
+        expected[768 / 4 + 4 + i] = (113 + i) * 10 + 3;
+    }
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (size_t i = 0; i < expected.size(); ++i)
+    {
+        EXPECT_EQ(actual[i], expected[i]) << i;
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
