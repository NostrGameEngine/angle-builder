+TEST_P(ComputeDispatchTestMetal, SharedAndStorageAtomics)
+{
+    constexpr char source[] = R"(#version 310 es
+        layout(local_size_x = 64) in;
+        layout(std430, binding = 0) buffer Data {
+            uint count; int minimum; int maximum; uint mask;
+            uint groups[4]; uint tickets[256]; uint globalTickets[256];
+        } data;
+        shared uint count;
+        void main() {
+            uint local = gl_LocalInvocationIndex;
+            uint index = gl_GlobalInvocationID.x;
+            if (local == 0u) count = 0u;
+            barrier();
+            uint ticket = atomicAdd(count, 1u);
+            data.tickets[index] = ticket;
+            data.globalTickets[index] = atomicAdd(data.count, 1u);
+            atomicMin(data.minimum, int(index) - 128);
+            atomicMax(data.maximum, int(index) - 128);
+            atomicOr(data.mask, 1u << (index % 32u));
+            barrier();
+            if (local == 0u) data.groups[gl_WorkGroupID.x] = atomicAdd(count, 0u);
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(program, source);
+    GLBuffer buffer;
+    std::array<uint32_t, 4 + 4 + 256 + 256> initial = {};
+    initial[1]                                      = 0x7fffffffu;
+    initial[2]                                      = 0x80000000u;
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, buffer);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(initial), initial.data(), GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, buffer);
+    glUseProgram(program);
+    glDispatchCompute(4, 1, 1);
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    ASSERT_GL_NO_ERROR();
+    auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(initial), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    EXPECT_EQ(actual[0], 256u);
+    EXPECT_EQ(static_cast<int32_t>(actual[1]), -128);
+    EXPECT_EQ(static_cast<int32_t>(actual[2]), 127);
+    EXPECT_EQ(actual[3], 0xffffffffu);
+    std::array<bool, 256> globalSeen = {};
+    for (uint32_t group = 0; group < 4; ++group)
+    {
+        EXPECT_EQ(actual[4 + group], 64u);
+        std::array<bool, 64> localSeen = {};
+        for (uint32_t i = 0; i < 64; ++i)
+        {
+            uint32_t ticket = actual[8 + group * 64 + i];
+            ASSERT_LT(ticket, 64u);
+            EXPECT_FALSE(localSeen[ticket]);
+            localSeen[ticket] = true;
+            uint32_t global   = actual[8 + 256 + group * 64 + i];
+            ASSERT_LT(global, 256u);
+            EXPECT_FALSE(globalSeen[global]);
+            globalSeen[global] = true;
+        }
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
+
+// The producer writes std140 bytes directly. The consumer changes the UBO's
+// GL binding point and reads the same allocation, including bools, array strides,
+// vec3 tail packing and a row-major matrix. Only final validation maps the buffer.
+TEST_P(ComputeDispatchTestMetal, GPUWrittenUniformBuffer)
+{
+    constexpr char producer[] = R"(#version 310 es
+        layout(local_size_x = 1) in;
+        layout(std140, row_major, binding = 0) buffer Data {
+            bool enabled; uint prefix; vec3 normal; float weight;
+            float coefficients[3]; mat2 matrix;
+        } data;
+        void main() {
+            data.enabled = true; data.prefix = 13u;
+            data.normal = vec3(2,3,4); data.weight = 7.0;
+            data.coefficients[0] = 11.0; data.coefficients[1] = 17.0; data.coefficients[2] = 19.0;
+            data.matrix[0][0] = 23.0; data.matrix[1][0] = 29.0;
+            data.matrix[0][1] = 31.0; data.matrix[1][1] = 37.0;
+        }
+    )";
+    constexpr char consumer[] = R"(#version 310 es
+        layout(local_size_x = 3) in;
+        layout(std140, row_major, binding = 3) uniform Data {
+            bool enabled; uint prefix; vec3 normal; float weight;
+            float coefficients[3]; mat2 matrix;
+        } data;
+        layout(std430, binding = 1) buffer Results { uint values[]; } results;
+        void main() {
+            uint i = gl_LocalInvocationIndex;
+            results.values[i] = data.enabled ? data.prefix + uint(dot(data.normal,vec3(1)) +
+                data.weight + data.coefficients[i] + data.matrix[0][0] + data.matrix[1][0] +
+                data.matrix[0][1] + data.matrix[1][1]) : 0xffffffffu;
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(a, producer);
+    ANGLE_GL_COMPUTE_PROGRAM(b, consumer);
+    GLBuffer allocation;
+    std::array<uint32_t, 256> initial;
+    initial.fill(0xcdcdcdcdu);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(initial), initial.data(), GL_DYNAMIC_DRAW);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 0, allocation, 256, 112);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 1, allocation, 768, 12);
+    const GLuint index = glGetUniformBlockIndex(b, "Data");
+    ASSERT_NE(index, GL_INVALID_INDEX);
+    glUniformBlockBinding(b, index, 7);
+    glBindBufferRange(GL_UNIFORM_BUFFER, 7, allocation, 256, 112);
+    glUseProgram(a);
+    glDispatchCompute(1, 1, 1);
+    glMemoryBarrier(GL_UNIFORM_BARRIER_BIT);
+    glUseProgram(b);
+    glDispatchCompute(1, 1, 1);
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    ASSERT_GL_NO_ERROR();
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 768, 12, GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    const std::array<uint32_t, 3> expected = {160, 166, 168};
+    for (size_t i = 0; i < expected.size(); ++i)
+    {
+        EXPECT_EQ(actual[i], expected[i]);
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
+
+// GLES image bindings come from layout(binding); sampler units can be changed
+// after link. Store an image, then sample it without an intermediate readback.
+TEST_P(ComputeDispatchTestMetal, ImageToSamplerWithSamplerRemapping)
+{
+    constexpr char producer[] = R"(#version 310 es
+        layout(local_size_x = 8) in;
+        layout(rgba32ui, binding = 2) uniform writeonly highp uimage2D destination;
+        void main() {
+            uint i = gl_GlobalInvocationID.x;
+            imageStore(destination, ivec2(i, 0), uvec4(i+3u, i*7u, 19u, 23u));
+        }
+    )";
+    constexpr char consumer[] = R"(#version 310 es
+        layout(local_size_x = 8) in;
+        uniform highp usampler2D sourceImage;
+        layout(std430, binding = 0) buffer Results { uvec4 values[]; } results;
+        void main() {
+            uint i = gl_GlobalInvocationID.x;
+            results.values[i] = texelFetch(sourceImage, ivec2(i,0),0);
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(a, producer);
+    ANGLE_GL_COMPUTE_PROGRAM(b, consumer);
+    GLTexture image;
+    glActiveTexture(GL_TEXTURE3);
+    glBindTexture(GL_TEXTURE_2D, image);
+    glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA32UI, 8, 1);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    GLBuffer results;
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, results);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, 8 * 16, nullptr, GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, results);
+    glBindImageTexture(2, image, 0, GL_FALSE, 0, GL_WRITE_ONLY, GL_RGBA32UI);
+    GLProgram restored;
+    reloadProgram(a, restored);
+    glUseProgram(restored);
+    GLint imageUnit = -1;
+    glGetUniformiv(restored, glGetUniformLocation(restored, "destination"), &imageUnit);
+    ASSERT_EQ(imageUnit, 2);
+    ASSERT_GL_NO_ERROR();
+    glDispatchCompute(1, 1, 1);
+    glMemoryBarrier(GL_TEXTURE_FETCH_BARRIER_BIT);
+    ASSERT_GL_NO_ERROR();
+    glUseProgram(b);
+    glUniform1i(glGetUniformLocation(b, "sourceImage"), 3);
+    glDispatchCompute(1, 1, 1);
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    ASSERT_GL_NO_ERROR();
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, 8 * 16, GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (uint32_t i = 0; i < 8; ++i)
+    {
+        EXPECT_EQ(actual[4 * i], i + 3);
+        EXPECT_EQ(actual[4 * i + 1], i * 7);
+        EXPECT_EQ(actual[4 * i + 2], 19u);
+        EXPECT_EQ(actual[4 * i + 3], 23u);
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
