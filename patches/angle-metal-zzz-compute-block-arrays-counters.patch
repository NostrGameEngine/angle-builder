+// Descriptor arrays select independent ranges. Exercise all twelve compute UBO
+// slots, including the holes reserved for driver and default uniforms.
+TEST_P(ComputeDispatchTestMetal, StorageAndUniformBlockArrays)
+{
+    constexpr char source[] = R"(#version 310 es
+        layout(local_size_x = 1) in;
+        layout(std430, binding = 3) buffer Data { uint prefix; uint values[]; } data[2];
+        layout(std140, binding = 0) uniform UniformData { uint values[2]; } uniforms[12];
+        uint inputLength() { return uint(data[0].values.length()); }
+        void main() {
+            uint sum = uniforms[0].values[1] + uniforms[1].values[1] + uniforms[2].values[1] +
+                uniforms[3].values[1] + uniforms[4].values[1] + uniforms[5].values[1] +
+                uniforms[6].values[1] + uniforms[7].values[1] + uniforms[8].values[1] +
+                uniforms[9].values[1] + uniforms[10].values[1] + uniforms[11].values[1];
+            data[1].prefix = inputLength()*100u + uint(data[1].values.length());
+            for (uint i=0u; i<3u; ++i)
+                data[1].values[i] = data[0].prefix + data[0].values[i] + sum;
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(program, source);
+    GLBuffer allocation;
+    std::array<uint32_t, 2048> expected;
+    expected.fill(0xcdcdcdcdu);
+    expected[256 / 4] = 13;
+    for (uint32_t i = 0; i < 8; ++i)
+    {
+        expected[256 / 4 + 1 + i] = 100 + i;
+    }
+    for (uint32_t i = 0; i < 12; ++i)
+    {
+        expected[(1536 + i * 256 + 16) / 4] = 200 + i;
+    }
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(expected), expected.data(), GL_DYNAMIC_DRAW);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 3, allocation, 256, 36);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 4, allocation, 768, 16);
+    GLProgram restored;
+    reloadProgram(program, restored);
+    for (uint32_t i = 0; i < 12; ++i)
+    {
+        const std::string name = "UniformData[" + std::to_string(i) + "]";
+        const GLuint block     = glGetUniformBlockIndex(restored, name.c_str());
+        ASSERT_NE(block, GL_INVALID_INDEX) << name;
+        GLint initialBinding = -1;
+        glGetActiveUniformBlockiv(restored, block, GL_UNIFORM_BLOCK_BINDING, &initialBinding);
+        EXPECT_EQ(initialBinding, static_cast<GLint>(i));
+        glUniformBlockBinding(restored, block, 20 + i);
+        glBindBufferRange(GL_UNIFORM_BUFFER, 20 + i, allocation, 1536 + i * 256, 32);
+    }
+    glUseProgram(restored);
+    glDispatchCompute(1, 1, 1);
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    ASSERT_GL_NO_ERROR();
+    expected[768 / 4] = 803;
+    for (uint32_t i = 0; i < 3; ++i)
+    {
+        expected[768 / 4 + 1 + i] = 13 + 100 + i + 2466;
+    }
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (size_t i = 0; i < expected.size(); ++i)
+    {
+        EXPECT_EQ(actual[i], expected[i]) << i;
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
