+TEST_P(ComputeDispatchTestMetal, AtomicCountersRangesAndWraparound)
+{
+    constexpr char producer[] = R"(#version 310 es
+        layout(local_size_x = 64) in;
+        layout(binding = 0, offset = 8) uniform atomic_uint counters[2];
+        layout(std430, binding = 0) buffer Results { uvec2 tickets[]; } results;
+        uint take(atomic_uint counter) { return atomicCounterIncrement(counter); }
+        void main() {
+            results.tickets[gl_GlobalInvocationID.x] =
+                uvec2(take(counters[0]), atomicCounterDecrement(counters[1]));
+        }
+    )";
+    constexpr char consumer[] = R"(#version 310 es
+        layout(local_size_x = 1) in;
+        layout(binding = 0, offset = 8) uniform atomic_uint counters[2];
+        layout(std430, binding = 1) buffer Snapshot { uvec2 counters; } result;
+        void main() { result.counters = uvec2(atomicCounter(counters[0]), atomicCounter(counters[1])); }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(a, producer);
+    ANGLE_GL_COMPUTE_PROGRAM(b, consumer);
+    GLBuffer allocation;
+    std::array<uint32_t, 1024> expected;
+    expected.fill(0xcdcdcdcdu);
+    expected[3] = 7;
+    expected[4] = 9;
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(expected), expected.data(), GL_DYNAMIC_DRAW);
+    glBindBufferRange(GL_ATOMIC_COUNTER_BUFFER, 0, allocation, 4, 32);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 0, allocation, 256, 256 * 8);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 1, allocation, 2560, 8);
+    glUseProgram(a);
+    glDispatchCompute(4, 1, 1);
+    glMemoryBarrier(GL_ATOMIC_COUNTER_BARRIER_BIT);
+    GLProgram restored;
+    reloadProgram(b, restored);
+    glUseProgram(restored);
+    glDispatchCompute(1, 1, 1);
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    ASSERT_GL_NO_ERROR();
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    const uint32_t finalIncrement    = 263;
+    const uint32_t finalDecrement    = 9u - 256u;
+    expected[3]                      = finalIncrement;
+    expected[4]                      = finalDecrement;
+    expected[2560 / 4]               = finalIncrement;
+    expected[2560 / 4 + 1]           = finalDecrement;
+    std::array<bool, 256> increments = {}, decrements = {};
+    for (uint32_t i = 0; i < 256; ++i)
+    {
+        const uint32_t increment = actual[256 / 4 + 2 * i] - 7u;
+        const uint32_t decrement = 8u - actual[256 / 4 + 2 * i + 1];
+        ASSERT_LT(increment, 256u);
+        ASSERT_LT(decrement, 256u);
+        EXPECT_FALSE(increments[increment]);
+        EXPECT_FALSE(decrements[decrement]);
+        increments[increment] = true;
+        decrements[decrement] = true;
+    }
+    for (size_t i = 0; i < expected.size(); ++i)
+    {
+        if (i < 256 / 4 || i >= (256 + 256 * 8) / 4)
+        {
+            EXPECT_EQ(actual[i], expected[i]) << i;
+        }
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
