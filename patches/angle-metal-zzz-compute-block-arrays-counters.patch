+// A counter-only program must invalidate a cached vertex-format conversion.
+// Merely marking the Metal resource as GPU-written does not invalidate GL caches.
+TEST_P(ComputeDispatchTestMetal, AtomicCounterInvalidatesVertexConversion)
+{
+    constexpr char compute[]  = R"(#version 310 es
+        layout(local_size_x = 1) in;
+        layout(binding = 0, offset = 0) uniform atomic_uint counter;
+        void main() { atomicCounterIncrement(counter); }
+    )";
+    constexpr char vertex[]   = R"(#version 310 es
+        layout(location = 0) in float state;
+        out vec4 vertexColor;
+        void main() {
+            vec2 p = gl_VertexID == 0 ? vec2(-1,-1) : gl_VertexID == 1 ? vec2(3,-1) : vec2(-1,3);
+            gl_Position = vec4(p,0,1);
+            vertexColor = state < 0.5 ? vec4(1,0,0,1) : vec4(0,1,0,1);
+        }
+    )";
+    constexpr char fragment[] = R"(#version 310 es
+        precision highp float;
+        in vec4 vertexColor;
+        out vec4 color;
+        void main() { color = vertexColor; }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(producer, compute);
+    ANGLE_GL_PROGRAM(render, vertex, fragment);
+    GLVertexArray vao;
+    glBindVertexArray(vao);
+    GLBuffer allocation;
+    glBindBuffer(GL_ARRAY_BUFFER, allocation);
+    const uint32_t fixed = 0x00007fffu;
+    glBufferData(GL_ARRAY_BUFFER, 4, &fixed, GL_DYNAMIC_DRAW);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 1, GL_FIXED, GL_FALSE, 4, nullptr);
+    glVertexAttribDivisor(0, 1);
+    glBindBufferBase(GL_ATOMIC_COUNTER_BUFFER, 0, allocation);
+    glUseProgram(render);
+    glDrawArraysInstanced(GL_TRIANGLES, 0, 3, 1);
+    glUseProgram(producer);
+    glDispatchCompute(1, 1, 1);
+    glMemoryBarrier(GL_VERTEX_ATTRIB_ARRAY_BARRIER_BIT);
+    glUseProgram(render);
+    glDrawArraysInstanced(GL_TRIANGLES, 0, 3, 1);
+    ASSERT_GL_NO_ERROR();
+    EXPECT_PIXEL_RECT_EQ(0, 0, 16, 16, GLColor::green);
+}
