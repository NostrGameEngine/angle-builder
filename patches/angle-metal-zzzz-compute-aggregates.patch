+                else data.values[record][0].z = float(value+2u);
+                memoryBarrierBuffer();
+            }
+            if(i==0u) {
+                data.tail = 2147483647;
+                int oldTail = data.tail++;
+                int preTail = --data.tail;
+                data.signedValues = ivec3(2147483647,5,(-2147483647-1));
+                ivec2 old = data.signedValues.zx++;
+                --data.signedValues.xy;
+                data.returned = ivec4(old,oldTail,preTail);
