+void GenMetalTraverser::emitStorageAggregateHelpers(TIntermBlock &body)
+{
+    class Collector final : public TIntermTraverser
+    {
+      public:
+        Collector(const SymbolEnv &env) : TIntermTraverser(true, false, false), mEnv(env) {}
+        std::vector<TIntermTyped *> nodes;
+
+      private:
+        void add(TIntermTyped *node)
+        {
+            StorageBufferAccess access;
+            auto *parent = getParentNode();
+            auto *unary  = parent ? parent->getAsUnaryNode() : nullptr;
+            const bool increment =
+                unary && (unary->getOp() == EOpPreIncrement || unary->getOp() == EOpPostIncrement ||
+                          unary->getOp() == EOpPreDecrement || unary->getOp() == EOpPostDecrement);
+            auto *call                = parent ? parent->getAsAggregate() : nullptr;
+            const TFunction *function = call ? call->getFunction() : nullptr;
+            const bool storageWrapper = function &&
+                                        function->symbolType() == SymbolType::AngleInternal &&
+                                        (function->name().beginsWith("storage_increment_") ||
+                                         function->name().beginsWith("storage_decrement_") ||
+                                         function->name().beginsWith("storage_swizzle_"));
+            auto *swizzle             = parent ? parent->getAsSwizzleNode() : nullptr;
+            const bool swizzleAccess  = swizzle && swizzle->getSwizzleOffsets().size() > 1;
+            if (!GetStorageBufferAccess(node, mEnv, &access) || access.base == node ||
+                (!needsStorageAggregate(node->getType(), access) && !increment && !storageWrapper &&
+                 !swizzleAccess))
+            {
+                return;
+            }
+            if (node->getType().isArray() && node->getType().getOutermostArraySize() == 0)
+            {
+                return;
+            }
+            auto *binary = parent ? parent->getAsBinaryNode() : nullptr;
+            StorageBufferAccess parentAccess;
+            if (binary && binary->getLeft() == node &&
+                GetStorageBufferAccess(binary, mEnv, &parentAccess))
+            {
+                return;
+            }
+            nodes.push_back(node);
+        }
+        bool visitBinary(Visit, TIntermBinary *node) override
+        {
+            add(node);
+            return true;
+        }
+        bool visitSwizzle(Visit, TIntermSwizzle *node) override
+        {
+            add(node);
+            return true;
+        }
+        const SymbolEnv &mEnv;
+    } collector(mSymbolEnv);
+    body.traverse(&collector);
+    for (TIntermTyped *node : collector.nodes)
+    {
+        StorageBufferAccess access;
+        GetStorageBufferAccess(node, mSymbolEnv, &access);
+        storageAggregateLayout(node->getType(), access);
+    }
+    // ToposortStructs may interleave equality helpers with struct declarations.
+    // Emit layouts only before the function that uses them, after their value
+    // types have been declared, rather than before the first module function.
+    for (size_t i = 0; i < mStorageLayouts.size(); ++i)
+    {
+        auto &layout = mStorageLayouts[i];
+        if (layout.emitted)
+        {
+            continue;
+        }
+        layout.emitted = true;
+        mOut << "struct ANGLE_StorageLayout" << i << " {\n  using Value = ";
+        emitType(*layout.type, {});
+        mOut << ";\n  static Value load(const device uchar *ANGLE_data) {\n    Value value{};\n";
+        emitStorageTransfers(*layout.type, layout.storage, layout.packing, layout.componentStride,
+                             "value", "ANGLE_data", false);
+        mOut << "    return value;\n  }\n  static Value store(device uchar *ANGLE_data, Value "
+                "value) {\n";
+        emitStorageTransfers(*layout.type, layout.storage, layout.packing, layout.componentStride,
+                             "value", "ANGLE_data", true);
+        mOut << "    return value;\n  }\n";
+        const TType &type = *layout.type;
+        if (!type.isArray() && !type.getStruct() && type.getBasicType() != EbtBool)
+        {
+            mOut << "  static Value increment(device uchar *destination, bool post, bool "
+                    "decrement) {\n"
+                    "    Value old = load(destination);\n    Value value = old;\n";
+            const size_t columns = type.isMatrix() ? type.getCols() : 1;
+            const size_t rows    = type.isMatrix() ? type.getRows() : type.getNominalSize();
+            for (size_t column = 0; column < columns; ++column)
+            {
+                for (size_t row = 0; row < rows; ++row)
+                {
+                    const std::string element =
+                        "value" + (type.isMatrix()   ? "[" + std::to_string(column) + "][" +
+                                                           std::to_string(row) + "]"
+                                   : type.isVector() ? "[" + std::to_string(row) + "]"
+                                                     : "");
+                    mOut << "    " << element << " = ";
+                    if (type.getBasicType() == EbtInt)
+                    {
+                        mOut << "as_type<int>(as_type<uint>(" << element
+                             << ") + (decrement ? 0xffffffffu : 1u))";
+                    }
+                    else if (type.getBasicType() == EbtUInt)
+                    {
+                        mOut << element << " + (decrement ? 0xffffffffu : 1u)";
+                    }
+                    else
+                    {
+                        mOut << element << " + (decrement ? -1.0f : 1.0f)";
+                    }
+                    mOut << ";\n";
+                }
+            }
+            mOut << "    store(destination, value);\n    return post ? old : value;\n  }\n";
+        }
+        if (!type.isArray() && type.isVector())
+        {
+            TType physical(type.getBasicType() == EbtBool ? EbtUInt : type.getBasicType(), EbpHigh);
+            mOut << "  template<uint Count, uint A, uint B, uint C, uint D, typename T>\n"
+                    "  static T swizzleLoad(const device uchar *source) {\n"
+                    "    const uint indices[4] = {A,B,C,D};\n    T value{};\n"
+                    "    for(uint i=0u; i<Count; ++i) value[i] = (*reinterpret_cast<const device ";
+            emitType(physical, {});
+            mOut << " *>(source + indices[i] * " << layout.componentStride << "u))";
+            if (type.getBasicType() == EbtBool)
+            {
+                mOut << " != 0u";
+            }
+            mOut << ";\n    return value;\n  }\n"
+                    "  template<uint Count, uint A, uint B, uint C, uint D, typename T>\n"
+                    "  static T swizzleStore(device uchar *destination, T value) {\n"
+                    "    const uint indices[4] = {A,B,C,D};\n"
+                    "    for(uint i=0u; i<Count; ++i) (*reinterpret_cast<device ";
+            emitType(physical, {});
+            mOut << " *>(destination + indices[i] * " << layout.componentStride << "u)) = ";
+            emitType(physical, {});
+            mOut << "(value[i]);\n    return value;\n  }\n";
+            mOut << "  template<uint Count, uint A, uint B, uint C, uint D, typename T>\n"
+                    "  static T swizzleIncrement(device uchar *destination, bool post, bool "
+                    "decrement) {\n"
+                    "    T old = swizzleLoad<Count,A,B,C,D,T>(destination);\n    T value = old;\n"
+                    "    for(uint i=0u; i<Count; ++i) value[i] = ";
+            if (type.getBasicType() == EbtInt)
+            {
+                mOut << "as_type<int>(as_type<uint>(value[i]) + (decrement ? 0xffffffffu : 1u))";
+            }
+            else if (type.getBasicType() == EbtUInt)
+            {
+                mOut << "value[i] + (decrement ? 0xffffffffu : 1u)";
+            }
+            else
+            {
+                mOut << "value[i] + (decrement ? -1.0f : 1.0f)";
+            }
+            mOut << ";\n    swizzleStore<Count,A,B,C,D>(destination,value);\n"
+                    "    return post ? old : value;\n  }\n";
+        }
+        mOut << "};\n\n";
+    }
+    if (!mStorageLayouts.empty() && !mStorageArgumentEmitted)
+    {
+        mStorageArgumentEmitted = true;
+        mOut << R"(
+template <typename Layout>
+struct ANGLE_StorageAggregateArgument
+{
+    using Value = typename Layout::Value;
+    Value value;
+    device uchar *destination;
+    ANGLE_StorageAggregateArgument(device uchar *dest, bool copyIn) : value{}, destination(dest)
+    {
+        if (copyIn) value = Layout::load(dest);
+    }
+    ~ANGLE_StorageAggregateArgument() { Layout::store(destination, value); }
+    operator thread Value &() thread { return value; }
+};
+template <typename Layout, uint Count, uint A, uint B, uint C, uint D, typename T>
+struct ANGLE_StorageSwizzleArgument
+{
+    T value;
+    device uchar *destination;
+    ANGLE_StorageSwizzleArgument(device uchar *dest, bool copyIn) : value{}, destination(dest)
+    {
+        if (copyIn) value = Layout::template swizzleLoad<Count,A,B,C,D,T>(dest);
+    }
+    ~ANGLE_StorageSwizzleArgument() { Layout::template swizzleStore<Count,A,B,C,D>(destination,value); }
+    operator thread T &() thread { return value; }
+};
+)";
+    }
+}
