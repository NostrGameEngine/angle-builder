+bool GenMetalTraverser::needsStorageAggregate(const TType &type, const StorageBufferAccess &access)
+{
+    return type.isArray() || type.getStruct() || type.isMatrix() ||
+           (type.isVector() && access.componentStride != 4);
+}
+
+size_t GenMetalTraverser::storageAggregateLayout(const TType &type,
+                                                 const StorageBufferAccess &access)
+{
+    const std::string key = std::string(type.getMangledName()) + ":" +
+                            std::to_string(static_cast<int>(access.storage)) + ":" +
+                            std::to_string(static_cast<int>(access.packing)) + ":" +
+                            std::to_string(access.componentStride);
+    auto found            = mStorageLayoutIndices.find(key);
+    if (found != mStorageLayoutIndices.end())
+    {
+        return found->second;
+    }
+    const size_t index = mStorageLayouts.size();
+    mStorageLayouts.push_back({&type, access.storage, access.packing, access.componentStride});
+    mStorageLayoutIndices.emplace(key, index);
+    return index;
+}
+
+void GenMetalTraverser::emitStorageAddress(const StorageBufferAccess &access)
+{
+    mOut << "((";
+    groupedTraverse(*access.base);
+    mOut << ") + " << access.offset << "u";
+    for (const auto &index : access.indices)
+    {
+        mOut << " + size_t(";
+        groupedTraverse(*index.first);
+        mOut << ") * " << index.second << "u";
+    }
+    mOut << ")";
+}
+
+void GenMetalTraverser::emitStorageTransfers(const TType &type,
+                                             TLayoutBlockStorage storage,
+                                             TLayoutMatrixPacking packing,
+                                             size_t componentStride,
+                                             const std::string &value,
+                                             const std::string &address,
+                                             bool store)
+{
+    storage        = Overlay(storage, type);
+    packing        = Overlay(packing, type);
+    const auto add = [](const std::string &base, size_t offset) {
+        return "(" + base + " + " + std::to_string(offset) + "u)";
+    };
+    if (type.isArray())
+    {
+        TType element(type);
+        element.toArrayElementType();
+        const size_t stride     = StorageBufferArrayStride(type, storage, packing);
+        const std::string index = "ANGLE_i" + std::to_string(mStorageLoopIndex++);
+        mOut << "    for (uint " << index << " = 0u; " << index << " < "
+             << type.getOutermostArraySize() << "u; ++" << index << ") {\n";
+        emitStorageTransfers(
+            element, storage, packing, 4, value + "[" + index + "]",
+            "(" + address + " + size_t(" + index + ") * " + std::to_string(stride) + "u)", store);
+        mOut << "    }\n";
+    }
+    else if (const TStructure *structure = type.getStruct())
+    {
+        const auto &fields = structure->fields();
+        for (size_t i = 0; i < fields.size(); ++i)
+        {
+            TInfoSinkBase name;
+            Name(*fields[i]).emit(name, kUserVariableNamePrefix);
+            emitStorageTransfers(
+                *fields[i]->type(), storage, packing, 4, value + "." + name.c_str(),
+                add(address, StorageBufferFieldOffset(fields, i, storage, packing)), store);
+        }
+    }
+    else if (type.isMatrix())
+    {
+        const Layout layout = StorageBufferLayout(type, storage, packing);
+        const bool rowMajor = packing == EmpRowMajor;
+        const size_t stride = layout.sizeOf / (rowMajor ? type.getRows() : type.getCols());
+        const TType scalar(type.getBasicType(), EbpHigh);
+        for (size_t column = 0; column < type.getCols(); ++column)
+        {
+            for (size_t row = 0; row < type.getRows(); ++row)
+            {
+                emitStorageTransfers(
+                    scalar, storage, packing, 4,
+                    value + "[" + std::to_string(column) + "][" + std::to_string(row) + "]",
+                    add(address, rowMajor ? row * stride + column * 4 : column * stride + row * 4),
+                    store);
+            }
+        }
+    }
+    else if (type.isVector())
+    {
+        const TType scalar(type.getBasicType(), EbpHigh);
+        for (size_t i = 0; i < type.getNominalSize(); ++i)
+        {
+            emitStorageTransfers(scalar, storage, packing, 4, value + "[" + std::to_string(i) + "]",
+                                 add(address, i * componentStride), store);
+        }
+    }
+    else
+    {
+        TType physical(type.getBasicType() == EbtBool ? EbtUInt : type.getBasicType(), EbpHigh);
+        mOut << "    ";
+        if (!store)
+        {
+            mOut << value << " = ";
+        }
+        mOut << "(*reinterpret_cast<" << (store ? "device " : "const device ");
+        emitType(physical, {});
+        mOut << " *>(" << address << "))";
+        if (store)
+        {
+            mOut << " = ";
+            emitType(physical, {});
+            mOut << "(" << value << ")";
+        }
+        else if (type.getBasicType() == EbtBool)
+        {
+            mOut << " != 0u";
+        }
+        mOut << ";\n";
+    }
+}
