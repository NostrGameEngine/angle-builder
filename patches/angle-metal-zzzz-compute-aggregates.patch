+TEST_P(ComputeDispatchTestMetal, StorageAggregatesPreserveLayoutsAndPadding)
+{
+    const std::string prefix = R"(#version 310 es
+        layout(local_size_x = 1) in;
+        struct Record { vec3 direction; float weight; bool flag; mat2 matrix; };
+        layout(std430, row_major, binding = 0) readonly buffer InputData {
+            Record records[2]; float values[3]; mat2x3 matrix;
+        } inputData;
+        layout(std140, )";
+    const std::string suffix = R"(, binding = 1) buffer OutputData {
+            Record records[2]; float values[3]; mat2x3 matrix;
+        } outputData;
+        void copyValues(in float source[3], out float destination[3]) {
+            destination = source;
+        }
+        void tweak(inout Record value) {
+            value.direction += vec3(10,20,30); value.weight += 2.0;
+            value.flag = !value.flag; value.matrix += mat2(1);
+            value.matrix[0][1] += 3.0;
+        }
+        void twice(inout mat2 value) { value *= 2.0; }
+        void fillColumn(out vec3 value) { value = vec3(41,42,43); }
+        void addColumn(inout vec3 value) { value += vec3(1,2,3); }
+        void fillPair(out vec2 value) { value = vec2(70,80); }
+        void bumpPair(inout vec2 value) { value += vec2(4,5); }
+        void main() {
+            outputData.records = inputData.records;
+            Record value = inputData.records[1];
+            outputData.records[0] = value;
+            outputData.records[1] = inputData.records[0];
+            tweak(outputData.records[0]);
+            twice(outputData.records[1].matrix);
+            ++outputData.records[1].matrix;
+            mat2 before = outputData.records[1].matrix--;
+            copyValues(inputData.values, outputData.values);
+            outputData.values[0] = before[0][0];
+            outputData.matrix = inputData.matrix;
+            fillColumn(outputData.matrix[1]); addColumn(outputData.matrix[1]);
+            outputData.matrix[0] += vec3(1);
+            vec3 old = outputData.matrix[0]++;
+            outputData.values[1] = old.z;
+            outputData.matrix[0].yx = vec2(50,60);
+            outputData.matrix[0].xz += vec2(2,3);
+            fillPair(outputData.matrix[0].zy);
+            bumpPair(outputData.matrix[0].xz);
+            vec2 previous = outputData.matrix[0].zx++;
+            --outputData.matrix[0].yz;
+            outputData.values[2] = previous.x + previous.y;
+        }
+    )";
+    for (bool rowMajor : {false, true})
+    {
+        const std::string shader = prefix + (rowMajor ? "row_major" : "column_major") + suffix;
+        ANGLE_GL_COMPUTE_PROGRAM(program, shader.c_str());
+        GLBuffer allocation;
+        std::array<uint32_t, 1024> expected;
+        expected.fill(0xcdcdcdcdu);
+        const auto put = [&expected](size_t bytes, float value) {
+            std::memcpy(&expected[bytes / 4], &value, sizeof(value));
+        };
+        for (size_t i = 0; i < 2; ++i)
+        {
+            const size_t record = 256 + i * 48;
+            for (size_t j = 0; j < 3; ++j)
+            {
+                put(record + j * 4, static_cast<float>(i * 10 + 1 + j));
+            }
+            put(record + 12, static_cast<float>(i * 10 + 4));
+            expected[(record + 16) / 4] = i == 0 ? 0xffffffffu : 0u;
+            for (size_t c = 0; c < 2; ++c)
+            {
+                for (size_t r = 0; r < 2; ++r)
+                {
+                    put(record + 24 + r * 8 + c * 4, static_cast<float>(i * 10 + 5 + c * 2 + r));
+                }
+            }
+        }
+        for (size_t i = 0; i < 3; ++i)
+        {
+            put(256 + 96 + i * 4, static_cast<float>(19 + i * 4 + (i == 2 ? 2 : 0)));
+        }
+        for (size_t c = 0; c < 2; ++c)
+        {
+            for (size_t r = 0; r < 3; ++r)
+            {
+                put(256 + 112 + r * 8 + c * 4, static_cast<float>(31 + c * 3 + r));
+            }
+        }
+        glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+        glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(expected), expected.data(), GL_DYNAMIC_DRAW);
+        glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 0, allocation, 256, 256);
+        glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 1, allocation, 1024, 256);
+        GLProgram restored;
+        reloadProgram(program, restored);
+        glUseProgram(restored);
+        glDispatchCompute(1, 1, 1);
+        glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+        ASSERT_GL_NO_ERROR();
+        const std::array<std::array<float, 3>, 2> directions = {{{21, 32, 43}, {1, 2, 3}}};
+        const std::array<float, 2> weights                   = {16, 4};
+        const std::array<std::array<float, 4>, 2> matrices = {{{16, 19, 17, 19}, {10, 12, 14, 16}}};
+        for (size_t i = 0; i < 2; ++i)
+        {
+            const size_t record = 1024 + i * 64;
+            for (size_t j = 0; j < 3; ++j)
+            {
+                put(record + j * 4, directions[i][j]);
+            }
+            put(record + 12, weights[i]);
+            expected[(record + 16) / 4] = 1;
+            for (size_t c = 0; c < 2; ++c)
+            {
+                for (size_t r = 0; r < 2; ++r)
+                {
+                    put(record + 32 + (rowMajor ? r * 16 + c * 4 : c * 16 + r * 4),
+                        matrices[i][c * 2 + r]);
+                }
+            }
+        }
+        put(1024 + 128, 11);
+        put(1024 + 144, 34);
+        put(1024 + 160, 141);
+        const std::array<std::array<float, 3>, 2> matrix = {{{67, 79, 75}, {42, 44, 46}}};
+        for (size_t c = 0; c < 2; ++c)
+        {
+            for (size_t r = 0; r < 3; ++r)
+            {
+                put(1024 + 176 + (rowMajor ? r * 16 + c * 4 : c * 16 + r * 4), matrix[c][r]);
+            }
+        }
+        const auto *actual = static_cast<const uint32_t *>(
+            glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+        ASSERT_NE(actual, nullptr);
+        for (size_t i = 0; i < expected.size(); ++i)
+        {
+            EXPECT_EQ(actual[i], expected[i]) << "row_major=" << rowMajor << ", word=" << i;
+        }
+        EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+        ASSERT_GL_NO_ERROR();
+    }
+}
