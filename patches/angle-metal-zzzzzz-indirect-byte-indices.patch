+angle::Result VertexArrayMtl::getIndexBufferForIndirect(const gl::Context *context,
+                                                        gl::DrawElementsType type,
+                                                        mtl::BufferSlice *bufferOut,
+                                                        gl::DrawElementsType *typeOut)
+{
+    *typeOut = type;
+    if (type == gl::DrawElementsType::UnsignedByte)
+    {
+        *typeOut = gl::DrawElementsType::UnsignedShort;
+        return convertIndexBuffer(context, type, 0, bufferOut, true);
+    }
+    *bufferOut = mtl::BufferSlice(mtl::GetImpl(getElementArrayBuffer())->getCurrentBuffer());
+    return angle::Result::Continue;
+}
