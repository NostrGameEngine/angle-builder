diff --git a/src/tests/gl_tests/ComputeDispatchTestMetal.cpp b/src/tests/gl_tests/ComputeDispatchTestMetal.cpp
index 005f099..13ecf7c 100644
--- a/src/tests/gl_tests/ComputeDispatchTestMetal.cpp
+++ b/src/tests/gl_tests/ComputeDispatchTestMetal.cpp
@@ -1219,6 +1219,116 @@ TEST_P(ComputeDispatchTestMetal, ZeroDispatchAndFrontendValidation)
     EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
     ASSERT_GL_NO_ERROR();
 }
+class ComputeByteIndirectTestMetal : public ComputeDispatchTestMetal
+{};
+
+TEST_P(ComputeByteIndirectTestMetal, GPUGeneratedIndicesAndTightMultiDraw)
+{
+    constexpr char producer[] = R"(#version 310 es
+        layout(local_size_x = 1) in;
+        layout(std430, binding = 0) buffer Commands { uint words[]; } commands;
+        layout(std430, binding = 1) buffer Indices { uint words[]; } indices;
+        uniform bool visible;
+        uniform bool split;
+        uniform uint second;
+        void main() {
+            // Two guard bytes precede the six indices. baseVertex is -1.
+            indices.words[0] = visible ? 0x0201fbfau : 0x0101fbfau;
+            indices.words[1] = visible ? 0x04020303u : 0x01010101u;
+            commands.words[64] = split ? 3u : 6u;
+            commands.words[65] = 1u;
+            commands.words[66] = 2u;
+            commands.words[67] = 0xffffffffu;
+            commands.words[68] = 0u;
+            commands.words[second] = 3u;
+            commands.words[second + 1u] = 1u;
+            commands.words[second + 2u] = 5u;
+            commands.words[second + 3u] = 0xffffffffu;
+            commands.words[second + 4u] = 0u;
+        }
+    )";
+    constexpr char vertex[]   = R"(#version 310 es
+        void main() {
+            vec2 p = vec2((gl_VertexID & 1) == 0 ? -1 : 1,
+                          (gl_VertexID & 2) == 0 ? -1 : 1);
+            gl_Position = vec4(p, 0, 1);
+        }
+    )";
+    constexpr char fragment[] = R"(#version 310 es
+        precision highp float;
+        uniform vec4 paint;
+        out vec4 color;
+        void main() { color = paint; }
+    )";
+    ASSERT_TRUE(EnsureGLExtensionEnabled("GL_EXT_multi_draw_indirect"));
+    ANGLE_GL_COMPUTE_PROGRAM(compute, producer);
+    ANGLE_GL_PROGRAM(render, vertex, fragment);
+    GLVertexArray vao;
+    glBindVertexArray(vao);
+    GLBuffer commands, indices;
+    std::array<uint32_t, 128> initial;
+    initial.fill(0xcdcdcdcdu);
+    glBindBuffer(GL_DRAW_INDIRECT_BUFFER, commands);
+    glBufferData(GL_DRAW_INDIRECT_BUFFER, sizeof(initial), initial.data(), GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, commands);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, indices);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeof(initial), initial.data(), GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 1, indices);
+    for (uint32_t frame = 0; frame < 6; ++frame)
+    {
+        const bool visible     = (frame & 1) == 0;
+        const uint32_t variant = frame % 3;
+        glClearColor(0, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glUseProgram(compute);
+        glUniform1i(glGetUniformLocation(compute, "visible"), visible);
+        glUniform1i(glGetUniformLocation(compute, "split"), variant != 0);
+        glUniform1ui(glGetUniformLocation(compute, "second"), variant == 1 ? 69 : 72);
+        glDispatchCompute(1, 1, 1);
+        glMemoryBarrier(GL_COMMAND_BARRIER_BIT | GL_ELEMENT_ARRAY_BARRIER_BIT);
+        glUseProgram(render);
+        // Start a raster pass immediately before conversion. Its attachment
+        // contents must survive even when the indirect geometry is degenerate.
+        glUniform4f(glGetUniformLocation(render, "paint"), 1, 0, 0, 1);
+        glEnable(GL_SCISSOR_TEST);
+        glScissor(0, 0, 1, 1);
+        glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+        glDisable(GL_SCISSOR_TEST);
+        glUniform4f(glGetUniformLocation(render, "paint"), 0, 1, 0, 1);
+        const void *offset = reinterpret_cast<const void *>(256);
+        if (variant == 0)
+        {
+            glDrawElementsIndirect(GL_TRIANGLES, GL_UNSIGNED_BYTE, offset);
+        }
+        else
+        {
+            glMultiDrawElementsIndirectEXT(GL_TRIANGLES, GL_UNSIGNED_BYTE, offset, 2,
+                                           variant == 1 ? 0 : 32);
+        }
+        ASSERT_GL_NO_ERROR();
+        EXPECT_PIXEL_RECT_EQ(1, 1, 15, 15, visible ? GLColor::green : GLColor::black);
+        EXPECT_PIXEL_COLOR_EQ(0, 0, visible ? GLColor::green : GLColor::red);
+    }
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, indices);
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(initial), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    EXPECT_EQ(actual[0], 0x0101fbfau);
+    EXPECT_EQ(actual[1], 0x01010101u);
+    for (size_t i = 2; i < initial.size(); ++i)
+    {
+        EXPECT_EQ(actual[i], initial[i]) << i;
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
+
 }  // namespace
 ANGLE_INSTANTIATE_TEST(ComputeDispatchTestMetal,
                        ES31_METAL().enable(Feature::AlwaysEnableEmulatedMultidrawExtensions));
+
+ANGLE_INSTANTIATE_TEST(ComputeByteIndirectTestMetal,
+                       ES31_METAL()
+                           .enable(Feature::AlwaysEnableEmulatedMultidrawExtensions)
+                           .disable(Feature::HasCheapRenderPass));
