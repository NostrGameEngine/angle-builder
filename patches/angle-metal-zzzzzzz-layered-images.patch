+    glBindImageTexture(1, volume, 0, GL_TRUE, 0, GL_READ_WRITE, GL_R32UI);
+    glBindImageTexture(2, layers, 0, GL_TRUE, 0, GL_READ_WRITE, GL_R32UI);
