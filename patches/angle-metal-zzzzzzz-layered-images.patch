+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                               GL_TEXTURE_CUBE_MAP_POSITIVE_X + f, cube, 0);
+        check();
+    }
+    ASSERT_GL_NO_ERROR();
+}
