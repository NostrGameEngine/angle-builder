+    glTexStorage3D(GL_TEXTURE_2D_ARRAY, 1, GL_R32UI, 2, 2, 2);
+    glTexSubImage3D(GL_TEXTURE_2D_ARRAY, 0, 0, 0, 0, 2, 2, 2, GL_RED_INTEGER, GL_UNSIGNED_INT,
+                    initial.data());
