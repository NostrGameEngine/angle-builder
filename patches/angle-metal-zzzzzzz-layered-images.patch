+TEST_P(ComputeDispatchTestMetal, LayeredImagesMipViewsAndCubeAliases)
+{
+    constexpr char producer[] = R"(#version 310 es
+        layout(local_size_x = 2, local_size_y = 2) in;
+        layout(r32ui, binding = 0) uniform highp uimage3D volume;
+        layout(r32i, binding = 1) uniform highp iimage2DArray layers;
+        layout(rgba32ui, binding = 2) writeonly uniform highp uimageCube faces;
+        layout(std430, binding = 0) buffer Results {
+            uvec4 sizes[3]; uvec4 observed[24];
+        } result;
+        void main() {
+            ivec3 p = ivec3(gl_GlobalInvocationID);
+            uint i = uint((p.z * 2 + p.y) * 2 + p.x);
+            if (p.z < 2) {
+                imageStore(volume, p, uvec4(1000u + i));
+                memoryBarrierImage();
+                result.observed[i] = imageLoad(volume, p);
+            }
+            if (p.z < 3) imageStore(layers, p, ivec4(-2000 - int(i)));
+            imageStore(faces, p, uvec4(3000,4000,5000,6000) + i);
+            if (all(equal(p, ivec3(0)))) {
+                result.sizes[0] = uvec4(imageSize(volume), 0);
+                result.sizes[1] = uvec4(imageSize(layers), 0);
+                result.sizes[2] = uvec4(imageSize(faces), 0, 0);
+            }
+        }
+    )";
+    constexpr char alias[]    = R"(#version 310 es
+        layout(local_size_x = 1) in;
+        layout(rgba32ui, binding = 0) writeonly uniform highp uimage2D face;
+        void main() {
+            if (imageSize(face) == ivec2(2)) imageStore(face, ivec2(1,0), uvec4(9001,9002,9003,9004));
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(program, producer);
+    ANGLE_GL_COMPUTE_PROGRAM(aliasProgram, alias);
+    GLTexture volume, layers, cube;
+    glBindTexture(GL_TEXTURE_3D, volume);
+    glTexStorage3D(GL_TEXTURE_3D, 2, GL_R32UI, 4, 4, 4);
+    std::array<uint32_t, 64> volumeGuard;
+    volumeGuard.fill(0x55555555u);
+    glTexSubImage3D(GL_TEXTURE_3D, 0, 0, 0, 0, 4, 4, 4, GL_RED_INTEGER, GL_UNSIGNED_INT,
+                    volumeGuard.data());
+    glBindTexture(GL_TEXTURE_2D_ARRAY, layers);
+    glTexStorage3D(GL_TEXTURE_2D_ARRAY, 2, GL_R32I, 4, 4, 3);
+    std::array<int32_t, 48> layerGuard;
+    layerGuard.fill(-321);
+    glTexSubImage3D(GL_TEXTURE_2D_ARRAY, 0, 0, 0, 0, 4, 4, 3, GL_RED_INTEGER, GL_INT,
+                    layerGuard.data());
+    glBindTexture(GL_TEXTURE_CUBE_MAP, cube);
+    glTexStorage2D(GL_TEXTURE_CUBE_MAP, 2, GL_RGBA32UI, 4, 4);
+    std::array<uint32_t, 64> cubeGuard;
+    cubeGuard.fill(777);
+    for (uint32_t face = 0; face < 6; ++face)
+    {
+        glTexSubImage2D(GL_TEXTURE_CUBE_MAP_POSITIVE_X + face, 0, 0, 0, 4, 4, GL_RGBA_INTEGER,
+                        GL_UNSIGNED_INT, cubeGuard.data());
+    }
+    glBindImageTexture(0, volume, 1, GL_TRUE, 0, GL_READ_WRITE, GL_R32UI);
+    glBindImageTexture(1, layers, 1, GL_TRUE, 0, GL_READ_WRITE, GL_R32I);
+    glBindImageTexture(2, cube, 1, GL_TRUE, 0, GL_WRITE_ONLY, GL_RGBA32UI);
+    ASSERT_GL_NO_ERROR();
+    GLBuffer buffer;
+    std::array<uint32_t, 128> expected;
+    expected.fill(0xcdcdcdcdu);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, buffer);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(expected), expected.data(), GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, buffer);
+    GLProgram restored;
+    reloadProgram(program, restored);
+    glUseProgram(restored);
+    glDispatchCompute(1, 1, 6);
+    glMemoryBarrier(GL_FRAMEBUFFER_BARRIER_BIT | GL_BUFFER_UPDATE_BARRIER_BIT |
+                    GL_SHADER_IMAGE_ACCESS_BARRIER_BIT);
+    ASSERT_GL_NO_ERROR();
+    const std::array<uint32_t, 12> sizes = {2, 2, 2, 0, 2, 2, 3, 0, 2, 2, 0, 0};
+    std::copy(sizes.begin(), sizes.end(), expected.begin());
+    for (uint32_t i = 0; i < 8; ++i)
+    {
+        expected[12 + 4 * i]     = 1000 + i;
+        expected[12 + 4 * i + 1] = expected[12 + 4 * i + 2] = 0;
+        expected[12 + 4 * i + 3]                            = 1;
+    }
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (size_t i = 0; i < expected.size(); ++i)
+    {
+        EXPECT_EQ(actual[i], expected[i]) << i;
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    GLFramebuffer framebuffer;
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    for (uint32_t layer = 0; layer < 2; ++layer)
+    {
+        glFramebufferTextureLayer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, volume, 1, layer);
+        ASSERT_GLENUM_EQ(glCheckFramebufferStatus(GL_FRAMEBUFFER), GL_FRAMEBUFFER_COMPLETE);
+        std::array<uint32_t, 16> pixels;
+        glReadPixels(0, 0, 2, 2, GL_RGBA_INTEGER, GL_UNSIGNED_INT, pixels.data());
+        for (uint32_t p = 0; p < 4; ++p)
+        {
+            for (uint32_t c = 0; c < 4; ++c)
+            {
+                EXPECT_EQ(pixels[4 * p + c], c == 0 ? 1000 + 4 * layer + p : c == 3 ? 1 : 0);
+            }
+        }
+    }
+    for (uint32_t layer = 0; layer < 3; ++layer)
+    {
+        glFramebufferTextureLayer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, layers, 1, layer);
+        ASSERT_GLENUM_EQ(glCheckFramebufferStatus(GL_FRAMEBUFFER), GL_FRAMEBUFFER_COMPLETE);
+        std::array<int32_t, 16> pixels;
+        glReadPixels(0, 0, 2, 2, GL_RGBA_INTEGER, GL_INT, pixels.data());
+        for (uint32_t p = 0; p < 4; ++p)
+        {
+            for (uint32_t c = 0; c < 4; ++c)
+            {
+                EXPECT_EQ(pixels[4 * p + c], c == 0   ? -2000 - static_cast<int32_t>(4 * layer + p)
+                                             : c == 3 ? 1
+                                                      : 0);
+            }
+        }
+    }
+    // A face view shares the cube allocation; changing one texel must retain
