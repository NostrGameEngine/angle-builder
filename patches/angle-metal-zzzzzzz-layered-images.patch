+    ANGLE_GL_COMPUTE_PROGRAM(program, source);
+    GLTexture planar, volume, layers, cube;
+    std::array<uint32_t, 8> initial;
+    initial.fill(777);
+    glBindTexture(GL_TEXTURE_2D, planar);
+    glTexStorage2D(GL_TEXTURE_2D, 1, GL_R32UI, 2, 2);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 2, 2, GL_RED_INTEGER, GL_UNSIGNED_INT, initial.data());
+    glBindTexture(GL_TEXTURE_3D, volume);
+    glTexStorage3D(GL_TEXTURE_3D, 1, GL_R32UI, 2, 2, 2);
+    glTexSubImage3D(GL_TEXTURE_3D, 0, 0, 0, 0, 2, 2, 2, GL_RED_INTEGER, GL_UNSIGNED_INT,
+                    initial.data());
