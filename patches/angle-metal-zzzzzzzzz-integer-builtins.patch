+PROGRAM_PRELUDE_DECLARE(integerBuiltins, R"(
+template <typename T>
+struct ANGLE_IntegerOutType { using type = T; };
+
+template <typename T>
+ANGLE_ALWAYS_INLINE T ANGLE_bitfieldExtract(T value, int offset, int bits)
+{
+    if (bits <= 0) return T(0);
+    if (bits >= 32) return value;
+    using U = metal::make_unsigned_t<T>;
+    using I = metal::make_signed_t<T>;
+    const uint off = uint(offset) & 31u;
+    const U mask = U(0xffffffffu >> (32u - uint(bits)));
+    const U extracted = (U(value) >> off) & mask;
+    const I extended = as_type<I>(U(value) << ((32u - off - uint(bits)) & 31u)) >> (32u - uint(bits));
+    return metal::select(as_type<T>(extracted), as_type<T>(U(extended)), T(-1) < T(0));
+}
+
+template <typename T>
+ANGLE_ALWAYS_INLINE T ANGLE_bitfieldInsert(T base, T insert, int offset, int bits)
+{
+    if (bits <= 0) return base;
+    if (bits >= 32) return insert;
+    using U = metal::make_unsigned_t<T>;
+    const uint off = uint(offset) & 31u;
+    const U mask = U(0xffffffffu >> (32u - uint(bits))) << off;
+    return as_type<T>((U(base) & ~mask) | ((U(insert) << off) & mask));
+}
+
+template <typename T>
+ANGLE_ALWAYS_INLINE T ANGLE_bitfieldReverse(T value)
+{
+    using U = metal::make_unsigned_t<T>;
+    return as_type<T>(metal::reverse_bits(U(value)));
+}
+
+template <typename T>
+ANGLE_ALWAYS_INLINE metal::make_signed_t<T> ANGLE_bitCount(T value)
+{
+    using U = metal::make_unsigned_t<T>;
+    using I = metal::make_signed_t<T>;
+    return I(metal::popcount(U(value)));
+}
+
+template <typename T>
+ANGLE_ALWAYS_INLINE metal::make_signed_t<T> ANGLE_findLSB(T value)
+{
+    using U = metal::make_unsigned_t<T>;
+    using I = metal::make_signed_t<T>;
+    const U bits = U(value);
+    const U safe = metal::select(bits, U(1), bits == U(0));
+    return metal::select(I(metal::ctz(safe)), I(-1), bits == U(0));
+}
+
+template <typename T>
+ANGLE_ALWAYS_INLINE metal::make_signed_t<T> ANGLE_findMSB(T value)
+{
+    using U = metal::make_unsigned_t<T>;
+    using I = metal::make_signed_t<T>;
+    const U bits = metal::select(U(value), ~U(value), value < T(0));
+    const U safe = metal::select(bits, U(1), bits == U(0));
+    return metal::select(I(31) - I(metal::clz(safe)), I(-1), bits == U(0));
+}
+
+template <typename T>
+ANGLE_ALWAYS_INLINE T ANGLE_uaddCarry(T x, T y, thread typename ANGLE_IntegerOutType<T>::type &carry)
+{
+    const T sum = x + y;
+    carry = T(sum < x);
+    return sum;
+}
+
+template <typename T>
+ANGLE_ALWAYS_INLINE T ANGLE_usubBorrow(T x, T y, thread typename ANGLE_IntegerOutType<T>::type &borrow)
+{
+    const T difference = x - y;
+    borrow = T(x < y);
+    return difference;
+}
+
+template <typename T>
+ANGLE_ALWAYS_INLINE void ANGLE_umulExtended(T x, T y,
+    thread typename ANGLE_IntegerOutType<T>::type &msb,
+    thread typename ANGLE_IntegerOutType<T>::type &lsb)
+{
+    const T high = metal::mulhi(x, y);
+    const T low = x * y;
+    msb = high;
+    lsb = low;
+}
+
+template <typename T>
+ANGLE_ALWAYS_INLINE void ANGLE_imulExtended(T x, T y,
+    thread typename ANGLE_IntegerOutType<T>::type &msb,
+    thread typename ANGLE_IntegerOutType<T>::type &lsb)
+{
+    using U = metal::make_unsigned_t<T>;
+    const T high = metal::mulhi(x, y);
+    const T low = as_type<T>(U(x) * U(y));
+    msb = high;
+    lsb = low;
+}
+)")
