+angle::Result ProgramExecutableMtl::initializeComputePipelineForLink(mtl::Context *context,
+                                                                     gl::InfoLog &infoLog)
+{
+    ANGLE_MTL_OBJC_SCOPE
+    {
+        const auto &info = getComputeShaderInfo();
+        auto function = angle::adoptObjCPtr([info.metalLibrary.get() newFunctionWithName:@"main0"]);
+        if (!function)
+        {
+            infoLog << "Metal compute entry point is missing.";
+            return angle::Result::Stop;
+        }
+        id<MTLDevice> device = context->getDisplay()->getMetalDevice();
+        NSError *error       = nil;
+        auto pipeline =
+            angle::adoptObjCPtr([device newComputePipelineStateWithFunction:function.get()
+                                                                      error:&error]);
+        if (!pipeline || error)
+        {
+            infoLog << "Metal compute pipeline creation failed: "
+                    << (error ? error.localizedDescription.UTF8String : "unknown error");
+            return angle::Result::Stop;
+        }
+        const auto &size         = mExecutable->getComputeShaderLocalSize();
+        const size_t invocations = size_t(size[0]) * size_t(size[1]) * size_t(size[2]);
+        if (invocations > pipeline.get().maxTotalThreadsPerThreadgroup)
+        {
+            infoLog << "Compute local size exceeds the Metal pipeline's threadgroup limit.";
+            return angle::Result::Stop;
+        }
+        if (pipeline.get().staticThreadgroupMemoryLength > device.maxThreadgroupMemoryLength)
+        {
+            infoLog << "Compute static threadgroup memory exceeds the Metal device limit.";
+            return angle::Result::Stop;
+        }
+        mComputeFunction = std::move(function);
+        mComputePipeline = std::move(pipeline);
+        return angle::Result::Continue;
+    }
+}
+
 angle::Result ProgramExecutableMtl::getComputePipeline(
     ContextMtl *context,
     angle::ObjCPtr<id<MTLComputePipelineState>> *pipelineOut)
@@ -944,6 +985,13 @@ void ReadFromDefaultUniformBlockWithElementSize(int componentCount,
         ANGLE_TRY(context->getPipelineCache().getComputePipeline(context, mComputeFunction.get(),
                                                                  &mComputePipeline));
     }
+    else
+    {
+        // Publish the linked state into this context's normal pipeline cache.
+        // Linking may run on a worker and must not touch that cache there.
+        ANGLE_TRY(context->getPipelineCache().getComputePipeline(
+            context, mComputeFunction.get(), &mComputePipeline, mComputePipeline.get()));
+    }
     *pipelineOut = mComputePipeline;
     return angle::Result::Continue;
 }
