+class ComputeLinkValidationTestMetal : public ComputeDispatchTestMetal
+{};
+
+TEST_P(ComputeLinkValidationTestMetal, RejectOversizedNativeSharedMemoryAtLink)
+{
+    GLint sharedLimit = 0;
+    glGetIntegerv(GL_MAX_COMPUTE_SHARED_MEMORY_SIZE, &sharedLimit);
+    ASSERT_GE(sharedLimit, 16384);
+    // std430 counts this record as 16 bytes. Native Metal float3 tail padding
+    // makes it 32 bytes, exceeding the physical limit only after translation.
+    const std::string source =
+        "#version 310 es\n#define COUNT " + std::to_string(sharedLimit / 32 + 1) + R"(
+        layout(local_size_x=128) in;
+        struct SharedValue { vec3 v; float f; };
+        shared SharedValue scratch[COUNT];
+        layout(std430,binding=0) readonly buffer InputData { vec4 values[COUNT]; } inputData;
+        layout(std430,binding=1) buffer Results { float values[128]; } result;
+        void main() {
+            uint i=gl_LocalInvocationIndex;
+            for (uint j=i;j<uint(COUNT);j+=128u) {
+                scratch[j].v=inputData.values[j].xyz;
+                scratch[j].f=inputData.values[j].w;
+            }
+            barrier();
+            float sum=0.0;
+            for (uint j=i;j<uint(COUNT);j+=128u) {
+                SharedValue v=scratch[(j+1u)%uint(COUNT)];
+                sum+=dot(v.v,vec3(1.0))+v.f;
+            }
+            result.values[i]=sum;
+        }
+    )";
+    GLShader shader(GL_COMPUTE_SHADER);
+    const char *text = source.c_str();
+    glShaderSource(shader, 1, &text, nullptr);
+    glCompileShader(shader);
+    GLint compiled = GL_FALSE;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &compiled);
+    ASSERT_EQ(compiled, GL_TRUE);
+    GLProgram program;
+    glAttachShader(program, shader);
+    glLinkProgram(program);
+    GLint linked = GL_TRUE;
+    glGetProgramiv(program, GL_LINK_STATUS, &linked);
+    EXPECT_EQ(linked, GL_FALSE);
+    GLint length = 0;
+    glGetProgramiv(program, GL_INFO_LOG_LENGTH, &length);
+    ASSERT_GT(length, 1);
+    std::vector<char> bytes(length);
+    glGetProgramInfoLog(program, length, nullptr, bytes.data());
+    const std::string log(bytes.data());
+    EXPECT_TRUE(log.find("threadgroup") != std::string::npos ||
+                log.find("shared") != std::string::npos)
+        << log;
+    ASSERT_GL_NO_ERROR();
+}
+
+TEST_P(ComputeLinkValidationTestMetal, BinaryCacheAndProgramDeletionBeforeReadback)
+{
+    constexpr char source[] = R"(#version 310 es
+        layout(local_size_x=4) in;
+        layout(std430,binding=0) buffer Results { uvec4 values[4]; } result;
+        shared uvec4 scratch[4];
+        uniform highp uvec4 payload[301];
+        void main() {
+            uint i=gl_LocalInvocationIndex;
+            uvec4 sum=uvec4(0);
+            for (uint j=0u;j<301u;++j) sum+=payload[j]*(j+1u);
+            scratch[i]=sum+i;
+            barrier();
+            result.values[i]=scratch[3u-i];
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(program, source);
+    GLProgram restored;
+    reloadProgram(program, restored);
+    GLBuffer result;
+    std::array<uint32_t, 128> expected;
+    expected.fill(0xcdcdcdcdu);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, result);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(expected), expected.data(), GL_DYNAMIC_DRAW);
+    glUseProgram(restored);
+    for (uint32_t pass = 0; pass < 2; ++pass)
+    {
+        // 4816 bytes exceeds inline constants and deliberately does not have
+        // a 32-byte size. Consecutive pool uploads must remain independent.
+        std::array<uint32_t, 301 * 4> payload;
+        std::array<uint32_t, 4> sums = {};
+        for (uint32_t j = 0; j < 301; ++j)
+        {
+            for (uint32_t lane = 0; lane < 4; ++lane)
+            {
+                const uint32_t value  = 0x10203040u + pass * 31u + j * 12345u + lane * 3u;
+                payload[4 * j + lane] = value;
+                sums[lane] += value * (j + 1u);
+            }
+        }
+        glUniform4uiv(glGetUniformLocation(restored, "payload[0]"), 301, payload.data());
+        glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 0, result, pass * 256, 64);
+        glDispatchCompute(1, 1, 1);
+        for (uint32_t i = 0; i < 4; ++i)
+        {
+            for (uint32_t lane = 0; lane < 4; ++lane)
+            {
+                expected[pass * 64 + 4 * i + lane] = sums[lane] + 3u - i;
+            }
+        }
+    }
+    glUseProgram(0);
+    restored.reset();
+    program.reset();
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    ASSERT_GL_NO_ERROR();
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (size_t i = 0; i < expected.size(); ++i)
+    {
+        EXPECT_EQ(actual[i], expected[i]) << i;
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
