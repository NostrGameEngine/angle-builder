+// Compute pipelines use the component program's executable so uniforms,
+// resource binding changes and executable lifetime keep their original owner.
+class ProgramPipelineMtl final : public ProgramPipelineImpl
+{
+  public:
+    explicit ProgramPipelineMtl(const gl::ProgramPipelineState &state) : ProgramPipelineImpl(state)
+    {}
+
+    angle::Result link(const gl::Context *context,
+                       const gl::ProgramMergedVaryings &,
+                       const gl::ProgramVaryingPacking &) override
+    {
+        bool computeOnly = bool(mState.getShaderProgramExecutable(gl::ShaderType::Compute));
+        for (gl::ShaderType type : mState.getExecutable().getLinkedShaderStages())
+        {
+            computeOnly = computeOnly && type == gl::ShaderType::Compute;
+        }
+        ANGLE_CHECK(mtl::GetImpl(context), computeOnly,
+                    "Metal separable pipelines currently require a compute stage only",
+                    GL_INVALID_OPERATION);
+        return angle::Result::Continue;
+    }
+};
+
+const gl::ProgramExecutable *GetComputeProgramExecutable(const gl::State &state)
+{
+    if (!state.getProgram() && state.getProgramPipeline())
+    {
+        const auto &component =
+            state.getProgramPipeline()->getShaderProgramExecutable(gl::ShaderType::Compute);
+        if (component)
+        {
+            return component.get();
+        }
+    }
+    return state.getProgramExecutable();
+}
