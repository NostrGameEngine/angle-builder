+TEST_P(ComputeLinkValidationTestMetal, SeparableComputeUniformOwnershipAndBinary)
+{
+    constexpr char source[] = R"(#version 310 es
+        layout(local_size_x=4) in;
+        layout(std430,binding=5) buffer OutputData { uvec4 values[4]; } result;
+        uniform uint seed;
+        void main() {
+            uint i=gl_LocalInvocationIndex;
+            result.values[i]=uvec4(seed+i,seed,0,1);
+        }
+    )";
+    GLShader shader(GL_COMPUTE_SHADER);
+    const char *text = source;
+    glShaderSource(shader, 1, &text, nullptr);
+    glCompileShader(shader);
+    GLint compiled = GL_FALSE;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &compiled);
+    ASSERT_EQ(compiled, GL_TRUE);
+    GLProgram program;
+    glProgramParameteri(program, GL_PROGRAM_SEPARABLE, GL_TRUE);
+    glAttachShader(program, shader);
+    glLinkProgram(program);
+    GLint linked = GL_FALSE;
+    glGetProgramiv(program, GL_LINK_STATUS, &linked);
+    ASSERT_EQ(linked, GL_TRUE);
+    GLProgramPipeline pipeline;
+    glUseProgram(0);
+    glBindProgramPipeline(pipeline);
+    glUseProgramStages(pipeline, GL_COMPUTE_SHADER_BIT, program);
+    glActiveShaderProgram(pipeline, program);
+    GLBuffer result, commands;
+    std::array<uint32_t, 192> expected;
+    expected.fill(0xcdcdcdcdu);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, result);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(expected), expected.data(), GL_DYNAMIC_DRAW);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 5, result, 0, 64);
+    GLuint block = glGetProgramResourceIndex(program, GL_SHADER_STORAGE_BLOCK, "OutputData");
+    ASSERT_NE(block, GL_INVALID_INDEX);
+    const GLenum property = GL_BUFFER_BINDING;
+    GLint binding         = -1;
+    glGetProgramResourceiv(program, GL_SHADER_STORAGE_BLOCK, block, 1, &property, 1, nullptr,
+                           &binding);
+    ASSERT_EQ(binding, 5);
+    glUniform1ui(glGetUniformLocation(program, "seed"), 29);
+    glValidateProgramPipeline(pipeline);
+    GLint valid = GL_FALSE;
+    glGetProgramPipelineiv(pipeline, GL_VALIDATE_STATUS, &valid);
+    ASSERT_EQ(valid, GL_TRUE);
+    glDispatchCompute(1, 1, 1);
+    ASSERT_GL_NO_ERROR();
+    GLProgram restored;
+    glProgramParameteri(restored, GL_PROGRAM_SEPARABLE, GL_TRUE);
+    reloadProgram(program, restored);
+    glProgramUniform1ui(restored, glGetUniformLocation(restored, "seed"), 89);
+    glUseProgramStages(pipeline, GL_COMPUTE_SHADER_BIT, restored);
+    block = glGetProgramResourceIndex(restored, GL_SHADER_STORAGE_BLOCK, "OutputData");
+    ASSERT_NE(block, GL_INVALID_INDEX);
+    glGetProgramResourceiv(restored, GL_SHADER_STORAGE_BLOCK, block, 1, &property, 1, nullptr,
+                           &binding);
+    ASSERT_EQ(binding, 5);
+    // The active uniform target remains the first program; execution must use
+    // the newly installed compute component, including its local size of four.
+    glUniform1ui(glGetUniformLocation(program, "seed"), 7);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 5, result, 256, 64);
+    glBindBuffer(GL_DISPATCH_INDIRECT_BUFFER, commands);
+    const std::array<uint32_t, 3> groups = {1, 1, 1};
+    glBufferData(GL_DISPATCH_INDIRECT_BUFFER, sizeof(groups), groups.data(), GL_DYNAMIC_DRAW);
+    glDispatchComputeIndirect(0);
+    ASSERT_GL_NO_ERROR();
+    // Update the component without changing the installed pipeline stage.
+    glProgramUniform1ui(restored, glGetUniformLocation(restored, "seed"), 101);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 5, result, 512, 64);
+    glDispatchCompute(1, 1, 1);
+    ASSERT_GL_NO_ERROR();
+    program.reset();
+    restored.reset();
+    glActiveShaderProgram(pipeline, 0);
+    glUseProgramStages(pipeline, GL_COMPUTE_SHADER_BIT, 0);
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    for (uint32_t pass = 0; pass < 3; ++pass)
+    {
+        for (uint32_t i = 0; i < 4; ++i)
+        {
+            const uint32_t seed             = pass == 0 ? 29 : pass == 1 ? 89 : 101;
+            expected[pass * 64 + 4 * i]     = seed + i;
+            expected[pass * 64 + 4 * i + 1] = seed;
+            expected[pass * 64 + 4 * i + 2] = 0;
+            expected[pass * 64 + 4 * i + 3] = 1;
+        }
+    }
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (size_t i = 0; i < expected.size(); ++i)
+    {
+        EXPECT_EQ(actual[i], expected[i]) << i;
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
