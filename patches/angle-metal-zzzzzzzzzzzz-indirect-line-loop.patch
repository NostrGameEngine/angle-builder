+TEST_P(ComputeDispatchTestMetal, GPUGeneratedLineLoopIndirectAndMultiDraw)
+{
+    constexpr char producer[]       = R"(#version 310 es
+        layout(local_size_x=1) in;
+        layout(std430,binding=0) buffer Commands { uint words[]; } commands;
+        layout(std430,binding=1) buffer Indices { uint words[]; } indices;
+        uniform uint indexSize, count, instances, second;
+        void main() {
+            for (uint i=0u;i<6u;++i) indices.words[i]=0xcdcdcdcdu;
+            if (indexSize==1u) { indices.words[0]=0x0504fbfau; indices.words[1]=0xfdfc0706u; }
+            if (indexSize==2u) { indices.words[1]=0x00050004u; indices.words[2]=0x00070006u; }
+            if (indexSize==4u) for (uint i=0u;i<4u;++i) indices.words[2u+i]=4u+i;
+            commands.words[64]=count;
+            commands.words[65]=instances;
+            commands.words[66]=indexSize==0u ? 3u : 2u;
+            commands.words[67]=indexSize==0u ? 0u : 0xffffffffu;
+            commands.words[68]=0u;
+            commands.words[second]=0u;
+            commands.words[second+1u]=1u;
+            commands.words[second+2u]=0u;
+            commands.words[second+3u]=0u;
+            commands.words[second+4u]=0u;
+        }
+    )";
+    constexpr char vertex[]         = R"(#version 310 es
+        void main() {
+            int i=gl_VertexID-3;
+            vec2 p=vec2(i==0 || i==3 ? -0.75 : 0.5, i<2 ? -0.5 : 0.5);
+            p.x+=float(gl_InstanceID)*0.25;
+            gl_Position=vec4(p,0,1);
+        }
+    )";
+    constexpr char fragment[]       = R"(#version 310 es
+        precision highp float;
+        out vec4 color;
+        void main() { color=vec4(0,1,0,1); }
+    )";
+    constexpr char markerVertex[]   = R"(#version 310 es
+        void main() {
+            vec2 p=gl_VertexID==0 ? vec2(-1,-1) : gl_VertexID==1 ? vec2(3,-1) : vec2(-1,3);
+            gl_Position=vec4(p,0,1);
+        }
+    )";
+    constexpr char markerFragment[] = R"(#version 310 es
+        precision highp float;
+        out vec4 color;
+        void main() { color=vec4(0,0,1,1); }
+    )";
+    constexpr char tinyProducer[]   = R"(#version 310 es
+        layout(local_size_x=1) in;
+        layout(std430,binding=0) buffer Command { uint words[]; } command;
+        uniform bool indexed;
+        void main() {
+            command.words[0]=4u; command.words[1]=2u;
+            command.words[2]=indexed ? 2u : 3u;
+            command.words[3]=indexed ? 0xffffffffu : 0u;
+            if (indexed) command.words[4]=0u;
+        }
+    )";
+    ASSERT_TRUE(EnsureGLExtensionEnabled("GL_EXT_multi_draw_indirect"));
+    ANGLE_GL_COMPUTE_PROGRAM(compute, producer);
+    ANGLE_GL_COMPUTE_PROGRAM(tinyCompute, tinyProducer);
+    ANGLE_GL_PROGRAM(render, vertex, fragment);
+    ANGLE_GL_PROGRAM(marker, markerVertex, markerFragment);
+    GLVertexArray vao;
+    glBindVertexArray(vao);
+    GLBuffer commands, indices, referenceIndices;
+    std::array<uint32_t, 128> expectedCommands;
+    expectedCommands.fill(0xcdcdcdcdu);
+    glBindBuffer(GL_DRAW_INDIRECT_BUFFER, commands);
+    glBufferData(GL_DRAW_INDIRECT_BUFFER, sizeof(expectedCommands), expectedCommands.data(),
+                 GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, commands);
+    std::array<uint32_t, 32> expectedIndices;
+    expectedIndices.fill(0xcdcdcdcdu);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, indices);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeof(expectedIndices), expectedIndices.data(),
+                 GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 1, indices);
+    const std::array<uint32_t, 4> reference = {3, 4, 5, 6};
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, referenceIndices);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeof(reference), reference.data(), GL_STATIC_DRAW);
+    auto begin = [&]() {
+        glClearColor(1, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glUseProgram(marker);
+        glEnable(GL_SCISSOR_TEST);
+        glScissor(0, 0, 1, 1);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        glDisable(GL_SCISSOR_TEST);
+        glUseProgram(render);
+    };
+    const std::array<GLenum, 4> types = {GL_NONE, GL_UNSIGNED_BYTE, GL_UNSIGNED_SHORT,
+                                         GL_UNSIGNED_INT};
+    for (uint32_t format = 0; format < 4; ++format)
+    {
+        for (uint32_t multi = 0; multi < 2; ++multi)
+        {
+            for (uint32_t scenario = 0; scenario < 4; ++scenario)
+            {
+                const uint32_t count     = scenario == 1 ? 1 : scenario == 2 ? 0 : 4;
+                const uint32_t instances = scenario == 3 ? 0 : 2;
+                const uint32_t indexSize = format == 0 ? 0 : format == 1 ? 1 : format == 2 ? 2 : 4;
+                const uint32_t stride    = scenario % 2 == 0 ? 0 : 32;
+                const uint32_t second    = 64 + (stride ? stride / 4 : indexSize ? 5 : 4);
+                begin();
+                glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, referenceIndices);
+                if (format == 0)
+                {
+                    glDrawArraysInstanced(GL_LINE_LOOP, 3, count, instances);
+                }
+                else
+                {
+                    glDrawElementsInstanced(GL_LINE_LOOP, count, GL_UNSIGNED_INT, nullptr,
+                                            instances);
+                }
+                std::array<GLColor, 256> referencePixels;
+                glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE, referencePixels.data());
+                ASSERT_GL_NO_ERROR();
+                EXPECT_EQ(referencePixels[0], GLColor::blue);
+                if (count == 4 && instances != 0)
+                {
+                    EXPECT_GT(
+                        std::count(referencePixels.begin(), referencePixels.end(), GLColor::green),
+                        20);
+                }
+                glUseProgram(compute);
+                glUniform1ui(glGetUniformLocation(compute, "indexSize"), indexSize);
+                glUniform1ui(glGetUniformLocation(compute, "count"), count);
+                glUniform1ui(glGetUniformLocation(compute, "instances"), instances);
+                glUniform1ui(glGetUniformLocation(compute, "second"), second);
+                glDispatchCompute(1, 1, 1);
+                glMemoryBarrier(GL_COMMAND_BARRIER_BIT | GL_ELEMENT_ARRAY_BARRIER_BIT);
+                begin();
+                glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, indices);
+                const void *offset = reinterpret_cast<const void *>(256);
+                if (format == 0)
+                {
+                    if (multi)
+                    {
+                        glMultiDrawArraysIndirectEXT(GL_LINE_LOOP, offset, 2, stride);
+                    }
+                    else
+                    {
+                        glDrawArraysIndirect(GL_LINE_LOOP, offset);
+                    }
+                }
+                else
+                {
+                    if (multi)
+                    {
+                        glMultiDrawElementsIndirectEXT(GL_LINE_LOOP, types[format], offset, 2,
+                                                       stride);
+                    }
+                    else
+                    {
+                        glDrawElementsIndirect(GL_LINE_LOOP, types[format], offset);
+                    }
+                }
+                ASSERT_GL_NO_ERROR();
+                std::array<GLColor, 256> pixels;
+                glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+                EXPECT_EQ(pixels, referencePixels) << format << ' ' << multi << ' ' << scenario;
+                EXPECT_EQ(pixels[0], GLColor::blue);
+                expectedCommands[64] = count;
+                expectedCommands[65] = instances;
+                expectedCommands[66] = indexSize ? 2 : 3;
+                expectedCommands[67] = indexSize ? 0xffffffffu : 0u;
+                expectedCommands[68] = 0;
+                for (uint32_t i = 0; i < 5; ++i)
+                {
+                    expectedCommands[second + i] = i == 1 ? 1 : 0;
+                }
+            }
+        }
+    }
+    for (uint32_t i = 0; i < 4; ++i)
+    {
+        expectedIndices[2 + i] = 4 + i;
+    }
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    auto check = [&](GLuint buffer, const auto &expected) {
+        glBindBuffer(GL_SHADER_STORAGE_BUFFER, buffer);
+        const auto *actual = static_cast<const uint32_t *>(
+            glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+        ASSERT_NE(actual, nullptr);
+        for (size_t i = 0; i < expected.size(); ++i)
+        {
+            EXPECT_EQ(actual[i], expected[i]) << i;
+        }
+        EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    };
+    check(indices, expectedIndices);
+    check(commands, expectedCommands);
+    // Minimal argument allocations exercise the array kernel branch without
+    // an extra fifth argument word, and the complete 20-byte indexed packet.
+    GLBuffer tiny;
+    for (bool indexed : {false, true})
+    {
+        begin();
+        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, referenceIndices);
+        if (indexed)
+        {
+            glDrawElementsInstanced(GL_LINE_LOOP, 4, GL_UNSIGNED_INT, nullptr, 2);
+        }
+        else
+        {
+            glDrawArraysInstanced(GL_LINE_LOOP, 3, 4, 2);
+        }
+        std::array<GLColor, 256> referencePixels;
+        glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE, referencePixels.data());
+        glBindBuffer(GL_DRAW_INDIRECT_BUFFER, tiny);
+        glBufferData(GL_DRAW_INDIRECT_BUFFER, indexed ? 20 : 16, nullptr, GL_DYNAMIC_DRAW);
+        glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, tiny);
+        glUseProgram(tinyCompute);
+        glUniform1i(glGetUniformLocation(tinyCompute, "indexed"), indexed);
+        glDispatchCompute(1, 1, 1);
+        glMemoryBarrier(GL_COMMAND_BARRIER_BIT);
+        begin();
+        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, indices);
+        if (indexed)
+        {
+            glDrawElementsIndirect(GL_LINE_LOOP, GL_UNSIGNED_INT, nullptr);
+        }
+        else
+        {
+            glDrawArraysIndirect(GL_LINE_LOOP, nullptr);
+        }
+        ASSERT_GL_NO_ERROR();
+        std::array<GLColor, 256> pixels;
+        glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+        EXPECT_EQ(pixels, referencePixels);
+        EXPECT_EQ(pixels[0], GLColor::blue);
+    }
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    const std::array<uint32_t, 5> expectedTiny = {4, 2, 2, 0xffffffffu, 0};
+    check(tiny, expectedTiny);
+    ASSERT_GL_NO_ERROR();
+}
