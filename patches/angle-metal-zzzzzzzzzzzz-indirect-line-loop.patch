+angle::Result ContextMtl::prepareIndirectLineLoop(const mtl::BufferRef &arguments,
+                                                  size_t argumentOffset,
+                                                  const mtl::BufferSlice &indices,
+                                                  gl::DrawElementsType nativeIndexType,
+                                                  mtl::BufferSlice *closing)
+{
+    if (!mIndirectLineLoopFunction)
+    {
+        mtl::TranslatedShaderInfo shader;
+        shader.metalShaderSource = std::make_shared<const std::string>(R"(
+#include <metal_stdlib>
+using namespace metal;
+kernel void main0(const device uint *source [[buffer(0)]],
+                  device uint *destination [[buffer(1)]],
+                  const device uchar *indices [[buffer(2)]],
+                  constant uint &indexSize [[buffer(3)]])
+{
+    const uint count = source[0];
+    const uint instances = source[1];
+    const bool visible = count > 1u && instances > 0u;
+    // Native indexed indirect arguments, a padding word, then two UInt32 indices.
+    destination[0] = visible ? 2u : 0u;
+    destination[1] = instances;
+    destination[2] = 0u;
+    destination[3] = indexSize ? source[3] : 0u;
+    destination[4] = indexSize ? source[4] : source[3];
+    uint first = 0u, last = 0u;
+    if (visible)
+    {
+        const size_t begin = source[2];
+        const size_t end = begin + size_t(count) - 1u;
+        if (indexSize == 2u)
+        {
+            const device ushort *data = reinterpret_cast<const device ushort *>(indices);
+            first = data[begin]; last = data[end];
+        }
+        else if (indexSize == 4u)
+        {
+            const device uint *data = reinterpret_cast<const device uint *>(indices);
+            first = data[begin]; last = data[end];
+        }
+        else
+        {
+            first = uint(begin); last = uint(end);
+        }
+    }
+    destination[6] = last;
+    destination[7] = first;
+}
+)");
+        gl::InfoLog log;
+        ANGLE_TRY(CreateMslShaderLib(this, log, &shader, {}));
+        mIndirectLineLoopFunction =
+            angle::adoptObjCPtr([shader.metalLibrary.get() newFunctionWithName:@"main0"]);
+        ANGLE_CHECK(this, mIndirectLineLoopFunction, "Missing indirect line-loop kernel",
+                    GL_INVALID_OPERATION);
+    }
+    angle::ObjCPtr<id<MTLComputePipelineState>> pipeline;
+    ANGLE_TRY(
+        getPipelineCache().getComputePipeline(this, mIndirectLineLoopFunction.get(), &pipeline));
+    mLineLoopLastSegmentIndexBuffer.releaseInFlightBuffers(this);
+    ANGLE_TRY(mLineLoopLastSegmentIndexBuffer.allocate(this, kIndirectLineLoopPacketSize, closing));
+    ANGLE_TRY(mLineLoopLastSegmentIndexBuffer.commit(this));
+    const uint32_t indexSize =
+        nativeIndexType == gl::DrawElementsType::InvalidEnum
+            ? 0
+            : static_cast<uint32_t>(gl::GetDrawElementsTypeSize(nativeIndexType));
+    auto *encoder = getComputeCommandEncoder();
+    encoder->setComputePipelineState(pipeline.get());
+    encoder->setBuffer(arguments, argumentOffset, 0);
+    encoder->setBufferForWrite(closing->buffer(), closing->offset(), 1);
+    // The unused array-draw input remains bound for Metal argument validation.
+    encoder->setBuffer(indexSize ? indices.buffer() : arguments,
+                       indexSize ? indices.offset() : argumentOffset, 2);
+    encoder->setData(indexSize, 3);
+    encoder->dispatch(MTLSizeMake(1, 1, 1), MTLSizeMake(1, 1, 1));
+    return angle::Result::Continue;
+}
