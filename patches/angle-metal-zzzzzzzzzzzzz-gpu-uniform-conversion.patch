+angle::Result UBOConversionInfo::getByteConversionMap(ContextMtl *context,
+                                                      mtl::BufferRef *mapOut) const
+{
+    if (!mByteConversionMap)
+    {
+        // Each destination byte either copies one source byte, normalizes a
+        // four-byte GL boolean, or is padding. Reflection supplies every offset;
+        // no application buffer contents are inspected on the CPU.
+        constexpr uint32_t kBoolean = 0x80000000u;
+        constexpr uint32_t kPadding = 0xffffffffu;
+        std::vector<uint32_t> map(metalSize(), kPadding);
+        const auto &source      = stdInfo();
+        const auto &destination = metalInfo();
+        ASSERT(source.size() == destination.size());
+        for (size_t member = 0; member < source.size(); ++member)
+        {
+            const auto &src = source[member];
+            const auto &dst = destination[member];
+            for (int element = 0; element < src.arraySize; ++element)
+            {
+                const size_t srcBase = src.offset + element * src.arrayStride;
+                const size_t dstBase = dst.offset + element * dst.arrayStride;
+                if (gl::IsMatrixType(dst.type))
+                {
+                    for (int col = 0; col < gl::VariableColumnCount(dst.type); ++col)
+                    {
+                        for (int row = 0; row < gl::VariableRowCount(dst.type); ++row)
+                        {
+                            const size_t from =
+                                srcBase + (src.isRowMajorMatrix ? row * src.matrixStride + col * 4
+                                                                : col * src.matrixStride + row * 4);
+                            const size_t to = dstBase + col * dst.matrixStride + row * 4;
+                            ASSERT(to + 4 <= map.size());
+                            for (size_t byte = 0; byte < 4; ++byte)
+                            {
+                                map[to + byte] = static_cast<uint32_t>(from + byte);
+                            }
+                        }
+                    }
+                }
+                else if (gl::VariableComponentType(dst.type) == GL_BOOL)
+                {
+                    for (int component = 0; component < gl::VariableComponentCount(dst.type);
+                         ++component)
+                    {
+                        ASSERT(dstBase + component < map.size());
+                        map[dstBase + component] =
+                            kBoolean | static_cast<uint32_t>(srcBase + component * 4);
+                    }
+                }
+                else
+                {
+                    const size_t bytes = gl::VariableComponentCount(dst.type) * 4;
+                    ASSERT(dstBase + bytes <= map.size());
+                    for (size_t byte = 0; byte < bytes; ++byte)
+                    {
+                        map[dstBase + byte] = static_cast<uint32_t>(srcBase + byte);
+                    }
+                }
+            }
+        }
+        mtl::BufferRef buffer;
+        ANGLE_TRY(mtl::Buffer::MakeBuffer(context, map.size() * sizeof(uint32_t), &buffer));
+        auto data = buffer->mapNoSync(context);
+        ANGLE_UNSAFE_TODO(memcpy(data.data(), map.data(), map.size() * sizeof(uint32_t)));
+        buffer->unmapAndFlushSubset(context, 0, map.size() * sizeof(uint32_t));
+        mByteConversionMap = std::move(buffer);
+    }
+    *mapOut = mByteConversionMap;
+    return angle::Result::Continue;
+}
