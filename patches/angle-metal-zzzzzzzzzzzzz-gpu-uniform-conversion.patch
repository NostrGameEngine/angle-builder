+angle::Result ProgramExecutableMtl::convertUniformBufferData(ContextMtl *context,
+                                                             const UBOConversionInfo &info,
+                                                             mtl::BufferPool *pool,
+                                                             const mtl::BufferRef &source,
+                                                             size_t sourceOffset,
+                                                             size_t sourceSize,
+                                                             mtl::BufferSlice *destination)
+{
+    if (!mUniformConversionFunction)
+    {
+        mtl::TranslatedShaderInfo shader;
+        shader.metalShaderSource = std::make_shared<const std::string>(R"(
+#include <metal_stdlib>
+using namespace metal;
+struct CopyParams {
+    uint sourceOffsetLow, sourceOffsetHigh, sourceSizeLow, sourceSizeHigh;
+    uint sourceStride, destinationStride, totalSize;
+};
+kernel void main0(const device uchar *source [[buffer(0)]],
+                  device uchar *destination [[buffer(1)]],
+                  const device uint *map [[buffer(2)]],
+                  constant CopyParams &params [[buffer(3)]],
+                  uint index [[thread_position_in_grid]])
+{
+    if (ulong(index) >= params.totalSize) return;
+    const ulong sourceOffset = ulong(params.sourceOffsetLow) | (ulong(params.sourceOffsetHigh) << 32u);
+    const ulong sourceSize = ulong(params.sourceSizeLow) | (ulong(params.sourceSizeHigh) << 32u);
+    const ulong block = ulong(index) / params.destinationStride;
+    const uint entry = map[ulong(index) % params.destinationStride];
+    uchar value = 0;
+    if (entry != 0xffffffffu)
+    {
+        const ulong offset = block * params.sourceStride + ulong(entry & 0x7fffffffu);
+        if ((entry & 0x80000000u) != 0u)
+        {
+            // Byte reads also handle incomplete trailing source blocks without
+            // alignment assumptions or reading beyond the allocation.
+            for (uint byte = 0; byte < 4u; ++byte)
+                if (offset + byte < sourceSize)
+                    value |= source[sourceOffset + offset + byte];
+            value = value != 0;
+        }
+        else if (offset < sourceSize)
+            value = source[sourceOffset + offset];
+    }
+    destination[index] = value;
+}
+)");
+        gl::InfoLog log;
+        ANGLE_TRY(CreateMslShaderLib(context, log, &shader, {}));
+        mUniformConversionFunction =
+            angle::adoptObjCPtr([shader.metalLibrary.get() newFunctionWithName:@"main0"]);
+        ANGLE_CHECK(context, mUniformConversionFunction, "Missing uniform conversion kernel",
+                    GL_INVALID_OPERATION);
+    }
+    angle::ObjCPtr<id<MTLComputePipelineState>> pipeline;
+    ANGLE_TRY(context->getPipelineCache().getComputePipeline(
+        context, mUniformConversionFunction.get(), &pipeline));
+    mtl::BufferRef map;
+    ANGLE_TRY(info.getByteConversionMap(context, &map));
+    const size_t blocks =
+        std::max<size_t>(1, sourceSize / info.stdSize() + (sourceSize % info.stdSize() != 0));
+    ANGLE_CHECK(context, info.metalSize() && blocks <= UINT32_MAX / info.metalSize(),
+                "Uniform conversion allocation exceeds the GPU index range", GL_OUT_OF_MEMORY);
+    const size_t totalSize = blocks * info.metalSize();
+    pool->releaseInFlightBuffers(context);
+    ANGLE_TRY(pool->allocate(context, totalSize, destination));
+    ANGLE_TRY(pool->commit(context));
+    // MSL 2.1 permits 64-bit arithmetic, but not ulong members in buffer
+    // parameter types. Preserve full source offsets through pairs of uints.
+    const std::array<uint32_t, 7> params = {
+        static_cast<uint32_t>(sourceOffset),   static_cast<uint32_t>(sourceOffset >> 32),
+        static_cast<uint32_t>(sourceSize),     static_cast<uint32_t>(sourceSize >> 32),
+        static_cast<uint32_t>(info.stdSize()), static_cast<uint32_t>(info.metalSize()),
+        static_cast<uint32_t>(totalSize)};
+    auto *encoder = context->getComputeCommandEncoder();
+    encoder->setComputePipelineState(pipeline.get());
+    encoder->setBuffer(source, 0, 0);
+    encoder->setBufferForWrite(destination->buffer(), destination->offset(), 1);
+    encoder->setBuffer(map, 0, 2);
+    encoder->setData(params, 3);
+    const size_t width = std::min<size_t>(64, pipeline.get().maxTotalThreadsPerThreadgroup);
+    encoder->dispatch(MTLSizeMake((totalSize + width - 1) / width, 1, 1), MTLSizeMake(width, 1, 1));
+    return angle::Result::Continue;
+}
