+        uniform uint base;
+        uniform highp float seed;
+        void put(uint word, float value) { allocation.words[base+word]=floatBitsToUint(value); }
+        void main() {
+            for (uint row=0u; row<3u; ++row)
+                for (uint col=0u; col<2u; ++col)
+                    put(row*4u+col, seed+float(col*3u+row+1u));
+            allocation.words[base+12u]=0u;
+            allocation.words[base+13u]=0x80000000u;
+            allocation.words[base+14u]=0x01000000u;
+            put(15u,seed+7.0);
+            for (uint component=0u; component<4u; ++component)
+                put(16u+component,seed+float(8u+component));
+            for (uint element=0u; element<2u; ++element) {
+                for (uint component=0u; component<2u; ++component)
+                    put(20u+element*4u+component,seed+float(12u+element*2u+component));
+                for (uint row=0u; row<2u; ++row)
