+                        valid=valid && data.rotations[element][col][row]==expectedSeed+float(20+element*6+col*2+row);
+            }
+            for (int element=0; element<5; ++element)
+                for (int component=0; component<4; ++component)
+                    valid=valid && data.tail[element][component]==expectedSeed+float(40+element*4+component);
+            return valid;
+        }
+    )";
+    const std::string vertex =
+        std::string("#version 310 es\nprecision highp float;\n") + block + R"(
+        void main() {
+            vec2 p=gl_VertexID==0 ? vec2(-1,-1) : gl_VertexID==1 ? vec2(3,-1) : vec2(-1,3);
+            gl_Position=validData() ? vec4(p,0,1) : vec4(3,3,0,1);
+        }
+    )";
+    const std::string fragment =
+        std::string("#version 310 es\nprecision highp float;\n") + block + R"(
+        out vec4 color;
+        void main() { color=validData() ? vec4(0,1,0,1) : vec4(1,0,0,1); }
+    )";
+    constexpr char markerVertex[]   = R"(#version 310 es
+        void main() {
+            vec2 p=gl_VertexID==0 ? vec2(-1,-1) : gl_VertexID==1 ? vec2(3,-1) : vec2(-1,3);
+            gl_Position=vec4(p,0,1);
+        }
+    )";
+    constexpr char markerFragment[] = R"(#version 310 es
+        precision highp float;
+        out vec4 color;
+        void main() { color=vec4(0,0,1,1); }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(compute, producer);
+    ANGLE_GL_PROGRAM(render, vertex.c_str(), fragment.c_str());
+    ANGLE_GL_PROGRAM(marker, markerVertex, markerFragment);
+    GLProgram restored;
+    GLBuffer allocation, commands;
+    GLVertexArray vao;
+    glBindVertexArray(vao);
+    std::array<uint32_t, 528> expected;
+    expected.fill(0xcdcdcdcdu);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(expected), expected.data(), GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, allocation);
+    glBindBuffer(GL_DRAW_INDIRECT_BUFFER, commands);
+    glBufferData(GL_DRAW_INDIRECT_BUFFER, 16, nullptr, GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 1, commands);
+    GLuint active = render;
+    for (uint32_t frame = 0; frame < 6; ++frame)
+    {
+        SCOPED_TRACE(frame);
+        if (frame == 3)
+        {
+            reloadProgram(render, restored);
+            active = restored;
+        }
+        const uint32_t offset = frame % 3 == 2 ? 768 : 256;
+        const uint32_t base   = offset / 4;
+        const float seed      = 17.0f + frame * 7.0f;
+        auto put              = [&](uint32_t word, float value) {
+            std::memcpy(&expected[base + word], &value, sizeof(value));
+        };
+        for (uint32_t row = 0; row < 3; ++row)
+        {
+            for (uint32_t col = 0; col < 2; ++col)
+            {
+                put(row * 4 + col, seed + col * 3 + row + 1);
+            }
+        }
+        expected[base + 12] = 0;
+        expected[base + 13] = 0x80000000u;
+        expected[base + 14] = 0x01000000u;
+        put(15, seed + 7);
+        for (uint32_t component = 0; component < 4; ++component)
+        {
+            put(16 + component, seed + 8 + component);
+        }
+        for (uint32_t element = 0; element < 2; ++element)
+        {
+            for (uint32_t component = 0; component < 2; ++component)
+            {
+                put(20 + element * 4 + component, seed + 12 + element * 2 + component);
+            }
+            for (uint32_t row = 0; row < 2; ++row)
+            {
+                for (uint32_t col = 0; col < 3; ++col)
+                {
+                    put(28 + element * 8 + row * 4 + col, seed + 20 + element * 6 + col * 2 + row);
+                }
+            }
+        }
+        for (uint32_t component = 0; component < 20; ++component)
+        {
+            put(44 + component, seed + 40 + component);
+        }
+
+        glUseProgram(compute);
+        glUniform1ui(glGetUniformLocation(compute, "base"), base);
+        glUniform1f(glGetUniformLocation(compute, "seed"), seed);
+        glDispatchCompute(1, 1, 1);
+        glMemoryBarrier(GL_UNIFORM_BARRIER_BIT | GL_COMMAND_BARRIER_BIT);
+        glClearColor(1, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glUseProgram(marker);
+        glEnable(GL_SCISSOR_TEST);
+        glScissor(0, 0, 1, 1);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        glScissor(1, 1, 15, 15);
+        glUseProgram(active);
+        const GLuint blockIndex = glGetUniformBlockIndex(active, "Data");
+        ASSERT_NE(blockIndex, GL_INVALID_INDEX);
+        GLint blockSize = 0;
+        glGetActiveUniformBlockiv(active, blockIndex, GL_UNIFORM_BLOCK_DATA_SIZE, &blockSize);
+        ASSERT_EQ(blockSize, 256);
+        glUniformBlockBinding(active, blockIndex, 7);
+        glBindBufferRange(GL_UNIFORM_BUFFER, 7, allocation, offset, 256);
+        glUniform1f(glGetUniformLocation(active, "expectedSeed"), seed);
+        if (frame & 1)
+        {
+            glDrawArraysIndirect(GL_TRIANGLES, nullptr);
+        }
+        else
+        {
+            glDrawArrays(GL_TRIANGLES, 0, 3);
+        }
+        glDisable(GL_SCISSOR_TEST);
+        ASSERT_GL_NO_ERROR();
+        EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::blue);
+        EXPECT_PIXEL_COLOR_EQ(8, 8, GLColor::green);
+    }
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (size_t word = 0; word < expected.size(); ++word)
+    {
+        EXPECT_EQ(actual[word], expected[word]) << "source/guard word " << word;
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
+
 // Exercise actual GL compilation, linking, remapping, uniforms, program binary
 // reload and dispatch. Two SSBO ranges alias one allocation; readback is final.
 TEST_P(ComputeDispatchTestMetal, StorageRangesUniformsAndBinary)
