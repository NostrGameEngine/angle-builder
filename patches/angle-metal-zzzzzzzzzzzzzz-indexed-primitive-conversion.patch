+        uniform bool restarting;
+        void main() {
+            const uint pattern[14]=uint[14](0xffffffffu,1u,2u,3u,0xffffffffu,
+                0xffffffffu,5u,6u,7u,8u,0xffffffffu,9u,10u,0xffffffffu);
