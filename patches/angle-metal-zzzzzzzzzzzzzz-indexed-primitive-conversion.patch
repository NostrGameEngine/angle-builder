+void emitTriangle(device uint *indices, thread uint &count, uint a, uint b, uint c,
+                  uint provoking)
+{
+    // Cyclic permutations preserve winding, including the alternating winding
+    // already resolved by the strip caller.
+    indices[count++] = provoking == 0u ? a : provoking == 1u ? b : c;
+    indices[count++] = provoking == 0u ? b : provoking == 1u ? c : a;
+    indices[count++] = provoking == 0u ? c : provoking == 1u ? a : b;
+}
+
+kernel void main0(const device uint *source [[buffer(0)]],
+                  device uint *destination [[buffer(1)]],
+                  const device uchar *input [[buffer(2)]],
+                  constant uint4 &params [[buffer(3)]])
+{
+    const uint capacity = params.x;
+    const uint indexSize = params.y;
+    const uint mode = params.z;
+    const bool restart = (params.w & 1u) != 0u;
+    const bool last = (params.w & 2u) != 0u;
+    const bool first = (params.w & 4u) != 0u;
+    const uint sentinel = indexSize == 1u ? 0xffu : indexSize == 2u ? 0xffffu : 0xffffffffu;
+    const uint begin = source[2];
+    const uint count = source[1] != 0u && begin < capacity
+                           ? min(source[0], capacity - begin) : 0u;
+    // Eight header words keep the index region aligned independently of the
+    // native five-word indirect command. All values come from GPU storage.
+    device uint *output = destination + 8;
+    uint written = 0u, segment = 0u, origin = 0u, previous = 0u, older = 0u;
+    for (uint i = 0u; i < count; ++i)
+    {
+        const uint value = sourceIndex(input, begin + i, indexSize);
+        if (restart && value == sentinel)
+        {
+            if (mode == 2u && segment > 1u)
+                emitLine(output, written, previous, origin, last);
+            segment = 0u;
+            continue;
+        }
+        switch (mode)
+        {
+            case 0u: // GL_POINTS
+                output[written++] = value;
+                break;
+            case 1u: // GL_LINES
+                if ((segment & 1u) != 0u)
+                    emitLine(output, written, previous, value, last);
+                break;
+            case 2u: // GL_LINE_LOOP
+            case 3u: // GL_LINE_STRIP
+                if (segment > 0u)
+                    emitLine(output, written, previous, value, last);
+                break;
+            case 4u: // GL_TRIANGLES
+                if (segment % 3u == 2u)
+                    emitTriangle(output, written, older, previous, value, last ? 2u : 0u);
+                break;
+            case 5u: // GL_TRIANGLE_STRIP
+                if (segment > 1u)
+                {
+                    const bool odd = (segment & 1u) != 0u;
+                    emitTriangle(output, written, odd ? previous : older,
+                                 odd ? older : previous, value,
+                                 last ? 2u : first && odd ? 1u : 0u);
+                }
+                break;
+            case 6u: // GL_TRIANGLE_FAN
+                if (segment > 1u)
+                    emitTriangle(output, written, origin, previous, value,
+                                 last ? 2u : first ? 1u : 0u);
+                break;
+        }
+        if (segment == 0u) origin = value;
+        older = previous;
+        previous = value;
+        ++segment;
+    }
+    if (mode == 2u && segment > 1u)
+        emitLine(output, written, previous, origin, last);
+    destination[0] = written;
+    destination[1] = source[1];
+    destination[2] = 0u;
+    destination[3] = source[3];
+    destination[4] = source[4];
+}
