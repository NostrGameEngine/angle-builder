diff --git a/src/tests/gl_tests/ComputeDispatchTestMetal.cpp b/src/tests/gl_tests/ComputeDispatchTestMetal.cpp
index 6a2c61b..feecef7 100644
--- a/src/tests/gl_tests/ComputeDispatchTestMetal.cpp
+++ b/src/tests/gl_tests/ComputeDispatchTestMetal.cpp
@@ -5,6 +5,7 @@
 #include "test_utils/ANGLETest.h"
 #include "test_utils/gl_raii.h"
 
+#include <algorithm>
 #include <array>
 #include <cstdlib>
 #include <cstring>
@@ -560,6 +561,164 @@ TEST_P(ComputeDispatchTestMetal, GPUIndexedPrimitiveRestartAndProvokingVertex)
     ASSERT_GL_NO_ERROR();
 }
 
+TEST_P(ComputeDispatchTestMetal, NullImagesClearBindingsBinaryAndDeletion)
+{
+    constexpr char source[] = R"(#version 310 es
+        precision highp float;
+        precision highp int;
+        layout(local_size_x=1) in;
+        layout(r32ui,binding=0) uniform highp uimage2D planar;
+        layout(r32i,binding=1) uniform highp iimage3D volume;
+        layout(r32f,binding=2) uniform highp image2DArray layers;
+        layout(r32ui,binding=3) uniform highp uimageCube faces;
+        layout(std430,binding=0) buffer Results { uvec4 records[]; } result;
+        uniform uint phase;
+        void main() {
+            uint base=phase*12u;
+            result.records[base]=uvec4(uvec2(imageSize(planar)),0u,0u);
+            result.records[base+1u]=uvec4(uvec3(imageSize(volume)),0u);
+            result.records[base+2u]=uvec4(uvec3(imageSize(layers)),0u);
+            result.records[base+3u]=uvec4(uvec2(imageSize(faces)),0u,0u);
+            result.records[base+4u]=imageLoad(planar,ivec2(0));
+            result.records[base+5u]=uvec4(imageLoad(volume,ivec3(0)));
+            result.records[base+6u]=floatBitsToUint(imageLoad(layers,ivec3(0)));
+            result.records[base+7u]=imageLoad(faces,ivec3(0));
+            imageStore(planar,ivec2(0),uvec4(101u+phase*11u,0u,0u,1u));
+            imageStore(volume,ivec3(0),ivec4(-int(201u+phase*13u),0,0,1));
+            imageStore(layers,ivec3(0),vec4(.5+float(phase),0,0,1));
+            imageStore(faces,ivec3(0),uvec4(301u+phase*17u,0u,0u,1u));
+            memoryBarrierImage();
+            result.records[base+8u]=imageLoad(planar,ivec2(0));
+            result.records[base+9u]=uvec4(imageLoad(volume,ivec3(0)));
+            result.records[base+10u]=floatBitsToUint(imageLoad(layers,ivec3(0)));
+            result.records[base+11u]=imageLoad(faces,ivec3(0));
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(program, source);
+    GLProgram restored;
+    GLTexture planarTexture, volumeTexture, layerTexture, cubeTexture;
+    GLBuffer allocation;
+    std::array<uint32_t, 512> expected;
+    expected.fill(0xcdcdcdcdu);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(expected), expected.data(), GL_DYNAMIC_DRAW);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 0, allocation, 256, 5 * 12 * 16);
+    auto floatWord = [](float value) {
+        uint32_t word;
+        std::memcpy(&word, &value, sizeof(word));
+        return word;
+    };
+    auto record = [&](uint32_t phaseIndex, uint32_t entry, std::array<uint32_t, 4> words) {
+        const size_t offset = 256 / 4 + (phaseIndex * 12 + entry) * 4;
+        std::copy(words.begin(), words.end(), expected.begin() + offset);
+    };
+    auto bindImages = [&](bool bound) {
+        glBindImageTexture(0, bound ? planarTexture.get() : 0, 0, GL_FALSE, 0, GL_READ_WRITE,
+                           GL_R32UI);
+        glBindImageTexture(1, bound ? volumeTexture.get() : 0, 0, GL_TRUE, 0, GL_READ_WRITE,
+                           GL_R32I);
+        glBindImageTexture(2, bound ? layerTexture.get() : 0, 0, GL_TRUE, 0, GL_READ_WRITE,
+                           GL_R32F);
+        glBindImageTexture(3, bound ? cubeTexture.get() : 0, 0, GL_TRUE, 0, GL_READ_WRITE,
+                           GL_R32UI);
+    };
+    GLuint active = program;
+    for (uint32_t phaseIndex = 0; phaseIndex < 5; ++phaseIndex)
+    {
+        SCOPED_TRACE(phaseIndex);
+        const bool bound = phaseIndex == 1 || phaseIndex == 3;
+        if (phaseIndex == 1)
+        {
+            const uint32_t planarValue = 11, cubeValue = 17;
+            const int32_t volumeValue = -13;
+            const float layerValue    = .5f;
+            glBindTexture(GL_TEXTURE_2D, planarTexture);
+            glTexStorage2D(GL_TEXTURE_2D, 1, GL_R32UI, 1, 1);
+            glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 1, 1, GL_RED_INTEGER, GL_UNSIGNED_INT,
+                            &planarValue);
+            glBindTexture(GL_TEXTURE_3D, volumeTexture);
+            glTexStorage3D(GL_TEXTURE_3D, 1, GL_R32I, 1, 1, 1);
+            glTexSubImage3D(GL_TEXTURE_3D, 0, 0, 0, 0, 1, 1, 1, GL_RED_INTEGER, GL_INT,
+                            &volumeValue);
+            glBindTexture(GL_TEXTURE_2D_ARRAY, layerTexture);
+            glTexStorage3D(GL_TEXTURE_2D_ARRAY, 1, GL_R32F, 1, 1, 1);
+            glTexSubImage3D(GL_TEXTURE_2D_ARRAY, 0, 0, 0, 0, 1, 1, 1, GL_RED, GL_FLOAT,
+                            &layerValue);
+            glBindTexture(GL_TEXTURE_CUBE_MAP, cubeTexture);
+            glTexStorage2D(GL_TEXTURE_CUBE_MAP, 1, GL_R32UI, 1, 1);
+            for (uint32_t face = 0; face < 6; ++face)
+            {
+                glTexSubImage2D(GL_TEXTURE_CUBE_MAP_POSITIVE_X + face, 0, 0, 0, 1, 1,
+                                GL_RED_INTEGER, GL_UNSIGNED_INT, &cubeValue);
+            }
+        }
+        if (phaseIndex == 3)
+        {
+            reloadProgram(program, restored);
+            active = restored;
+        }
+        if (phaseIndex == 4)
+        {
+            // Delete while the preceding dispatch is still queued. GL detaches
+            // the units, and command tracking must keep the old views alive.
+            planarTexture.reset();
+            volumeTexture.reset();
+            layerTexture.reset();
+            cubeTexture.reset();
+            for (uint32_t unit = 0; unit < 4; ++unit)
+            {
+                GLint name = -1;
+                glGetIntegeri_v(GL_IMAGE_BINDING_NAME, unit, &name);
+                EXPECT_EQ(name, 0);
+            }
+        }
+        else
+        {
+            bindImages(bound);
+        }
+        glUseProgram(active);
+        glUniform1ui(glGetUniformLocation(active, "phase"), phaseIndex);
+        glDispatchCompute(1, 1, 1);
+        glMemoryBarrier(GL_SHADER_STORAGE_BARRIER_BIT | GL_SHADER_IMAGE_ACCESS_BARRIER_BIT |
+                        GL_BUFFER_UPDATE_BARRIER_BIT);
+        ASSERT_GL_NO_ERROR();
+        for (uint32_t image = 0; image < 4; ++image)
+        {
+            record(phaseIndex, image,
+                   !bound                     ? std::array<uint32_t, 4>{0, 0, 0, 0}
+                   : image == 0 || image == 3 ? std::array<uint32_t, 4>{1, 1, 0, 0}
+                                              : std::array<uint32_t, 4>{1, 1, 1, 0});
+            if (!bound)
+            {
+                record(phaseIndex, image + 4, {0, 0, 0, 0});
+                record(phaseIndex, image + 8, {0, 0, 0, 0});
+            }
+        }
+        if (bound)
+        {
+            record(phaseIndex, 4, {phaseIndex == 1 ? 11u : 112u, 0, 0, 1});
+            record(phaseIndex, 5, {static_cast<uint32_t>(phaseIndex == 1 ? -13 : -214), 0, 0, 1});
+            record(phaseIndex, 6, {floatWord(phaseIndex == 1 ? .5f : 1.5f), 0, 0, floatWord(1)});
+            record(phaseIndex, 7, {phaseIndex == 1 ? 17u : 318u, 0, 0, 1});
+            record(phaseIndex, 8, {101u + phaseIndex * 11u, 0, 0, 1});
+            record(phaseIndex, 9,
+                   {static_cast<uint32_t>(-static_cast<int32_t>(201 + phaseIndex * 13)), 0, 0, 1});
+            record(phaseIndex, 10, {floatWord(.5f + phaseIndex), 0, 0, floatWord(1)});
+            record(phaseIndex, 11, {301u + phaseIndex * 17u, 0, 0, 1});
+        }
+    }
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (size_t word = 0; word < expected.size(); ++word)
+    {
+        EXPECT_EQ(actual[word], expected[word]) << "image result/source/guard word " << word;
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
+
 // Exercise actual GL compilation, linking, remapping, uniforms, program binary
 // reload and dispatch. Two SSBO ranges alias one allocation; readback is final.
 TEST_P(ComputeDispatchTestMetal, StorageRangesUniformsAndBinary)
