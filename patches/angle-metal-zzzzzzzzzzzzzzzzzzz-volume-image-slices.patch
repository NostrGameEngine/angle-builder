+// Non-layered image2D bindings must alias the original 3D storage, including
+// writes observed through a second image in the same invocation.
+TEST_P(ComputeDispatchTestMetal, VolumeSliceAliasesArraysAndBinary)
+{
+    constexpr char source[] = R"(#version 310 es
+        layout(local_size_x=1) in;
+        layout(r32ui,binding=0) uniform highp uimage2D views[1][2];
+        layout(r32ui,binding=2) uniform highp uimage3D volume;
+        layout(std430,binding=0) buffer Results { uvec4 words[]; } result;
+        uniform uint phase;
+        uint fetch(highp uimage2D image) { return imageLoad(image,ivec2(0)).x; }
+        uint fetchArray(highp uimage2D images[1][2]) { return fetch(images[0][0]); }
+        void main() {
+            uint base=phase*4u;
+            result.words[base]=uvec4(imageSize(views[0][0]),imageSize(views[0][1]));
+            result.words[base+1u]=uvec4(fetchArray(views),fetch(views[0][1]),0u,0u);
+            imageStore(views[0][0],ivec2(0),uvec4(100u+phase));
+            imageStore(views[0][1],ivec2(0),uvec4(200u+phase));
+            memoryBarrierImage();
+            result.words[base+2u]=uvec4(fetch(views[0][0]),fetch(views[0][1]),
+                                      imageLoad(volume,ivec3(0,0,0)).x,
+                                      imageLoad(volume,ivec3(0,0,1)).x);
+            // Out-of-bounds stores must not cross into a neighboring volume slice.
+            imageStore(views[0][0],ivec2(0,2),uvec4(0xffffffffu));
+            result.words[base+3u]=uvec4(imageSize(volume),0u);
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(program, source);
+    GLProgram binary;
+    reloadProgram(program, binary);
+    GLTexture volume, planar;
+    glBindTexture(GL_TEXTURE_3D, volume);
+    glTexStorage3D(GL_TEXTURE_3D, 2, GL_R32UI, 4, 4, 4);
+    std::array<uint32_t, 8> initialVolume;
+    initialVolume.fill(11u);
+    std::fill(initialVolume.begin() + 4, initialVolume.end(), 22u);
+    glTexSubImage3D(GL_TEXTURE_3D, 1, 0, 0, 0, 2, 2, 2, GL_RED_INTEGER, GL_UNSIGNED_INT,
+                    initialVolume.data());
+    glBindTexture(GL_TEXTURE_2D, planar);
+    glTexStorage2D(GL_TEXTURE_2D, 1, GL_R32UI, 2, 2);
+    const std::array<uint32_t, 4> initialPlanar = {777u, 777u, 777u, 777u};
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 2, 2, GL_RED_INTEGER, GL_UNSIGNED_INT,
+                    initialPlanar.data());
+    GLBuffer allocation;
+    std::array<uint32_t, 256> expected;
+    expected.fill(0x13579bdfu);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(expected), expected.data(), GL_DYNAMIC_DRAW);
+    glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 0, allocation, 256, 7 * 64);
+    uint32_t slice0 = 11u, slice1 = 22u, plane = 777u;
+    for (uint32_t phase = 0; phase < 7; ++phase)
+    {
+        SCOPED_TRACE(phase);
+        const GLuint active = phase >= 5 ? binary : program;
+        glUseProgram(active);
+        glUniform1ui(glGetUniformLocation(active, "phase"), phase);
+        // Slice 1/0, 0/1, 1/1, planar/0, null/1, null/1, then deleted/null.
+        const bool firstNull       = phase >= 4;
+        const bool firstPlanar     = phase == 3;
+        const uint32_t firstSlice  = phase == 1 ? 0u : 1u;
+        const uint32_t secondSlice = (phase == 0 || phase == 3) ? 0u : 1u;
+        glBindImageTexture(0,
+                           firstNull     ? 0u
+                           : firstPlanar ? planar.get()
+                                         : volume.get(),
+                           firstPlanar ? 0 : 1, GL_FALSE, firstSlice, GL_READ_WRITE, GL_R32UI);
+        glBindImageTexture(1, volume, 1, GL_FALSE, secondSlice, GL_READ_WRITE, GL_R32UI);
+        glBindImageTexture(2, volume, 1, GL_TRUE, 0, GL_READ_WRITE, GL_R32UI);
+        const uint32_t before0 = firstNull     ? 0u
+                                 : firstPlanar ? plane
+                                 : firstSlice  ? slice1
+                                               : slice0;
+        const uint32_t before1 = secondSlice ? slice1 : slice0;
+        if (phase == 6)
+        {
+            volume.reset();
+            for (GLuint unit = 0; unit < 3; ++unit)
+            {
+                GLint name = -1;
+                glGetIntegeri_v(GL_IMAGE_BINDING_NAME, unit, &name);
+                EXPECT_EQ(name, 0);
+            }
+        }
+        glDispatchCompute(1, 1, 1);
+        glMemoryBarrier(GL_SHADER_IMAGE_ACCESS_BARRIER_BIT | GL_BUFFER_UPDATE_BARRIER_BIT);
+        ASSERT_GL_NO_ERROR();
+        if (phase < 6)
+        {
+            if (!firstNull)
+            {
+                if (firstPlanar)
+                {
+                    plane = 100u + phase;
+                }
+                else
+                {
+                    (firstSlice ? slice1 : slice0) = 100u + phase;
+                }
+            }
+            (secondSlice ? slice1 : slice0) = 200u + phase;
+        }
+        const size_t base                     = 64 + phase * 16;
+        const std::array<uint32_t, 16> record = {firstNull ? 0u : 2u,
+                                                 firstNull ? 0u : 2u,
+                                                 phase == 6 ? 0u : 2u,
+                                                 phase == 6 ? 0u : 2u,
+                                                 phase == 6 ? 0u : before0,
+                                                 phase == 6 ? 0u : before1,
+                                                 0u,
+                                                 0u,
+                                                 firstNull     ? 0u
+                                                 : firstPlanar ? plane
+                                                 : firstSlice  ? slice1
+                                                               : slice0,
+                                                 phase == 6    ? 0u
+                                                 : secondSlice ? slice1
+                                                               : slice0,
+                                                 phase == 6 ? 0u : slice0,
+                                                 phase == 6 ? 0u : slice1,
+                                                 phase == 6 ? 0u : 2u,
+                                                 phase == 6 ? 0u : 2u,
+                                                 phase == 6 ? 0u : 2u,
+                                                 0u};
+        std::copy(record.begin(), record.end(), expected.begin() + base);
+    }
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (size_t word = 0; word < expected.size(); ++word)
+    {
+        EXPECT_EQ(actual[word], expected[word]) << "result/guard word " << word;
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
