+void GenMetalTraverser::emitComputeImageInitialization(const TVariable &parameter)
+{
+    emitIndentation();
+    emitType(parameter.getType(), {});
+    mOut << " ";
+    emitNameOf(parameter);
+    mOut << ";\n";
+    size_t slot = 0;
+    for (const TField *field : parameter.getType().getStruct()->fields())
+    {
+        const TType &type     = *field->type();
+        const size_t elements = type.getArraySizeProduct();
+        for (size_t element = 0; element < elements; ++element)
+        {
+            std::string indices;
+            size_t remainder = element;
+            for (size_t dimension = type.getNumArraySizes(); dimension > 0; --dimension)
+            {
+                size_t stride = 1;
+                for (size_t inner = 0; inner + 1 < dimension; ++inner)
+                {
+                    stride *= type.getArraySizes()[inner];
+                }
+                indices += "[" + std::to_string(remainder / stride) + "]";
+                remainder %= stride;
+            }
+            auto emitMember = [&](bool native, bool volume) {
+                emitNameOf(parameter);
+                if (native)
+                {
+                    mOut << "_native";
+                }
+                mOut << ".";
+                emitNameOf(*field);
+                if (volume)
+                {
+                    mOut << "_volume";
+                }
+                mOut << indices;
+            };
+            emitIndentation();
+            emitMember(false, false);
+            mOut << " = ";
+            if (IsImage2D(type.getBasicType()))
+            {
+                mOut << "{";
+            }
+            emitMember(true, false);
+            if (IsImage2D(type.getBasicType()))
+            {
+                mOut << ", ";
+                emitMember(true, true);
+                mOut << ", ";
+                emitNameOf(parameter);
+                mOut << "_native.ANGLE_imageLayers[" << slot + element << "]}";
+            }
+            mOut << ";\n";
+        }
+        slot += elements;
+    }
+}
