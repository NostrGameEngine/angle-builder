+// Ordinary GLES 3.0 draws must use the specified provoking vertex even when
+// their topology or index representation needs emulation. The reference uses
+// independent primitive-list assembly, never the fan/loop backend being tested.
+TEST_P(IndirectCommandTestMetal, DirectPrimitiveConversionAndIncompleteDraws)
+{
+    ASSERT_TRUE(EnsureGLExtensionEnabled("GL_ANGLE_provoking_vertex"));
+    constexpr char vertex[]   = R"(#version 300 es
+        layout(location=0) in vec2 position;
+        uniform bool buffered;
+        flat out int identity;
+        void main() {
+            int i=(gl_VertexID==255 || gl_VertexID==65535) ? 11 : gl_VertexID;
+            vec2 p=vec2(float(i%4)*.5-.75,float((i/4)%4)*.5-.75);
+            gl_Position=vec4((buffered ? position : p)+vec2(float(gl_InstanceID)*.03,0),0,1);
+            gl_PointSize=1.; identity=i;
+        }
+    )";
+    constexpr char fragment[] = R"(#version 300 es
+        precision highp float;
+        flat in int identity;
+        out vec4 color;
+        void main() { color=vec4(float(identity&3)/3.,float((identity>>2)&3)/3.,1,.5); }
+    )";
+    ANGLE_GL_PROGRAM(program, vertex, fragment);
+    glUseProgram(program);
+    GLTexture color;
+    GLFramebuffer framebuffer;
+    glBindTexture(GL_TEXTURE_2D, color);
+    glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, 16, 16);
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, color, 0);
+    ASSERT_GLENUM_EQ(glCheckFramebufferStatus(GL_FRAMEBUFFER), GL_FRAMEBUFFER_COMPLETE);
+    glViewport(0, 0, 16, 16);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    glEnable(GL_CULL_FACE);
+    glCullFace(GL_BACK);
+    GLBuffer source, reference, vertices;
+    std::vector<float> positions(2 * 65536);
+    for (size_t index = 0; index < 65536; ++index)
+    {
+        const size_t identity    = (index == 255 || index == 65535) ? 11 : index;
+        positions[2 * index]     = float(identity % 4) * .5f - .75f;
+        positions[2 * index + 1] = float((identity / 4) % 4) * .5f - .75f;
+    }
+    glBindBuffer(GL_ARRAY_BUFFER, vertices);
+    glBufferData(GL_ARRAY_BUFFER, positions.size() * sizeof(float), positions.data(),
+                 GL_STATIC_DRAW);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, nullptr);
+    constexpr std::array<uint32_t, 14> pattern = {
+        UINT32_MAX, 1, 2, 3, UINT32_MAX, UINT32_MAX, 5, 6, 7, 8, UINT32_MAX, 9, 10, UINT32_MAX};
+    size_t compared = 0;
+    for (bool buffered : {false, true})
+    {
+        for (GLenum mode : {GL_POINTS, GL_LINES, GL_LINE_LOOP, GL_LINE_STRIP, GL_TRIANGLES,
+                            GL_TRIANGLE_STRIP, GL_TRIANGLE_FAN})
+        {
+            for (uint32_t representation = 0; representation < 7; ++representation)
+            {
+                for (bool restarting : {false, true})
+                {
+                    for (bool last : {false, true})
+                    {
+                        glUniform1i(glGetUniformLocation(program, "buffered"), buffered ? 1 : 0);
+                        if (buffered)
+                        {
+                            glEnableVertexAttribArray(0);
+                        }
+                        else
+                        {
+                            glDisableVertexAttribArray(0);
+                        }
+                        const bool arrays       = representation == 0;
+                        const bool client       = representation >= 4;
+                        const uint32_t width    = arrays ? 0u : 1u << ((representation - 1) % 3);
+                        const GLenum type       = width == 1   ? GL_UNSIGNED_BYTE
+                                                  : width == 2 ? GL_UNSIGNED_SHORT
+                                                               : GL_UNSIGNED_INT;
+                        const uint32_t sentinel = width == 1   ? 0xffu
+                                                  : width == 2 ? 0xffffu
+                                                               : UINT32_MAX;
+                        std::vector<uint32_t> input;
+                        const size_t prefix = client ? 3u : 3u * width;
+                        std::vector<uint8_t> bytes(prefix + 14 * width + 5, 0xcdu);
+                        for (size_t i = 0; i < pattern.size(); ++i)
+                        {
+                            uint32_t value = arrays ? static_cast<uint32_t>(i) + 3u : pattern[i];
+                            if (!arrays && value == UINT32_MAX)
+                            {
+                                value = restarting || width < 4 ? sentinel : 12u;
+                            }
+                            input.push_back(value);
+                            for (uint32_t byte = 0; byte < width; ++byte)
+                            {
+                                bytes[prefix + i * width + byte] =
+                                    static_cast<uint8_t>(value >> (8 * byte));
+                            }
+                        }
+                        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, source);
+                        glBufferData(GL_ELEMENT_ARRAY_BUFFER, bytes.size(), bytes.data(),
+                                     GL_STATIC_DRAW);
+                        for (GLsizei count : {0, 1, 2, 3, 4, 14})
+                        {
+                            for (GLsizei instances : {1, 2})
+                            {
+                                SCOPED_TRACE(testing::Message()
+                                             << "mode=" << mode << " buffered=" << buffered
+                                             << " source=" << representation
+                                             << " restart=" << restarting << " last=" << last
+                                             << " count=" << count << " instances=" << instances);
+                                std::vector<uint32_t> list, segment;
+                                auto emitSegment = [&]() {
+                                    auto line = [&](uint32_t a, uint32_t b) {
+                                        list.push_back(last ? b : a);
+                                        list.push_back(last ? a : b);
+                                    };
+                                    auto triangle = [&](uint32_t a, uint32_t b, uint32_t c,
+                                                        uint32_t provoking) {
+                                        const uint32_t vertices[3] = {a, b, c};
+                                        for (uint32_t corner = 0; corner < 3; ++corner)
+                                        {
+                                            list.push_back(vertices[(provoking + corner) % 3]);
+                                        }
+                                    };
+                                    for (size_t i = 0; i < segment.size(); ++i)
+                                    {
+                                        switch (mode)
+                                        {
+                                            case GL_POINTS:
+                                                list.push_back(segment[i]);
+                                                break;
+                                            case GL_LINES:
+                                                if (i % 2)
+                                                {
+                                                    line(segment[i - 1], segment[i]);
+                                                }
+                                                break;
+                                            case GL_LINE_LOOP:
+                                            case GL_LINE_STRIP:
+                                                if (i)
+                                                {
+                                                    line(segment[i - 1], segment[i]);
+                                                }
+                                                break;
+                                            case GL_TRIANGLES:
+                                                if (i % 3 == 2)
+                                                {
+                                                    triangle(segment[i - 2], segment[i - 1],
+                                                             segment[i], last ? 2u : 0u);
+                                                }
+                                                break;
+                                            case GL_TRIANGLE_STRIP:
+                                                if (i >= 2)
+                                                {
+                                                    triangle(segment[i % 2 ? i - 1 : i - 2],
+                                                             segment[i % 2 ? i - 2 : i - 1],
+                                                             segment[i],
+                                                             last    ? 2u
+                                                             : i % 2 ? 1u
+                                                                     : 0u);
+                                                }
+                                                break;
+                                            case GL_TRIANGLE_FAN:
+                                                if (i >= 2)
+                                                {
+                                                    triangle(segment[0], segment[i - 1], segment[i],
+                                                             last ? 2u : 1u);
+                                                }
+                                                break;
+                                        }
+                                    }
+                                    if (mode == GL_LINE_LOOP && segment.size() > 1)
+                                    {
+                                        line(segment.back(), segment.front());
+                                    }
+                                    segment.clear();
+                                };
+                                for (GLsizei i = 0; i < count; ++i)
+                                {
+                                    if (!arrays && restarting && input[i] == sentinel)
+                                    {
+                                        emitSegment();
+                                    }
+                                    else
+                                    {
+                                        segment.push_back(input[i]);
+                                    }
+                                }
+                                emitSegment();
+                                glDisable(GL_PRIMITIVE_RESTART_FIXED_INDEX);
+                                glProvokingVertexANGLE(GL_FIRST_VERTEX_CONVENTION_ANGLE);
+                                glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, reference);
+                                glBufferData(GL_ELEMENT_ARRAY_BUFFER,
+                                             std::max<size_t>(4, list.size() * 4),
+                                             list.empty() ? nullptr : list.data(), GL_STATIC_DRAW);
+                                glClearColor(0, 0, 1, 1);
+                                glClear(GL_COLOR_BUFFER_BIT);
+                                const GLenum nativeMode = mode == GL_POINTS      ? GL_POINTS
+                                                          : mode >= GL_TRIANGLES ? GL_TRIANGLES
+                                                                                 : GL_LINES;
+                                if (!list.empty())
+                                {
+                                    glDrawElementsInstanced(nativeMode, list.size(),
+                                                            GL_UNSIGNED_INT, nullptr, instances);
+                                }
+                                std::array<GLColor, 256> expected, actual;
+                                glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE,
+                                             expected.data());
+                                glClear(GL_COLOR_BUFFER_BIT);
+                                if (restarting)
+                                {
+                                    glEnable(GL_PRIMITIVE_RESTART_FIXED_INDEX);
+                                }
+                                glProvokingVertexANGLE(last ? GL_LAST_VERTEX_CONVENTION_ANGLE
+                                                            : GL_FIRST_VERTEX_CONVENTION_ANGLE);
+                                glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, client ? 0u : source.get());
+                                if (arrays)
+                                {
+                                    glDrawArraysInstanced(mode, 3, count, instances);
+                                }
+                                else
+                                {
+                                    glDrawElementsInstanced(
+                                        mode, count, type,
+                                        client ? static_cast<const void *>(bytes.data() + prefix)
+                                               : reinterpret_cast<const void *>(prefix),
+                                        instances);
+                                }
+                                ASSERT_GL_NO_ERROR();
+                                glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE,
+                                             actual.data());
+                                ASSERT_EQ(actual, expected);
+                                ++compared;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    RecordProperty("ComparedDirectFrames", compared);
+    EXPECT_EQ(compared, 4704u);
+}
