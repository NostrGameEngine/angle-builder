+angle::Result ContextMtl::drawConvertedDirect(const gl::Context *context,
+                                              gl::PrimitiveMode mode,
+                                              GLint first,
+                                              GLsizei count,
+                                              gl::DrawElementsType type,
+                                              const void *indices,
+                                              GLsizei instances,
+                                              GLint baseVertex,
+                                              GLuint baseInstance)
+{
+    ASSERT(!getState().isTransformFeedbackActiveUnpaused());
+    const bool arrays = type == gl::DrawElementsType::InvalidEnum;
+    const auto *elementBuffer =
+        arrays ? nullptr : getState().getVertexArray()->getElementArrayBuffer();
+    const size_t indexBytes        = arrays ? 0 : size_t(count) * gl::GetDrawElementsTypeSize(type);
+    const size_t clientBytes       = !arrays && !elementBuffer ? indexBytes : 0;
+    constexpr size_t kCommandBytes = 5 * sizeof(uint32_t);
+    mtl::BufferSlice packet;
+    mLineLoopLastSegmentIndexBuffer.releaseInFlightBuffers(this);
+    ANGLE_TRY(mLineLoopLastSegmentIndexBuffer.allocate(this, kCommandBytes + clientBytes, &packet));
+    auto upload = packet.buffer()->mapWithOpt(this, false, true, packet.offset(),
+                                              kCommandBytes + clientBytes);
+    const std::array<uint32_t, 5> command = {
+        static_cast<uint32_t>(count), static_cast<uint32_t>(instances ? instances : 1), 0,
+        static_cast<uint32_t>(arrays ? first : baseVertex), baseInstance};
+    std::memcpy(upload.data(), command.data(), kCommandBytes);
+    if (clientBytes)
+    {
+        std::memcpy(upload.data() + kCommandBytes, indices, clientBytes);
+    }
+    packet.buffer()->unmap(this);
+    ANGLE_TRY(mLineLoopLastSegmentIndexBuffer.commit(this));
+
+    mtl::BufferRef source = packet.buffer();
+    size_t offset         = packet.offset() + kCommandBytes;
+    size_t available      = arrays ? size_t(count) : clientBytes;
+    if (elementBuffer)
+    {
+        const auto *buffer = mtl::GetImpl(elementBuffer);
+        source             = buffer->getCurrentBuffer();
+        offset             = reinterpret_cast<uintptr_t>(indices);
+        available = offset <= buffer->size() ? std::min(indexBytes, buffer->size() - offset) : 0;
+    }
+    mtl::BufferSlice converted;
+    ANGLE_TRY(prepareIndexedIndirectConversion(mode, type, packet.buffer(), packet.offset(), source,
+                                               available, &converted, offset));
+    bool noOp = false;
+    // Attribute streaming/conversion must see the original API range, not the
+    // generated list. Transform feedback retains its existing dedicated path.
+    ANGLE_TRY(setupDraw(context, first, count, instances, type, indices, false, &noOp));
+    if (!noOp)
+    {
+        const MTLPrimitiveType primitive = mode == gl::PrimitiveMode::Points ? MTLPrimitiveTypePoint
+                                           : gl::IsPolygonMode(mode) ? MTLPrimitiveTypeTriangle
+                                                                     : MTLPrimitiveTypeLine;
+        mRenderEncoder.drawIndexedIndirect(primitive, MTLIndexTypeUInt32, converted.buffer(),
+                                           converted.offset() + 8 * sizeof(uint32_t),
+                                           converted.buffer(), converted.offset());
+    }
+    return angle::Result::Continue;
+}
