+class GraphicsPipelineTestMetal : public ComputeDispatchTestMetal
+{};
+
+// Keep mutable uniforms, bindings and conversion ranges with the installed
+// stage owner, including one program shared by both stages and queued deletion.
+TEST_P(GraphicsPipelineTestMetal, GPUUniformConversionsStageOwnershipAndBinary)
+{
+    constexpr char vertex[]   = R"(#version 310 es
+        precision highp float;
+        layout(std140) uniform Params {
+            layout(row_major) mat2x3 basis; bvec3 enabled; vec4 color;
+        } data;
+        uniform float factor;
+        layout(location=0) out vec4 carrier;
+        layout(location=3) out mat2x3 matrices[2];
+        void main() {
+            vec2 p=gl_VertexID==0 ? vec2(-1,-1) : gl_VertexID==1 ? vec2(3,-1) : vec2(-1,3);
+            bool valid=all(equal(data.enabled,bvec3(true,false,true))) &&
+                all(equal(data.basis[0],vec3(1,2,3))) && all(equal(data.basis[1],vec3(4,5,6)));
+            gl_Position=vec4(valid ? p : vec2(4),0,1);
+            carrier=data.color*factor;
+            matrices[0]=data.basis; matrices[1]=data.basis*2.;
+        }
+    )";
+    constexpr char fragment[] = R"(#version 310 es
+        precision highp float;
+        layout(std140) uniform Params {
+            layout(row_major) mat2x3 basis; bvec3 enabled; vec4 color;
+        } data;
+        uniform float factor;
+        layout(location=0) in vec4 payload;
+        layout(location=3) in mat2x3 received[2];
+        out vec4 color;
+        void main() {
+            bool valid=all(equal(data.enabled,bvec3(true,false,true)));
+            for(int m=0;m<2;++m) for(int c=0;c<2;++c)
+                valid=valid && all(equal(received[m][c],data.basis[c]*float(m+1)));
+            color=valid ? vec4(payload.rgb*data.color.rgb*factor,1) : vec4(1,0,0,1);
+        }
+    )";
+    constexpr char producer[] = R"(#version 310 es
+        precision highp float;
+        layout(local_size_x=1) in;
+        layout(std430,binding=0) buffer Allocation { uint words[]; } data;
+        uniform vec4 colors[3];
+        void put(uint index,float value) { data.words[index]=floatBitsToUint(value); }
+        void block(uint base,vec4 color) {
+            put(base,1.); put(base+1u,4.); put(base+4u,2.); put(base+5u,5.);
+            put(base+8u,3.); put(base+9u,6.);
+            data.words[base+12u]=0x80000000u; data.words[base+13u]=0u;
+            data.words[base+14u]=0x01000000u;
+            for(uint lane=0u;lane<4u;++lane) put(base+16u+lane,color[lane]);
+        }
+        void main() { block(64u,colors[0]); block(192u,colors[1]); block(320u,colors[2]); }
+    )";
+    auto link                 = [&](GLProgram &program, const char *vs, const char *fs) {
+        glProgramParameteri(program, GL_PROGRAM_SEPARABLE, GL_TRUE);
+        for (const auto &stage : std::array<std::pair<GLenum, const char *>, 2>{
+                 {{GL_VERTEX_SHADER, vs}, {GL_FRAGMENT_SHADER, fs}}})
+        {
+            if (!stage.second)
+            {
+                continue;
+            }
+            GLShader shader(stage.first);
+            glShaderSource(shader, 1, &stage.second, nullptr);
+            glCompileShader(shader);
+            GLint compiled = GL_FALSE;
+            glGetShaderiv(shader, GL_COMPILE_STATUS, &compiled);
+            ASSERT_EQ(compiled, GL_TRUE);
+            glAttachShader(program, shader);
+        }
+        glLinkProgram(program);
+        GLint linked = GL_FALSE;
+        glGetProgramiv(program, GL_LINK_STATUS, &linked);
+        ASSERT_EQ(linked, GL_TRUE);
+        ASSERT_GL_NO_ERROR();
+    };
+    GLProgram vs, fs, both, vsBinary, fsBinary, bothBinary;
+    ASSERT_NO_FATAL_FAILURE(link(vs, vertex, nullptr));
+    ASSERT_NO_FATAL_FAILURE(link(fs, nullptr, fragment));
+    ASSERT_NO_FATAL_FAILURE(link(both, vertex, fragment));
+    for (GLProgram *destination : {&vsBinary, &fsBinary, &bothBinary})
+    {
+        glProgramParameteri(*destination, GL_PROGRAM_SEPARABLE, GL_TRUE);
+    }
+    ASSERT_NO_FATAL_FAILURE(reloadProgram(vs, vsBinary));
+    ASSERT_NO_FATAL_FAILURE(reloadProgram(fs, fsBinary));
+    ASSERT_NO_FATAL_FAILURE(reloadProgram(both, bothBinary));
+    ANGLE_GL_COMPUTE_PROGRAM(produce, producer);
+    GLBuffer allocation;
+    std::array<uint32_t, 512> expected;
+    expected.fill(0xcdcdcdcdu);
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(expected), expected.data(), GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, allocation);
+    GLProgramPipeline pipeline;
+    glBindProgramPipeline(pipeline);
+    std::array<float, 12> colors;
+    for (uint32_t phase = 0; phase < 8; ++phase)
+    {
+        SCOPED_TRACE(phase);
+        colors = {
+            .25f + .0625f * phase, .5f,  .75f, 1.f, .5f, 1.f, .25f + .0625f * phase, 1.f, .25f,
+            .5f + .03125f * phase, .75f, 1.f};
+        glUseProgram(produce);
+        glUniform4fv(glGetUniformLocation(produce, "colors[0]"), 3, colors.data());
+        glDispatchCompute(1, 1, 1);
+        glMemoryBarrier(GL_UNIFORM_BARRIER_BIT | GL_BUFFER_UPDATE_BARRIER_BIT);
+        GLProgram *vertexOwner   = phase >= 3 ? &vsBinary : &vs;
+        GLProgram *fragmentOwner = phase >= 2 ? &fsBinary : &fs;
+        if (phase == 4 || phase == 5)
+        {
+            vertexOwner = fragmentOwner = &both;
+        }
+        if (phase == 6)
+        {
+            vertexOwner = fragmentOwner = &bothBinary;
+        }
+        const bool shared            = vertexOwner == fragmentOwner;
+        const GLuint vertexBinding   = shared ? (phase == 6 ? 13u : 5u) : phase >= 3 ? 11u : 3u;
+        const GLuint fragmentBinding = shared ? vertexBinding : phase >= 2 ? 9u : 7u;
+        // Leave old bindings pointing at a different color to expose stale maps.
+        for (GLuint binding : {3u, 7u, 5u})
+        {
+            glBindBufferRange(GL_UNIFORM_BUFFER, binding, allocation, 1280, 80);
+        }
+        glBindBufferRange(GL_UNIFORM_BUFFER, vertexBinding, allocation, shared ? 1280 : 256, 80);
+        glBindBufferRange(GL_UNIFORM_BUFFER, fragmentBinding, allocation, shared ? 1280 : 768, 80);
+        const float vertexFactor   = phase == 1 || phase == 6 ? .5f : 1.f;
+        const float fragmentFactor = shared ? vertexFactor : 1.f;
+        glUniformBlockBinding(*vertexOwner, glGetUniformBlockIndex(*vertexOwner, "Params"),
+                              vertexBinding);
+        glUniformBlockBinding(*fragmentOwner, glGetUniformBlockIndex(*fragmentOwner, "Params"),
+                              fragmentBinding);
+        glProgramUniform1f(*vertexOwner, glGetUniformLocation(*vertexOwner, "factor"),
+                           vertexFactor);
+        glProgramUniform1f(*fragmentOwner, glGetUniformLocation(*fragmentOwner, "factor"),
+                           fragmentFactor);
+        glUseProgramStages(pipeline, GL_VERTEX_SHADER_BIT, *vertexOwner);
+        glUseProgramStages(pipeline, GL_FRAGMENT_SHADER_BIT, *fragmentOwner);
+        glUseProgram(0);
+        if (phase == 3)
+        {
+            glActiveShaderProgram(pipeline, fs);
+            glUniform1f(glGetUniformLocation(fs, "factor"), 9.f);
+        }
+        if (phase == 5)
+        {
+            glUseProgram(both);
+            glDrawArrays(GL_TRIANGLES, 0, 3);
+            glUseProgram(0);
+        }
+        if (phase == 7)
+        {
+            glActiveShaderProgram(pipeline, 0);
+            vsBinary.reset();
+            fsBinary.reset();
+            vs.reset();
+            fs.reset();
+        }
+        glClearColor(1, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        ASSERT_GL_NO_ERROR();
+        GLColor expectedPixel(0, 0, 0, 255);
+        for (size_t lane = 0; lane < 3; ++lane)
+        {
+            const float a       = colors[(shared ? 8 : 0) + lane] * vertexFactor;
+            const float b       = colors[(shared ? 8 : 4) + lane] * fragmentFactor;
+            expectedPixel[lane] = static_cast<GLubyte>(std::lround(a * b * 255.f));
+        }
+        EXPECT_PIXEL_COLOR_NEAR(8, 8, expectedPixel, 1);
+    }
+    auto word = [](float value) {
+        uint32_t bits;
+        std::memcpy(&bits, &value, 4);
+        return bits;
+    };
+    for (size_t block = 0; block < 3; ++block)
+    {
+        const size_t base = 64 + 128 * block;
+        for (size_t row = 0; row < 3; ++row)
+        {
+            expected[base + 4 * row]     = word(float(row + 1));
+            expected[base + 4 * row + 1] = word(float(row + 4));
+        }
+        expected[base + 12] = 0x80000000u;
+        expected[base + 13] = 0u;
+        expected[base + 14] = 0x01000000u;
+        for (size_t lane = 0; lane < 4; ++lane)
+        {
+            expected[base + 16 + lane] = word(colors[4 * block + lane]);
+        }
+    }
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, allocation);
+    const auto *actual = static_cast<const uint32_t *>(
+        glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+    ASSERT_NE(actual, nullptr);
+    for (size_t index = 0; index < expected.size(); ++index)
+    {
+        EXPECT_EQ(actual[index], expected[index]) << "source/padding/guard word " << index;
+    }
+    EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    ASSERT_GL_NO_ERROR();
+}
