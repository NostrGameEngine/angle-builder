+ProgramExecutableMtl *ProgramExecutableMtl::getGraphicsStageOwner(gl::ShaderType stage) const
+{
+    if (!mExecutable->IsPPO())
+    {
+        return const_cast<ProgramExecutableMtl *>(this);
+    }
+    const auto &component = mExecutable->getPPOProgramExecutables()[stage];
+    return component ? mtl::GetImpl(component.get()) : nullptr;
+}
+
+bool ProgramExecutableMtl::hasFlatAttribute() const
+{
+    const auto *vertex = getGraphicsStageOwner(gl::ShaderType::Vertex);
+    return vertex && vertex->mProgramHasFlatAttributes;
+}
+
+angle::Result ProgramExecutableMtl::setupPipelineDraw(const gl::Context *glContext,
+                                                      mtl::RenderCommandEncoder *encoder,
+                                                      const mtl::RenderPipelineDesc &pipelineDesc,
+                                                      bool pipelineDescChanged,
+                                                      bool forceTexturesSetting,
+                                                      bool uniformBuffersDirty)
+{
+    auto *context  = mtl::GetImpl(glContext);
+    auto *vertex   = getGraphicsStageOwner(gl::ShaderType::Vertex);
+    auto *fragment = getGraphicsStageOwner(gl::ShaderType::Fragment);
+    if (pipelineDescChanged)
+    {
+        id<MTLFunction> vertexFunction = nil, fragmentFunction = nil;
+        if (vertex)
+        {
+            ANGLE_TRY(vertex->getSpecializedShader(context, gl::ShaderType::Vertex, pipelineDesc,
+                                                   &vertexFunction));
+            vertex->mCurrentShaderVariants[gl::ShaderType::Vertex] =
+                &vertex->mVertexShaderVariants[pipelineDesc.getRasterizationType()];
+            vertex->mDefaultUniformBlocksDirty.set(gl::ShaderType::Vertex);
+            vertex->mSamplerBindingsDirty.set(gl::ShaderType::Vertex);
+        }
+        if (fragment)
+        {
+            ANGLE_TRY(fragment->getSpecializedShader(context, gl::ShaderType::Fragment,
+                                                     pipelineDesc, &fragmentFunction));
+            const bool multisampled = pipelineDesc.outputDescriptor.getRasterSampleCount() > 1;
+            const bool depthWrite = pipelineDesc.outputDescriptor.getDepthAttachmentPixelFormat() !=
+                                    MTLPixelFormatInvalid;
+            fragment->mCurrentShaderVariants[gl::ShaderType::Fragment] =
+                pipelineDesc.rasterizationEnabled()
+                    ? &fragment
+                           ->mFragmentShaderVariants[PipelineParametersToFragmentShaderVariantIndex(
+                               multisampled, depthWrite)]
+                    : nullptr;
+            fragment->mDefaultUniformBlocksDirty.set(gl::ShaderType::Fragment);
+            fragment->mSamplerBindingsDirty.set(gl::ShaderType::Fragment);
+        }
+        angle::ObjCPtr<id<MTLRenderPipelineState>> pipeline;
+        ANGLE_TRY(context->getPipelineCache().getRenderPipeline(
+            context, vertexFunction, fragmentFunction, pipelineDesc, &pipeline));
+        encoder->setRenderPipelineState(pipeline);
+    }
+    for (gl::ShaderType stage : {gl::ShaderType::Vertex, gl::ShaderType::Fragment})
+    {
+        if (auto *owner = getGraphicsStageOwner(stage))
+        {
+            ANGLE_TRY(owner->commitUniforms(context, encoder, stage));
+            ANGLE_TRY(owner->updateTextures(glContext, encoder, forceTexturesSetting, stage));
+        }
+    }
+    if (uniformBuffersDirty || pipelineDescChanged)
+    {
+        if (vertex && vertex == fragment)
+        {
+            // The first call consumes/clears the prepared range vector. A program
+            // installed in both stages must therefore bind both in one call.
+            ANGLE_TRY(vertex->updateUniformBuffers(context, encoder, pipelineDesc));
+        }
+        else
+        {
+            for (gl::ShaderType stage : {gl::ShaderType::Vertex, gl::ShaderType::Fragment})
+            {
+                if (auto *owner = getGraphicsStageOwner(stage))
+                {
+                    ANGLE_TRY(owner->updateUniformBuffers(context, encoder, pipelineDesc, stage));
+                }
+            }
+        }
+    }
+    if (pipelineDescChanged && vertex)
+    {
+        ANGLE_TRY(vertex->updateXfbBuffers(context, encoder, pipelineDesc));
+    }
+    return angle::Result::Continue;
+}
