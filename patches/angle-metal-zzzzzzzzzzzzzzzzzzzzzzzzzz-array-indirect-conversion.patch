+ANGLE_ALWAYS_INLINE uint ANGLE_arrayVertexID(uint nativeID, const device uint *command)
+{
+    const uint first = command[0], count = command[1], mode = command[2];
+    const uint flags = command[3], base = command[4];
+    const bool last = (flags & 2u) != 0u, provoking = (flags & 4u) != 0u;
+    const uint width = mode >= 4u ? 3u : 2u;
+    const uint primitive = base + nativeID / width;
+    uint corner = nativeID % width;
+    uint index = 0u;
+    if (mode == 6u) // fan: origin, i+1, i+2
+    {
+        corner = (corner + (last ? 2u : provoking ? 1u : 0u)) % 3u;
+        index = corner == 0u ? 0u : primitive + corner;
+    }
+    else if (mode == 5u) // strip: retain parity and the provoking identity
+    {
+        const bool odd = (primitive & 1u) != 0u;
+        corner = (corner + (last ? 2u : provoking && odd ? 1u : 0u)) % 3u;
+        index = primitive + (corner == 2u ? 2u : odd ? 1u-corner : corner);
+    }
+    else if (mode == 4u)
+        index = 3u*primitive + (corner + (last ? 2u : 0u)) % 3u;
+    else
+    {
+        corner = (corner + (last ? 1u : 0u)) % 2u;
+        index = mode == 1u ? 2u*primitive + corner : primitive + corner;
+        if (mode == 2u && index == count) index = 0u;
+    }
+    return first + index;
+}
