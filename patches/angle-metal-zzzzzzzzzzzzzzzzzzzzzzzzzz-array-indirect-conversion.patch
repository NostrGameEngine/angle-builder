+angle::Result ContextMtl::prepareProceduralArrayDraw(gl::PrimitiveMode mode,
+                                                     const mtl::BufferRef &arguments,
+                                                     size_t argumentOffset,
+                                                     mtl::BufferSlice *packet)
+{
+    if (!mProceduralArrayDrawFunction)
+    {
+        mtl::TranslatedShaderInfo shader;
+        shader.metalShaderSource = std::make_shared<const std::string>(R"(
+#include <metal_stdlib>
+using namespace metal;
+kernel void main0(const device uint *source [[buffer(0)]],
+                  device uint *packet [[buffer(1)]], constant uint2 &params [[buffer(2)]])
+{
+    const uint mode = params.x;
+    // MAX_ELEMENT_INDEX is UINT_MAX-1. Only out-of-range commands are clamped.
+    const uint count = min(source[0], 0xffffffffu-source[2]);
+    const uint width = mode >= 4u ? 3u : 2u;
+    const uint primitives = mode == 1u ? count/2u : mode == 4u ? count/3u :
+                            mode == 3u ? (count > 1u ? count-1u : 0u) :
+                            mode == 2u ? (count > 1u ? count : 0u) :
+                                         (count > 2u ? count-2u : 0u);
+    const uint maximum = 0xffffffffu/width;
+    for (uint batch=0u; batch<3u; ++batch)
+    {
+        const uint base = batch*maximum;
+        const uint batchCount = base < primitives ? min(primitives-base,maximum) : 0u;
+        packet[batch*4u] = batchCount*width;
+        packet[batch*4u+1u] = source[1];
+        packet[batch*4u+2u] = 0u;
+        packet[batch*4u+3u] = source[3];
+        const uint meta = 16u+batch*8u;
+        packet[meta] = source[2];
+        packet[meta+1u] = count;
+        packet[meta+2u] = mode;
+        packet[meta+3u] = params.y;
+        packet[meta+4u] = base;
+    }
+}
+)");
+        gl::InfoLog log;
+        ANGLE_TRY(CreateMslShaderLib(this, log, &shader, {}));
+        mProceduralArrayDrawFunction =
+            angle::adoptObjCPtr([shader.metalLibrary.get() newFunctionWithName:@"main0"]);
+        ANGLE_CHECK(this, mProceduralArrayDrawFunction, "Missing procedural array kernel",
+                    GL_INVALID_OPERATION);
+    }
+    angle::ObjCPtr<id<MTLComputePipelineState>> pipeline;
+    ANGLE_TRY(
+        getPipelineCache().getComputePipeline(this, mProceduralArrayDrawFunction.get(), &pipeline));
+    constexpr size_t bytes = 160;
+    if (!mIndirectIndexConversionBuffer || mIndirectIndexConversionBuffer->size() < bytes)
+    {
+        ANGLE_TRY(mtl::Buffer::MakeBufferWithStorageMode(this, MTLStorageModePrivate, bytes,
+                                                         &mIndirectIndexConversionBuffer));
+    }
+    *packet        = mtl::BufferSlice(mIndirectIndexConversionBuffer);
+    uint32_t flags = 0;
+    if (mExecutable->hasFlatAttribute())
+    {
+        flags =
+            getState().getProvokingVertex() == gl::ProvokingVertexConvention::LastVertexConvention
+                ? 2u
+                : 4u;
+    }
+    const std::array<uint32_t, 2> params = {gl::ToGLenum(mode), flags};
+    auto *encoder                        = getComputeCommandEncoder();
+    encoder->setComputePipelineState(pipeline.get());
+    encoder->setBuffer(arguments, argumentOffset, 0);
+    encoder->setBufferForWrite(packet->buffer(), packet->offset(), 1);
+    encoder->setData(params, 2);
+    encoder->dispatch(MTLSizeMake(1, 1, 1), MTLSizeMake(1, 1, 1));
+    return angle::Result::Continue;
+}
