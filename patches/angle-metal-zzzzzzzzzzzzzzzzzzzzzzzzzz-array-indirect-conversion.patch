+// GPU array commands have no CPU-readable count. Compare primitive conversion
+// against independent list assembly for finite and unbounded attribute layouts.
+TEST_P(ComputeDispatchTestMetal, GPUArrayPrimitiveConversionAndAttributeBounds)
+{
+    ASSERT_TRUE(EnsureGLExtensionEnabled("GL_EXT_multi_draw_indirect"));
+    ASSERT_TRUE(EnsureGLExtensionEnabled("GL_ANGLE_provoking_vertex"));
+    constexpr char producer[] = R"(#version 310 es
+        layout(local_size_x=1) in;
+        layout(std430,binding=0) buffer Commands { uint words[]; } commands;
+        uniform uint base, count, instances, stride, multi;
+        void main() {
+            for(uint draw=0u;draw<1u+multi;++draw) {
+                uint at=base+draw*stride;
+                commands.words[at]=count; commands.words[at+1u]=instances;
+                commands.words[at+2u]=3u+8u*draw; commands.words[at+3u]=0u;
+            }
+        }
+    )";
+    constexpr char vertex[]   = R"(#version 310 es
+        layout(location=0) in vec2 position;
+        uniform int fetchMode;
+        flat out int identity;
+        void main() {
+            int i=gl_VertexID;
+            vec2 p=vec2(float(i%4)*.5-.75,float((i/4)%4)*.5-.75);
+            p=fetchMode==1 ? position : p+(fetchMode>1 ? position : vec2(0));
+            gl_Position=vec4(p+vec2(float(gl_InstanceID)*.03,0),0,1);
+            gl_PointSize=1.; identity=i;
+        }
+    )";
+    constexpr char fragment[] = R"(#version 310 es
+        precision highp float;
+        flat in int identity;
+        out vec4 color;
+        void main() { color=vec4(float(identity&3)/3.,float((identity>>2)&3)/3.,1,.5); }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(compute, producer);
+    ANGLE_GL_PROGRAM(render, vertex, fragment);
+    GLProgram binary;
+    reloadProgram(render, binary);
+    GLVertexArray vao;
+    glBindVertexArray(vao);
+    GLBuffer positions, offsets, commands, minimal, reference;
+    std::array<float, 128> points;
+    for (size_t i = 0; i < 64; ++i)
+    {
+        points[2 * i]     = float(i % 4) * .5f - .75f;
+        points[2 * i + 1] = float((i / 4) % 4) * .5f - .75f;
+    }
+    glBindBuffer(GL_ARRAY_BUFFER, positions);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(points), points.data(), GL_STATIC_DRAW);
+    const std::array<float, 4> displacement = {0.f, 0.f, .0625f, .03125f};
+    glBindBuffer(GL_ARRAY_BUFFER, offsets);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(displacement), displacement.data(), GL_STATIC_DRAW);
+    glVertexAttribFormat(0, 2, GL_FLOAT, GL_FALSE, 0);
+    glVertexAttribBinding(0, 0);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    glEnable(GL_CULL_FACE);
+    glCullFace(GL_BACK);
+    size_t compared = 0;
+    for (GLenum mode : {GL_POINTS, GL_LINES, GL_LINE_LOOP, GL_LINE_STRIP, GL_TRIANGLES,
+                        GL_TRIANGLE_STRIP, GL_TRIANGLE_FAN})
+    {
+        for (int fetchMode = 0; fetchMode < 4; ++fetchMode)
+        {
+            for (bool last : {false, true})
+            {
+                for (bool restarting : {false, true})
+                {
+                    for (uint32_t scenario = 0; scenario < 9; ++scenario)
+                    {
+                        SCOPED_TRACE(testing::Message() << "mode=" << mode << " fetch=" << fetchMode
+                                                        << " last=" << last << " restart="
+                                                        << restarting << " scenario=" << scenario);
+                        const uint32_t count     = scenario == 3   ? 0u
+                                                   : scenario == 4 ? 1u
+                                                   : scenario == 5 ? 2u
+                                                   : scenario == 6 ? 3u
+                                                   : scenario == 7 ? 4u
+                                                                   : 14u;
+                        const uint32_t instances = scenario == 8 ? 0u : scenario >= 4 ? 1u : 2u;
+                        const bool multi         = scenario == 1 || scenario == 2;
+                        const uint32_t stride    = scenario == 2 ? 8u : 4u;
+                        const uint32_t base      = scenario == 0 ? 0u : 64u;
+                        const GLuint active      = (scenario & 1u) ? binary.get() : render.get();
+                        glUseProgram(active);
+                        glUniform1i(glGetUniformLocation(active, "fetchMode"), fetchMode);
+                        if (fetchMode == 0)
+                        {
+                            glDisableVertexAttribArray(0);
+                        }
+                        else
+                        {
+                            glEnableVertexAttribArray(0);
+                        }
+                        glBindVertexBuffer(0, fetchMode == 1 ? positions.get() : offsets.get(),
+                                           fetchMode == 3 ? 8 : 0, fetchMode == 3 ? 0 : 8);
+                        glVertexBindingDivisor(0, fetchMode == 2 ? 1 : 0);
+                        glDisable(GL_PRIMITIVE_RESTART_FIXED_INDEX);
+                        glProvokingVertexANGLE(GL_FIRST_VERTEX_CONVENTION_ANGLE);
+                        glClearColor(0, 0, 1, 1);
+                        glClear(GL_COLOR_BUFFER_BIT);
+                        for (uint32_t draw = 0; draw < 1u + uint32_t(multi); ++draw)
+                        {
+                            std::vector<uint32_t> list;
+                            const uint32_t first = 3u + 8u * draw;
+                            auto line            = [&](uint32_t a, uint32_t b) {
+                                list.push_back(first + (last ? b : a));
+                                list.push_back(first + (last ? a : b));
+                            };
+                            auto triangle = [&](uint32_t a, uint32_t b, uint32_t c,
+                                                uint32_t provoking) {
+                                const uint32_t values[3] = {a, b, c};
+                                for (uint32_t corner = 0; corner < 3; ++corner)
+                                {
+                                    list.push_back(first + values[(provoking + corner) % 3]);
+                                }
+                            };
+                            for (uint32_t i = 0; i < count; ++i)
+                            {
+                                switch (mode)
+                                {
+                                    case GL_POINTS:
+                                        list.push_back(first + i);
+                                        break;
+                                    case GL_LINES:
+                                        if (i % 2)
+                                        {
+                                            line(i - 1, i);
+                                        }
+                                        break;
+                                    case GL_LINE_STRIP:
+                                    case GL_LINE_LOOP:
+                                        if (i)
+                                        {
+                                            line(i - 1, i);
+                                        }
+                                        break;
+                                    case GL_TRIANGLES:
+                                        if (i % 3 == 2)
+                                        {
+                                            triangle(i - 2, i - 1, i, last ? 2u : 0u);
+                                        }
+                                        break;
+                                    case GL_TRIANGLE_STRIP:
+                                        if (i >= 2)
+                                        {
+                                            triangle(i % 2 ? i - 1 : i - 2, i % 2 ? i - 2 : i - 1,
+                                                     i,
+                                                     last    ? 2u
+                                                     : i % 2 ? 1u
+                                                             : 0u);
+                                        }
+                                        break;
+                                    case GL_TRIANGLE_FAN:
+                                        if (i >= 2)
+                                        {
+                                            triangle(0, i - 1, i, last ? 2u : 1u);
+                                        }
+                                        break;
+                                }
+                            }
+                            if (mode == GL_LINE_LOOP && count >= 2)
+                            {
+                                line(count - 1, 0);
+                            }
+                            glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, reference);
+                            glBufferData(GL_ELEMENT_ARRAY_BUFFER,
+                                         std::max<size_t>(4, list.size() * 4),
+                                         list.empty() ? nullptr : list.data(), GL_STATIC_DRAW);
+                            const GLenum nativeMode = mode == GL_POINTS      ? GL_POINTS
+                                                      : mode >= GL_TRIANGLES ? GL_TRIANGLES
+                                                                             : GL_LINES;
+                            if (!list.empty() && instances)
+                            {
+                                glDrawElementsInstanced(nativeMode, list.size(), GL_UNSIGNED_INT,
+                                                        nullptr, instances);
+                            }
+                        }
+                        std::array<GLColor, 256> expectedPixels, actualPixels;
+                        glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE,
+                                     expectedPixels.data());
+                        ASSERT_GL_NO_ERROR();
+                        std::vector<uint32_t> expectedWords(scenario == 0 ? 4u : 128u, 0xcdcdcdcdu);
+                        for (uint32_t draw = 0; draw < 1u + uint32_t(multi); ++draw)
+                        {
+                            const uint32_t at     = base + draw * stride;
+                            expectedWords[at]     = count;
+                            expectedWords[at + 1] = instances;
+                            expectedWords[at + 2] = 3u + 8u * draw;
+                            expectedWords[at + 3] = 0;
+                        }
+                        const GLuint arguments = scenario == 0 ? minimal.get() : commands.get();
+                        glBindBuffer(GL_DRAW_INDIRECT_BUFFER, arguments);
+                        std::vector<uint32_t> initial(expectedWords.size(), 0xcdcdcdcdu);
+                        glBufferData(GL_DRAW_INDIRECT_BUFFER, initial.size() * 4, initial.data(),
+                                     GL_DYNAMIC_DRAW);
+                        glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, arguments);
+                        glUseProgram(compute);
+                        for (const auto &uniform : std::array<std::pair<const char *, uint32_t>, 5>{
+                                 {{"base", base},
+                                  {"count", count},
+                                  {"instances", instances},
+                                  {"stride", stride},
+                                  {"multi", multi ? 1u : 0u}}})
+                        {
+                            glUniform1ui(glGetUniformLocation(compute, uniform.first),
+                                         uniform.second);
+                        }
+                        glDispatchCompute(1, 1, 1);
+                        glMemoryBarrier(GL_COMMAND_BARRIER_BIT | GL_BUFFER_UPDATE_BARRIER_BIT);
+                        // No host readback between command production and the actual draw.
+                        glUseProgram(active);
+                        glProvokingVertexANGLE(last ? GL_LAST_VERTEX_CONVENTION_ANGLE
+                                                    : GL_FIRST_VERTEX_CONVENTION_ANGLE);
+                        if (restarting)
+                        {
+                            glEnable(GL_PRIMITIVE_RESTART_FIXED_INDEX);
+                        }
+                        glClear(GL_COLOR_BUFFER_BIT);
+                        if (multi)
+                        {
+                            glMultiDrawArraysIndirectEXT(
+                                mode, reinterpret_cast<const void *>(base * 4), 2, stride * 4);
+                        }
+                        else
+                        {
+                            glDrawArraysIndirect(mode, reinterpret_cast<const void *>(base * 4));
+                        }
+                        ASSERT_GL_NO_ERROR();
+                        glReadPixels(0, 0, 16, 16, GL_RGBA, GL_UNSIGNED_BYTE, actualPixels.data());
+                        ASSERT_EQ(actualPixels, expectedPixels);
+                        glBindBuffer(GL_SHADER_STORAGE_BUFFER, arguments);
+                        const auto *actual = static_cast<const uint32_t *>(glMapBufferRange(
+                            GL_SHADER_STORAGE_BUFFER, 0, initial.size() * 4, GL_MAP_READ_BIT));
+                        ASSERT_NE(actual, nullptr);
+                        for (size_t word = 0; word < expectedWords.size(); ++word)
+                        {
+                            EXPECT_EQ(actual[word], expectedWords[word])
+                                << "command/source/guard word " << word;
+                        }
+                        EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+                        ++compared;
+                    }
+                }
+            }
+        }
+    }
+    EXPECT_EQ(compared, 1008u);
+    RecordProperty("ComparedArrayIndirectFrames", compared);
+    ASSERT_GL_NO_ERROR();
+}
