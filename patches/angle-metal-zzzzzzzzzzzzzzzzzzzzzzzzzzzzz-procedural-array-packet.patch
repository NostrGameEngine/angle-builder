+// Exercise the real GPU conversion kernel at the GLsizei/uint expansion boundary
+// without submitting billions of rasterized vertices. Readback is test-only.
+TEST_P(IndirectCommandTestMetal, ProceduralArrayCommandBoundaries)
+{
+    auto *display                 = static_cast<egl::Display *>(getEGLWindow()->getDisplay());
+    const gl::ContextID contextID = {
+        static_cast<GLuint>(reinterpret_cast<uintptr_t>(getEGLWindow()->getContext()))};
+    gl::Context *glContext = display->getContext(contextID);
+    ContextMtl *context    = mtl::GetImpl(glContext);
+    ASSERT_NE(context, nullptr);
+    NSError *error = nil;
+    auto library   = angle::adoptObjCPtr([context->getMetalDevice()
+        newLibraryWithSource:[NSString stringWithUTF8String:mtl::kProceduralArrayDrawShader]
+                     options:nil
+                       error:&error]);
+    ASSERT_NE(library.get(), nil) << (error ? error.localizedDescription.UTF8String : "");
+    auto function = angle::adoptObjCPtr([library.get() newFunctionWithName:@"main0"]);
+    auto pipeline = angle::adoptObjCPtr([context->getMetalDevice()
+        newComputePipelineStateWithFunction:function.get()
+                                      error:&error]);
+    ASSERT_NE(pipeline.get(), nil) << (error ? error.localizedDescription.UTF8String : "");
+    const std::array<uint32_t, 9> counts = {0u,          1u,          2u,          3u,         4u,
+                                            0x55555555u, 0x55555556u, 0x7ffffffeu, 0x7fffffffu};
+    constexpr uint32_t guard             = 0xcdcdcdcdu;
+    size_t compared                      = 0;
+    for (uint32_t mode : {1u, 2u, 3u, 4u, 5u, 6u})
+    {
+        for (uint32_t count : counts)
+        {
+            for (uint32_t first : {0u, 3u, 0x80000000u, 0xfffffffeu, 0xffffffffu})
+            {
+                for (uint32_t instances : {0u, 1u, 3u, 0x7fffffffu})
+                {
+                    for (uint32_t baseInstance : {0u, 3u})
+                    {
+                        SCOPED_TRACE(testing::Message()
+                                     << mode << ":" << count << ":" << first << ":" << instances);
+                        mtl::BufferRef source, output;
+                        // The command ends at the end of its allocation: a fifth word is illegal.
+                        ASSERT_EQ(mtl::Buffer::MakeBuffer(context, 272, &source),
+                                  angle::Result::Continue);
+                        ASSERT_EQ(mtl::Buffer::MakeBuffer(context, 128, &output),
+                                  angle::Result::Continue);
+                        std::array<uint32_t, 68> input;
+                        input.fill(guard);
+                        input[64]  = count;
+                        input[65]  = instances;
+                        input[66]  = first;
+                        input[67]  = baseInstance;
+                        auto write = source->map(context);
+                        std::memcpy(write.data(), input.data(), sizeof(input));
+                        source->unmap(context);
+                        std::array<uint32_t, 32> expected;
+                        expected.fill(guard);
+                        write = output->map(context);
+                        std::memcpy(write.data(), expected.data(), sizeof(expected));
+                        output->unmap(context);
+                        const std::array<uint32_t, 2> params = {mode, 2u};
+                        auto *encoder                        = context->getComputeCommandEncoder();
+                        encoder->setComputePipelineState(pipeline.get());
+                        encoder->setBuffer(source, 256, 0);
+                        encoder->setBufferForWrite(output, 32, 1);
+                        encoder->setData(params, 2);
+                        encoder->dispatch(MTLSizeMake(1, 1, 1), MTLSizeMake(1, 1, 1));
+                        const uint64_t bounded =
+                            std::min<uint64_t>(count, uint64_t(0xffffffffu) - first);
+                        uint64_t primitives = 0;
+                        switch (mode)
+                        {
+                            case 1:
+                                primitives = bounded / 2;
+                                break;
+                            case 2:
+                                primitives = bounded > 1 ? bounded : 0;
+                                break;
+                            case 3:
+                                primitives = bounded > 1 ? bounded - 1 : 0;
+                                break;
+                            case 4:
+                                primitives = bounded / 3;
+                                break;
+                            default:
+                                primitives = bounded > 2 ? bounded - 2 : 0;
+                                break;
+                        }
+                        const uint64_t chunk    = (primitives + 1) / 2;
+                        const uint64_t vertices = chunk * (mode >= 4 ? 3 : 2);
+                        ASSERT_LE(vertices, uint64_t(0xffffffffu));
+                        expected[8]  = static_cast<uint32_t>(vertices);
+                        expected[9]  = instances * 2u;
+                        expected[10] = 0;
+                        expected[11] = baseInstance;
+                        expected[16] = first;
+                        expected[17] = static_cast<uint32_t>(bounded);
+                        expected[18] = mode;
+                        expected[19] = 2;
+                        expected[20] = static_cast<uint32_t>(chunk);
+                        expected[21] = static_cast<uint32_t>(primitives);
+                        expected[22] = baseInstance;
+                        auto read    = output->mapReadOnly(context);
+                        ASSERT_GE(read.size(), sizeof(expected));
+                        EXPECT_EQ(std::memcmp(read.data(), expected.data(), sizeof(expected)), 0);
+                        output->unmap(context);
+                        read = source->mapReadOnly(context);
+                        ASSERT_GE(read.size(), sizeof(input));
+                        EXPECT_EQ(std::memcmp(read.data(), input.data(), sizeof(input)), 0);
+                        source->unmap(context);
+                        ++compared;
+                    }
+                }
+            }
+        }
+    }
+    EXPECT_EQ(compared, 2160u);
+    RecordProperty("ComparedCommandPackets", compared);
+    EXPECT_EQ(context->checkCommandBufferError(), angle::Result::Continue);
+    context->invalidateState(glContext);
+}
