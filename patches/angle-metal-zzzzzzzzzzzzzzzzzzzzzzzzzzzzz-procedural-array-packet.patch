+    const uint primitives = mode == 1u ? count/2u : mode == 4u ? count/3u :
+                            mode == 3u ? (count > 1u ? count-1u : 0u) :
+                            mode == 2u ? (count > 1u ? count : 0u) :
+                                         (count > 2u ? count-2u : 0u);
+    // Two consecutive native instances cover each GL instance. One native
+    // draw preserves primitive/instance order even when expansion exceeds UINT_MAX.
+    const uint perInstance = (primitives+1u)/2u;
+    packet[0] = perInstance*width;
+    packet[1] = min(source[1],0x7fffffffu)*2u;
+    packet[2] = 0u;
+    // EXT_base_instance defines the final GLES command word.
+    packet[3] = source[3];
+    packet[8] = source[2];
+    packet[9] = count;
+    packet[10] = mode;
+    packet[11] = params.y;
+    packet[12] = perInstance;
+    packet[13] = primitives;
+    packet[14] = source[3];
+}
+)";
