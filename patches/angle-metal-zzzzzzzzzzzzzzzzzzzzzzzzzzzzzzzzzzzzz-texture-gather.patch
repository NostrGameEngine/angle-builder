+template <typename T>
+ANGLE_ALWAYS_INLINE auto ANGLE_textureGatherOffset(
+    thread ANGLE_TextureEnv<metal::texture2d<T>> &env,
+    metal::float2 coord, metal::int2 offset, int comp = 0)
+{
+    switch (comp)
+    {
+        case 1: return env.texture->gather(*env.sampler, coord, offset, metal::component::y);
+        case 2: return env.texture->gather(*env.sampler, coord, offset, metal::component::z);
+        case 3: return env.texture->gather(*env.sampler, coord, offset, metal::component::w);
+        default: return env.texture->gather(*env.sampler, coord, offset, metal::component::x);
+    }
+}
+template <typename T>
+ANGLE_ALWAYS_INLINE auto ANGLE_textureGather(
+    thread ANGLE_TextureEnv<metal::texture2d<T>> &env,
+    metal::float2 coord, int comp = 0)
+{
+    return ANGLE_textureGatherOffset(env, coord, metal::int2(0), comp);
+}
+
