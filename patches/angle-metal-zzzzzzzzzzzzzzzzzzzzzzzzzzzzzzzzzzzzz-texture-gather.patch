+TEST_F(MSLOutputTest, CoreTextureGatherSamplersAndOffsets)
+{
+    compile(R"(#version 310 es
+        precision highp float;
+        precision highp int;
+        uniform highp sampler2D color2D;
+        uniform highp isampler2DArray integerArray;
+        uniform highp usamplerCube integerCube;
+        uniform highp sampler2DShadow depth2D;
+        uniform highp sampler2DArrayShadow depthArray;
+        uniform highp samplerCubeShadow depthCube;
+        out vec4 color;
+        void main() {
+            color = textureGather(color2D,vec2(.3),2)
+                + vec4(textureGather(integerArray,vec3(.3,.7,1),3))
+                + vec4(textureGather(integerCube,vec3(1,0,1),1))
+                + textureGather(depth2D,vec2(.3),.5)
+                + textureGather(depthArray,vec3(.3,.7,1),.5)
+                + textureGather(depthCube,vec3(1,0,1),.5);
+            color += textureGatherOffset(color2D,vec2(.3),ivec2(-8,7),1)
+                + vec4(textureGatherOffset(integerArray,vec3(.3,.7,1),ivec2(7,-8),0))
+                + textureGatherOffset(depth2D,vec2(.3),.5,ivec2(1,-1))
+                + textureGatherOffset(depthArray,vec3(.3,.7,1),.5,ivec2(-1,1));
+        }
+    )");
+    EXPECT_TRUE(foundInCode("ANGLE_textureGatherOffset"));
+    EXPECT_TRUE(foundInCode("gather_compare"));
+}
