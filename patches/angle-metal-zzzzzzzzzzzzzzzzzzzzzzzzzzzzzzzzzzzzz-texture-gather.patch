+// Gather uses compute's sampler/texture bindings, not the graphics-stage maps.
+// Check channels, offsets, clamped layers, shadow comparisons and binary reload.
+TEST_P(ComputeDispatchTestMetal, TextureGatherCoreSamplersAndBinary)
+{
+    constexpr char source[] = R"(#version 310 es
+        precision highp float;
+        precision highp int;
+        layout(local_size_x=1) in;
+        layout(binding=0) uniform highp usampler2D colors;
+        layout(binding=1) uniform highp sampler2DArray layers;
+        layout(binding=2) uniform highp sampler2DShadow depths;
+        layout(std430,binding=0) buffer Results {
+            uvec4 prefix[4]; uvec4 values[6]; uvec4 suffix[4];
+        } outputData;
+        void main() {
+            outputData.values[0]=textureGather(colors,vec2(.5),2);
+            outputData.values[1]=textureGatherOffset(colors,vec2(.5),ivec2(1,-1),2);
+            outputData.values[2]=uvec4(textureGather(layers,vec3(.5,.5,1.5),0));
+            outputData.values[3]=uvec4(textureGather(layers,vec3(.5,.5,-1.5),0));
+            outputData.values[4]=uvec4(textureGather(depths,vec2(.5),.5));
+            outputData.values[5]=uvec4(textureGatherOffset(depths,vec2(.5),.5,ivec2(1,-1)));
+        }
+    )";
+    ANGLE_GL_COMPUTE_PROGRAM(program, source);
+    GLProgram binary;
+    reloadProgram(program, binary);
+    GLTexture colors, layers, depths;
+    const std::array<uint8_t, 16> texels = {1, 11, 21, 31, 2, 12, 22, 32,
+                                            3, 13, 23, 33, 4, 14, 24, 34};
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, colors);
+    glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8UI, 2, 2);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 2, 2, GL_RGBA_INTEGER, GL_UNSIGNED_BYTE, texels.data());
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
+    std::array<float, 32> arrayTexels;
+    for (size_t i = 0; i < 8; ++i)
+    {
+        arrayTexels[i * 4]     = float(i < 4 ? 10 + i : 16 + i);
+        arrayTexels[i * 4 + 1] = 0;
+        arrayTexels[i * 4 + 2] = 0;
+        arrayTexels[i * 4 + 3] = 1;
+    }
+    glActiveTexture(GL_TEXTURE1);
+    glBindTexture(GL_TEXTURE_2D_ARRAY, layers);
+    glTexStorage3D(GL_TEXTURE_2D_ARRAY, 1, GL_RGBA32F, 2, 2, 2);
+    glTexSubImage3D(GL_TEXTURE_2D_ARRAY, 0, 0, 0, 0, 2, 2, 2, GL_RGBA, GL_FLOAT,
+                    arrayTexels.data());
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    const std::array<float, 4> depthValues = {.125f, .375f, .625f, .875f};
+    glActiveTexture(GL_TEXTURE2);
+    glBindTexture(GL_TEXTURE_2D, depths);
+    glTexStorage2D(GL_TEXTURE_2D, 1, GL_DEPTH_COMPONENT32F, 2, 2);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 2, 2, GL_DEPTH_COMPONENT, GL_FLOAT, depthValues.data());
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_COMPARE_REF_TO_TEXTURE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_FUNC, GL_LESS);
+    const std::array<uint32_t, 24> gathered = {23, 24, 22, 21, 22, 21, 23, 24, 22, 23, 21, 20,
+                                               12, 13, 11, 10, 1,  1,  0,  0,  0,  0,  1,  1};
+    std::array<uint32_t, 56> expected, initial;
+    expected.fill(0xcdcdcdcdu);
+    initial.fill(0xcdcdcdcdu);
+    std::copy(gathered.begin(), gathered.end(), expected.begin() + 16);
+    GLBuffer output;
+    glBindBuffer(GL_SHADER_STORAGE_BUFFER, output);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, output);
+    for (GLuint active : {program.get(), binary.get()})
+    {
+        SCOPED_TRACE(active);
+        glBufferData(GL_SHADER_STORAGE_BUFFER, sizeof(initial), initial.data(), GL_DYNAMIC_DRAW);
+        glUseProgram(active);
+        glDispatchCompute(1, 1, 1);
+        glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+        ASSERT_GL_NO_ERROR();
+        const auto *actual = static_cast<const uint32_t *>(
+            glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, sizeof(expected), GL_MAP_READ_BIT));
+        ASSERT_NE(actual, nullptr);
+        for (size_t word = 0; word < expected.size(); ++word)
+        {
+            EXPECT_EQ(actual[word], expected[word]) << word;
+        }
+        EXPECT_EQ(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), GL_TRUE);
+    }
+}
+
 // A GPU producer supplies std140 graphics uniforms whose native Metal layout
 // requires matrix transposition, array repacking and boolean normalization.
 TEST_P(ComputeDispatchTestMetal, GPUWrittenGraphicsUniformConversionAndBinary)
