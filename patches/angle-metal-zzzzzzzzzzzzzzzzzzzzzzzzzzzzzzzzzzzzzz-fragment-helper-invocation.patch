+// The GLSL builtin is a per-invocation Metal query, also inside user functions.
+TEST_F(MSLOutputTest, FragmentHelperInvocation)
+{
+    compile(R"(#version 310 es
+        precision highp float;
+        out vec4 color;
+        bool helper() { return gl_HelperInvocation; }
+        void main() {
+            color = vec4(helper() ? dFdx(gl_FragCoord.x) : 0.0);
+        }
+    )");
+    EXPECT_TRUE(foundInCode("metal::simd_is_helper_thread()"));
+    EXPECT_TRUE(notFoundInCode("gl_HelperInvocation"));
+}
