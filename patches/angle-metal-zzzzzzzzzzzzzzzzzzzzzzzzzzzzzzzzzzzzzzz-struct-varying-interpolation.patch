+// Struct flattening must retain interpolation on every member and matrix column.
+TEST_F(MSLOutputTest, StructVaryingInterpolationQualifiers)
+{
+    getResources()->OES_shader_multisample_interpolation = 1;
+    for (const auto &test :
+         {std::pair{"sample", "[[sample_perspective]]"},
+          std::pair{"centroid", "[[centroid_perspective]]"}, std::pair{"flat", "[[flat]]"}})
+    {
+        SCOPED_TRACE(test.first);
+        const std::string source = std::string(R"(#version 310 es
+            #extension GL_OES_shader_multisample_interpolation : require
+            precision highp float;
+            struct Data { float x; vec2 y; mat2 basis; };
+        )") + test.first + R"( in Data data;
+            out vec4 color;
+            void main() {
+                color = vec4(data.x, data.y.x, data.y.y, data.basis[1][1]);
+            }
+        )";
+        compile(source);
+        EXPECT_TRUE(foundInCode(test.second));
+    }
+}
