+// Explicit precise math preserves the quadrant for zero x inputs.
+TEST_F(MSLOutputTest, PreciseTwoArgumentAtan)
+{
+    compile(R"(#version 310 es
+        precision lowp float;
+        uniform vec2 inputValue;
+        out vec4 color;
+        void main() { color = vec4(atan(inputValue.x, inputValue.y)); }
+    )");
+    EXPECT_TRUE(foundInCode("metal::precise::atan2"));
+}
