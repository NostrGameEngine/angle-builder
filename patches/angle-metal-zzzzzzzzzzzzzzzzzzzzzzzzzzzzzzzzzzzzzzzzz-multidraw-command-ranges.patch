+// Validate the complete command interval without encoding a native draw. This
+// also reproduces missing frontend checks safely with Metal validation enabled.
+TEST_P(ComputeDispatchTestMetal, MultiDrawCommandRanges)
+{
+    constexpr char vertex[]   = R"(#version 310 es
+        void main() { gl_Position=vec4(0,0,0,1); }
+    )";
+    constexpr char fragment[] = R"(#version 310 es
+        precision highp float;
+        out vec4 color;
+        void main() { color=vec4(1); }
+    )";
+    ANGLE_GL_PROGRAM(program, vertex, fragment);
+    glUseProgram(program);
+    GLVertexArray vao;
+    glBindVertexArray(vao);
+    GLBuffer commands, indices;
+    const std::array<uint32_t, 16> zeros = {};
+    glBindBuffer(GL_DRAW_INDIRECT_BUFFER, commands);
+    glBufferData(GL_DRAW_INDIRECT_BUFFER, sizeof(zeros), zeros.data(), GL_STATIC_DRAW);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, indices);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeof(zeros), zeros.data(), GL_STATIC_DRAW);
+    auto *display          = static_cast<egl::Display *>(getEGLWindow()->getDisplay());
+    const gl::ContextID id = {
+        static_cast<GLuint>(reinterpret_cast<uintptr_t>(getEGLWindow()->getContext()))};
+    gl::Context *context = display->getContext(id);
+    ASSERT_NE(context, nullptr);
+    ASSERT_GL_NO_ERROR();
+    for (bool indexed : {false, true})
+    {
+        SCOPED_TRACE(indexed);
+        const GLsizei commandSize = indexed ? 20 : 16;
+        auto validate = [&](uintptr_t offset, GLsizei count, GLsizei stride, bool expected,
+                            GLenum error) {
+            SCOPED_TRACE(offset);
+            SCOPED_TRACE(count);
+            SCOPED_TRACE(stride);
+            const void *at = reinterpret_cast<const void *>(offset);
+            const bool actual =
+                indexed ? gl::ValidateMultiDrawElementsIndirectEXT(
+                              context, angle::EntryPoint::GLMultiDrawElementsIndirectEXT,
+                              gl::PrimitiveMode::Triangles, gl::DrawElementsType::UnsignedInt, at,
+                              count, stride)
+                        : gl::ValidateMultiDrawArraysIndirectEXT(
+                              context, angle::EntryPoint::GLMultiDrawArraysIndirectEXT,
+                              gl::PrimitiveMode::Triangles, at, count, stride);
+            EXPECT_EQ(actual, expected);
+            EXPECT_GL_ERROR(error);
+        };
+        validate(64 - commandSize, 1, 0, true, GL_NO_ERROR);
+        validate(0, 64 / commandSize, 0, true, GL_NO_ERROR);
+        validate(0, 64 / commandSize + 1, 0, false, GL_INVALID_OPERATION);
+        validate(0, 2, 64, false, GL_INVALID_OPERATION);
+        validate(commandSize * 2, 3, -commandSize, false, GL_INVALID_VALUE);
+        validate(commandSize, 3, -commandSize, false, GL_INVALID_VALUE);
+        validate(0, 3, 4, true, GL_NO_ERROR);
+        validate(8, 3, -4, false, GL_INVALID_VALUE);
+        validate(0, 1, std::numeric_limits<GLsizei>::min(), false, GL_INVALID_VALUE);
+        validate(0, std::numeric_limits<GLsizei>::max(), std::numeric_limits<GLsizei>::max() - 3,
+                 false, GL_INVALID_OPERATION);
+        validate(std::numeric_limits<uintptr_t>::max() - 3, 1, 0, false, GL_INVALID_OPERATION);
+        validate(2, 1, 0, false, GL_INVALID_VALUE);
+        validate(0, 0, 0, false, GL_INVALID_VALUE);
+        validate(0, -1, 0, false, GL_INVALID_VALUE);
+        validate(0, 1, 2, false, GL_INVALID_VALUE);
+
+        // The public entry point must reject the entire invalid sequence before
+        // encoding any native command. Negative strides are rejected; valid
+        // overlapping packets are zero-filled and produce no fragments.
+        auto draw = [&](uintptr_t offset, GLsizei count, GLsizei stride) {
+            const void *at = reinterpret_cast<const void *>(offset);
+            if (indexed)
+            {
+                glMultiDrawElementsIndirectEXT(GL_TRIANGLES, GL_UNSIGNED_INT, at, count, stride);
+            }
+            else
+            {
+                glMultiDrawArraysIndirectEXT(GL_TRIANGLES, at, count, stride);
+            }
+        };
+        draw(0, 64 / commandSize + 1, 0);
+        EXPECT_GL_ERROR(GL_INVALID_OPERATION);
+        draw(0, 2, 64);
+        EXPECT_GL_ERROR(GL_INVALID_OPERATION);
+        draw(commandSize, 3, -commandSize);
+        EXPECT_GL_ERROR(GL_INVALID_VALUE);
+        draw(commandSize * 2, 3, -commandSize);
+        EXPECT_GL_ERROR(GL_INVALID_VALUE);
+        draw(0, 3, 4);
+        EXPECT_GL_NO_ERROR();
+        draw(8, 3, -4);
+        EXPECT_GL_ERROR(GL_INVALID_VALUE);
+    }
+}
