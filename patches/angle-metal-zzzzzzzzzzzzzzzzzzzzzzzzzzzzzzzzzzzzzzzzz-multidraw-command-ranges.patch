+namespace
+{
+// First-command validation establishes valid state and a nonnegative buffer
+// offset. The stride is nonnegative (and may overlap commands), so checking the
+// last interval covers the entire sequence.
+bool ValidateMultiDrawIndirectRange(const Context *context,
+                                    angle::EntryPoint entryPoint,
+                                    const void *indirect,
+                                    GLsizei drawcount,
+                                    GLsizei stride,
+                                    size_t commandSize)
+{
+    const Buffer *buffer = context->getState().getTargetBuffer(BufferBinding::DrawIndirect);
+    angle::CheckedNumeric<size_t> last(reinterpret_cast<uintptr_t>(indirect));
+    const size_t step = stride ? static_cast<size_t>(stride) : commandSize;
+    last += angle::CheckedNumeric<size_t>(step) * (static_cast<size_t>(drawcount) - 1);
+    const auto end = last + commandSize;
+    if (!last.IsValid() || !end.IsValid() ||
+        end.ValueOrDie() > static_cast<size_t>(buffer->getSize()))
+    {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, kParamOverflow);
+        return false;
+    }
+    return true;
+}
