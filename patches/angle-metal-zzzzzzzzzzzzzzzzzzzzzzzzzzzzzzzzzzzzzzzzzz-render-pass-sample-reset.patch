@@ -377,6 +377,59 @@ TEST_P(ComputeDispatchTestMetal, MultiDrawCommandRanges)
     }
 }
 
+// The cached native render-pass descriptor survives encoder restarts. Changing
+// from attachmentless rendering to an MSAA attachment must replace its samples.
+TEST_P(ComputeDispatchTestMetal, AttachmentlessToMultisampleRenderPass)
+{
+    constexpr char vertex[]   = R"(#version 310 es
+        void main() {
+            vec2 p=gl_VertexID==0 ? vec2(-1,-1) : gl_VertexID==1 ? vec2(3,-1) : vec2(-1,3);
+            gl_Position=vec4(p,0,1);
+        }
+    )";
+    constexpr char fragment[] = R"(#version 310 es
+        precision highp float;
+        out vec4 color;
+        void main() { color=vec4(0,1,0,1); }
+    )";
+    ANGLE_GL_PROGRAM(program, vertex, fragment);
+    glUseProgram(program);
+    GLVertexArray vao;
+    glBindVertexArray(vao);
+    GLFramebuffer target, resolve;
+    GLRenderbuffer multisample, single;
+    glBindRenderbuffer(GL_RENDERBUFFER, multisample);
+    glRenderbufferStorageMultisample(GL_RENDERBUFFER, 4, GL_RGBA8, 16, 16);
+    glBindRenderbuffer(GL_RENDERBUFFER, single);
+    glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA8, 16, 16);
+    glBindFramebuffer(GL_FRAMEBUFFER, resolve);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, single);
+    ASSERT_GLENUM_EQ(glCheckFramebufferStatus(GL_FRAMEBUFFER), GL_FRAMEBUFFER_COMPLETE);
+    glViewport(0, 0, 16, 16);
+    for (GLint samples : {1, 4, 1, 2, 4, 1})
+    {
+        SCOPED_TRACE(samples);
+        glBindFramebuffer(GL_FRAMEBUFFER, target);
+        glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 0);
+        glFramebufferParameteri(GL_FRAMEBUFFER, GL_FRAMEBUFFER_DEFAULT_WIDTH, 16);
+        glFramebufferParameteri(GL_FRAMEBUFFER, GL_FRAMEBUFFER_DEFAULT_HEIGHT, 16);
+        glFramebufferParameteri(GL_FRAMEBUFFER, GL_FRAMEBUFFER_DEFAULT_SAMPLES, samples);
+        ASSERT_GLENUM_EQ(glCheckFramebufferStatus(GL_FRAMEBUFFER), GL_FRAMEBUFFER_COMPLETE);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER,
+                                  multisample);
+        ASSERT_GLENUM_EQ(glCheckFramebufferStatus(GL_FRAMEBUFFER), GL_FRAMEBUFFER_COMPLETE);
+        glClearColor(1, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, resolve);
+        glBlitFramebuffer(0, 0, 16, 16, 0, 0, 16, 16, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        glBindFramebuffer(GL_FRAMEBUFFER, resolve);
+        ASSERT_GL_NO_ERROR();
+        EXPECT_PIXEL_RECT_EQ(0, 0, 16, 16, GLColor::green);
+    }
+}
+
 // A GPU producer supplies std140 graphics uniforms whose native Metal layout
 // requires matrix transposition, array repacking and boolean normalization.
 TEST_P(ComputeDispatchTestMetal, GPUWrittenGraphicsUniformConversionAndBinary)
