-gl::Version DisplayMtl::getMaxSupportedESVersion() const
+bool DisplayMtl::supportsMetalGLES31() const
 {
 #if defined(ANGLE_METAL_COMPUTE_TESTS)
-    // Explicitly requested, non-conformant integration profile; normal builds
-    // retain their production capability gate below.
-    return gl::Version(3, 1);
-#else
-#    if TARGET_OS_SIMULATOR
+    // Preserve the isolated test profile independently of production selection.
+    return true;
+#elif defined(ANGLE_METAL_GLES31) && TARGET_OS_OSX && !TARGET_OS_MACCATALYST
+    // Language-only memory fences require Metal 3.2. Restrict the opt-in profile
+    // to Apple GPUs with the resource features used by the compute/image paths.
+    if (@available(macOS 15.0, *))
+    {
+        return supportsAppleGPUFamily(7) &&
+               mMetalDevice.get().argumentBuffersSupport >= MTLArgumentBuffersTier2 &&
+               mMetalDevice.get().readWriteTextureSupport >= MTLReadWriteTextureTier2 &&
+               mMetalDevice.get().maxThreadsPerThreadgroup.width >= 128 &&
+               mMetalDevice.get().maxThreadgroupMemoryLength >= 16384 &&
+               mMetalDevice.get().maxBufferLength >= (1u << 27);
+    }
+#endif
+    return false;
+}
+
+gl::Version DisplayMtl::getMaxSupportedESVersion() const
+{
+    if (supportsMetalGLES31())
+    {
+        return gl::Version(3, 1);
+    }
+#if TARGET_OS_SIMULATOR
     // Simulator should be able to support ES3, despite not supporting iOS GPU
     // Family 3 in its entirety.
     // FIXME: None of the feature conditions are checked for simulator support.
     return gl::Version(3, 0);
-#    else
+#else
     if (supportsEitherGPUFamily(4, 1))
     {
         return mtl::kMaxSupportedGLVersion;
     }
     return gl::Version(2, 0);
-#    endif
 #endif
 }
 
