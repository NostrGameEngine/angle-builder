+// Runtime SSBO lengths use a 64-bit byte range even though GLSL returns int.
+PROGRAM_PRELUDE_DECLARE(storageArrayLength, R"(
+ANGLE_ALWAYS_INLINE int ANGLE_storageArrayLength(metal::uint2 size, uint offset, uint stride)
