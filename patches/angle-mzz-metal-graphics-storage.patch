+angle::Result ProgramExecutableMtl::encodeGraphicsStorageBuffers(
+    const gl::Context *glContext, gl::ShaderType stage, mtl::RenderCommandEncoder *encoder)
+{
+    auto *context = mtl::GetImpl(glContext);
+    if (!mCurrentShaderVariants[stage])
+    {
+        return angle::Result::Continue;
+    }
+    const auto &info = mMslShaderTranslateInfo[stage];
+    const auto &blocks = mExecutable->getShaderStorageBlocks();
+    std::array<mtl::StorageBufferSize, mtl::kGraphicsStorageSizeSlots> sizes = {};
+    bool active = false;
+    for (size_t block = 0; block < blocks.size(); ++block)
+    {
+        if (block >= info.actualSSBOBindings.size())
+        {
+            continue;
+        }
+        const uint32_t slot = info.actualSSBOBindings[block];
+        if (slot < mtl::kGraphicsStorageBufferBindingStart ||
+            slot >= mtl::kGraphicsStorageBufferBindingStart + mtl::kMaxGraphicsStorageBuffers)
+        {
+            continue;
+        }
+        const auto &binding = glContext->getState().getIndexedShaderStorageBuffer(
+            mExecutable->getShaderStorageBlockBinding(block));
+        ANGLE_CHECK(context, binding.get(), "Missing shader storage buffer", GL_INVALID_OPERATION);
+        auto *buffer = mtl::GetImpl(binding.get());
+        encoder->setBufferForWrite(stage, buffer->getCurrentBuffer(),
+                                   static_cast<size_t>(binding.getOffset()), slot);
+        sizes[slot] = mtl::EncodeStorageBufferSize(gl::GetBoundBufferAvailableSize(binding));
+        active = true;
+    }
+    if (active)
+    {
+        context->setGraphicsStorageBufferSizes(stage, sizes, encoder);
+    }
+    for (const auto &counter : mExecutable->getAtomicCounterBuffers())
+    {
+        if (!counter.isActive(stage))
+        {
+            continue;
+        }
+        const auto &binding = glContext->getState().getIndexedAtomicCounterBuffer(
+            counter.pod.inShaderBinding);
+        ANGLE_CHECK(context, binding.get(), "Missing graphics atomic counter buffer",
+                    GL_INVALID_OPERATION);
+        encoder->setBufferForWrite(stage, mtl::GetImpl(binding.get())->getCurrentBuffer(),
+                                   static_cast<size_t>(binding.getOffset()),
+                                   angle::metal::kGraphicsStorageEndBinding);
+    }
+    return angle::Result::Continue;
+}
