+#ifndef COMMON_METAL_SHADER_BINDINGS_H_
+#define COMMON_METAL_SHADER_BINDINGS_H_
+
+#include <cstdint>
+
+namespace angle
+{
+namespace metal
+{
+// Metal's documented buffer-argument table has 31 entries per function on all
+// GPU families accepted by the opt-in GLES 3.1 profile. This is an API/family
+// limit, not an MTLDevice property.
+constexpr uint32_t kBufferArgumentCount = 31;
+// Slots preceding this index belong to ANGLE's vertex and internal resources.
+constexpr uint32_t kGraphicsStorageFirstBinding = 26;
+// The final table entry is reserved for a graphics atomic-counter buffer.
+constexpr uint32_t kGraphicsStorageEndBinding = kBufferArgumentCount - 1;
+constexpr uint32_t kGraphicsStorageBindingCount =
+    kGraphicsStorageEndBinding - kGraphicsStorageFirstBinding;
+// The driver uniform buffer uses a 16-byte-aligned array indexed by Metal slot.
+constexpr uint32_t kGraphicsStorageSizeSlots = (kBufferArgumentCount + 3) / 4 * 4;
+}  // namespace metal
+}  // namespace angle
+
+#endif  // COMMON_METAL_SHADER_BINDINGS_H_
