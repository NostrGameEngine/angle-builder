+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef LIBANGLE_RENDERER_METAL_ACCELERATIONSTRUCTUREMTL_H_
+#define LIBANGLE_RENDERER_METAL_ACCELERATIONSTRUCTUREMTL_H_
+
+#include "libANGLE/renderer/AccelerationStructureImpl.h"
+#include "libANGLE/renderer/metal/mtl_command_buffer.h"
+#include "libANGLE/renderer/metal/mtl_resources.h"
+
+namespace rx
+{
+// Each build is immutable. A TLAS pins the precise BLAS generations it was built
+// against; later rebuilds of the GL names do not alter already queued traversal.
+class AccelerationStructureGenerationMtl final : public mtl::Resource
+{
+  public:
+    AccelerationStructureGenerationMtl(id<MTLAccelerationStructure> structure, size_t bytes);
+    size_t estimatedByteSize() const override { return mBytes; }
+    id getID() const override { return mStructure.get(); }
+    id<MTLAccelerationStructure> get() const { return mStructure.get(); }
+    std::vector<std::shared_ptr<AccelerationStructureGenerationMtl>> children;
+
+  private:
+    angle::ObjCPtr<id<MTLAccelerationStructure>> mStructure;
+    size_t mBytes;
+};
+
+class AccelerationStructureMtl final : public AccelerationStructureImpl
+{
+  public:
+    void onDestroy(const gl::Context *context) override;
+    angle::Result buildTriangles(const gl::Context *context,
+                                 const gl::AccelerationStructureTriangles &triangles) override;
+    angle::Result buildAabbs(const gl::Context *context,
+                             const gl::AccelerationStructureAabbs &aabbs) override;
+    angle::Result buildTopLevel(const gl::Context *context,
+                                const std::deque<gl::AccelerationStructureInstance> &instances,
+                                GLsizei count,
+                                GLbitfield flags) override;
+    const auto &getGeneration() const { return mGeneration; }
+    void useForRead(mtl::RenderCommandEncoder *render,
+                    mtl::ComputeCommandEncoder *compute,
+                    gl::ShaderType stage) const;
+
+  private:
+    angle::Result build(ContextMtl *context,
+                        MTLAccelerationStructureDescriptor *descriptor,
+                        const std::vector<mtl::ResourceRef> &inputs,
+                        std::vector<std::shared_ptr<AccelerationStructureGenerationMtl>> children);
+    std::shared_ptr<AccelerationStructureGenerationMtl> mGeneration;
+};
+}  // namespace rx
+#endif
