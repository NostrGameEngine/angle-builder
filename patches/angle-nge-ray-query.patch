+// Scratch and geometry copies retire through ANGLE's queue serials, including
+// when allocation or command recording fails part way through a build.
+class BuildBuffers
+{
+  public:
+    explicit BuildBuffers(ContextVk *context) : mContext(context) {}
+    ~BuildBuffers()
+    {
+        for (auto &buffer : mBuffers)
+        {
+            buffer->release(mContext->getRenderer());
+        }
+    }
+
+    angle::Result allocate(VkDeviceSize size,
+                           VkBufferUsageFlags usage,
+                           VkMemoryPropertyFlags memory,
+                           vk::BufferHelper **out)
+    {
+        auto buffer = std::make_unique<vk::BufferHelper>();
+        *out        = buffer.get();
+        mBuffers.push_back(std::move(buffer));
+        VkBufferCreateInfo info = {};
+        info.sType              = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+        info.size               = size;
+        info.usage              = usage | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT;
+        info.sharingMode        = VK_SHARING_MODE_EXCLUSIVE;
+        return (*out)->init(mContext, info, memory);
+    }
+
+    angle::Result copyGeometry(gl::Buffer *source,
+                               VkDeviceSize offset,
+                               VkDeviceSize bytes,
+                               vk::BufferHelper **out,
+                               VkDeviceAddress *address)
+    {
+        // GLES permits 16-bit indices at a two-byte offset. Vulkan buffer copies
+        // operate in four-byte units; BufferVk pads its allocations to four bytes.
+        VkDeviceSize alignedOffset = offset & ~VkDeviceSize(3);
+        VkDeviceSize prefix        = offset - alignedOffset;
+        VkDeviceSize copyBytes     = (prefix + bytes + 3) & ~VkDeviceSize(3);
+        auto &src                  = vk::GetImpl(source)->getBuffer();
+        ASSERT(alignedOffset + copyBytes <= src.getSize());
+        ANGLE_TRY(allocate(copyBytes,
+                           VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+                               VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_BUILD_INPUT_READ_ONLY_BIT_KHR,
+                           VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, out));
+        vk::CommandResources resources;
+        resources.onBufferTransferRead(&src);
+        resources.onBufferTransferWrite(*out);
+        vk::OutsideRenderPassCommandBuffer *commands;
+        ANGLE_TRY(mContext->getOutsideRenderPassCommandBuffer(resources, &commands));
+        VkBufferCopy copy = {src.getOffset() + alignedOffset, (*out)->getOffset(), copyBytes};
+        commands->copyBuffer(src.getBuffer(), (*out)->getBuffer(), 1, &copy);
+        *address = (*out)->getDeviceAddress(mContext) + (*out)->getOffset() + prefix;
+        return angle::Result::Continue;
+    }
+
+  private:
+    ContextVk *mContext;
+    std::vector<std::unique_ptr<vk::BufferHelper>> mBuffers;
+};
+}  // namespace
+
+AccelerationStructureGenerationVk::~AccelerationStructureGenerationVk()
+{
+    mRenderer->collectGarbage(storage.getResourceUse(), &structure);
+    storage.release(mRenderer);
+}
+
+void AccelerationStructureGenerationVk::useForRead(ContextVk *context,
+                                                   vk::CommandBufferHelperCommon *commands,
+                                                   VkAccessFlags access,
+                                                   vk::PipelineStage stage)
+{
+    commands->bufferRead(context, access, stage, &storage);
+    for (const auto &child : children)
+    {
+        child->useForRead(context, commands, access, stage);
+    }
+}
+
+void AccelerationStructureVk::onDestroy(const gl::Context *)
+{
+    mGeneration.reset();
+}
+
+angle::Result AccelerationStructureVk::build(
+    ContextVk *context,
+    VkAccelerationStructureGeometryKHR geometry,
+    uint32_t count,
+    GLbitfield flags,
+    const std::vector<vk::BufferHelper *> &inputs,
+    std::vector<std::shared_ptr<AccelerationStructureGenerationVk>> children)
+{
+    auto *renderer        = context->getRenderer();
+    const auto &functions = renderer->getRayQueryFunctions();
+    bool topLevel         = geometry.geometryType == VK_GEOMETRY_TYPE_INSTANCES_KHR;
+    VkAccelerationStructureBuildGeometryInfoKHR info = {};
+    info.sType         = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_GEOMETRY_INFO_KHR;
+    info.type          = topLevel ? VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR
+                                  : VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR;
+    info.flags         = flags & GL_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT
+                             ? VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT_KHR
+                             : VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_TRACE_BIT_KHR;
+    info.mode          = VK_BUILD_ACCELERATION_STRUCTURE_MODE_BUILD_KHR;
+    info.geometryCount = 1;
+    info.pGeometries   = &geometry;
+    VkAccelerationStructureBuildSizesInfoKHR sizes = {};
+    sizes.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_SIZES_INFO_KHR;
+    functions.getBuildSizes(context->getDevice(), VK_ACCELERATION_STRUCTURE_BUILD_TYPE_DEVICE_KHR,
+                            &info, &count, &sizes);
+
+    auto generation               = std::make_shared<AccelerationStructureGenerationVk>(renderer);
+    generation->children          = std::move(children);
+    VkBufferCreateInfo bufferInfo = {};
+    bufferInfo.sType              = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+    bufferInfo.size               = sizes.accelerationStructureSize;
+    bufferInfo.usage              = VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_STORAGE_BIT_KHR |
+                                    VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT;
+    ANGLE_TRY(generation->storage.init(context, bufferInfo, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT));
+    VkAccelerationStructureCreateInfoKHR create = {};
+    create.sType  = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_CREATE_INFO_KHR;
+    create.buffer = generation->storage.getBuffer().getHandle();
+    create.offset = generation->storage.getOffset();
+    create.size   = sizes.accelerationStructureSize;
+    create.type   = info.type;
+    ANGLE_VK_TRY(context,
+                 generation->structure.init(context->getDevice(), create, functions.create));
+    info.dstAccelerationStructure = generation->structure.getHandle();
+
+    BuildBuffers transient(context);
+    vk::BufferHelper *scratch;
+    VkDeviceSize alignment = renderer->getAccelerationStructureProperties()
+                                 .minAccelerationStructureScratchOffsetAlignment;
+    ANGLE_TRY(transient.allocate(sizes.buildScratchSize + alignment - 1,
+                                 VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+                                 VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, &scratch));
+    VkDeviceAddress scratchAddress = scratch->getDeviceAddress(context) + scratch->getOffset();
+    info.scratchData.deviceAddress = (scratchAddress + alignment - 1) & ~(alignment - 1);
+
+    vk::CommandResources resources;
+    for (auto *input : inputs)
+    {
+        resources.onAccelerationStructureInputRead(input);
+    }
+    for (const auto &child : generation->children)
+    {
+        resources.onAccelerationStructureRead(&child->storage);
+    }
+    resources.onAccelerationStructureWrite(&generation->storage);
+    resources.onAccelerationStructureScratch(scratch);
+    vk::OutsideRenderPassCommandBufferHelper *commands;
+    ANGLE_TRY(context->getOutsideRenderPassCommandBufferHelper(resources, &commands));
+    // Propagate use to every indirect generation before any frontend name can
+    // be deleted or rebuilt. Destruction remains asynchronous.
+    for (const auto &child : generation->children)
+    {
+        child->useForRead(context, commands, VK_ACCESS_ACCELERATION_STRUCTURE_READ_BIT_KHR,
+                          vk::PipelineStage::AccelerationStructureBuild);
+    }
+    VkAccelerationStructureBuildRangeInfoKHR range = {};
+    range.primitiveCount                           = count;
+    commands->getCommandBuffer().buildAccelerationStructure(functions.cmdBuild, info, geometry,
+                                                            range);
+
+    VkAccelerationStructureDeviceAddressInfoKHR addressInfo = {};
+    addressInfo.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_DEVICE_ADDRESS_INFO_KHR;
+    addressInfo.accelerationStructure = generation->structure.getHandle();
+    generation->address               = functions.getAddress(context->getDevice(), &addressInfo);
+    mGeneration                       = std::move(generation);
+    return angle::Result::Continue;
+}
+
+angle::Result AccelerationStructureVk::buildTriangles(
+    const gl::Context *glContext,
+    const gl::AccelerationStructureTriangles &triangles)
+{
+    auto *context  = vk::GetImpl(glContext);
+    uint32_t count = triangles.indexBuffer ? triangles.indexCount / 3 : triangles.vertexCount / 3;
+    ANGLE_CHECK(
+        glContext->getMutableErrorSetForValidation(),
+        count <= context->getRenderer()->getAccelerationStructureProperties().maxPrimitiveCount,
+        "Triangle count exceeds native ray query limits", GL_INVALID_VALUE);
+    BuildBuffers transient(context);
+    std::vector<vk::BufferHelper *> inputs;
+    vk::BufferHelper *vertices;
+    VkDeviceAddress vertexAddress;
+    VkDeviceSize bytes = VkDeviceSize(triangles.vertexCount - 1) * triangles.vertexStride + 12;
+    ANGLE_TRY(transient.copyGeometry(triangles.vertexBuffer, triangles.vertexOffset, bytes,
+                                     &vertices, &vertexAddress));
+    inputs.push_back(vertices);
+    VkAccelerationStructureGeometryKHR geometry = {};
+    geometry.sType        = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR;
+    geometry.geometryType = VK_GEOMETRY_TYPE_TRIANGLES_KHR;
+    auto &data            = geometry.geometry.triangles;
+    data.sType            = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_TRIANGLES_DATA_KHR;
+    data.vertexFormat     = VK_FORMAT_R32G32B32_SFLOAT;
+    data.vertexData.deviceAddress = vertexAddress;
+    data.vertexStride             = triangles.vertexStride;
+    data.maxVertex                = triangles.vertexCount - 1;
+    data.indexType                = VK_INDEX_TYPE_NONE_KHR;
+    if (triangles.indexBuffer)
+    {
+        vk::BufferHelper *indices;
+        VkDeviceAddress indexAddress;
+        bool shortIndices = triangles.indexType == GL_UNSIGNED_SHORT;
+        ANGLE_TRY(transient.copyGeometry(
+            triangles.indexBuffer, triangles.indexOffset,
+            VkDeviceSize(triangles.indexCount) * (shortIndices ? 2 : 4), &indices, &indexAddress));
+        inputs.push_back(indices);
+        data.indexData.deviceAddress = indexAddress;
+        data.indexType               = shortIndices ? VK_INDEX_TYPE_UINT16 : VK_INDEX_TYPE_UINT32;
+    }
+    return build(context, geometry, count, triangles.flags, inputs, {});
+}
+
+angle::Result AccelerationStructureVk::buildAabbs(
+    const gl::Context *glContext,
+    const gl::AccelerationStructureAabbs &aabbs)
+{
+    auto *context = vk::GetImpl(glContext);
+    ANGLE_CHECK(glContext->getMutableErrorSetForValidation(),
+                uint64_t(aabbs.count) <=
+                    context->getRenderer()->getAccelerationStructureProperties().maxPrimitiveCount,
+                "AABB count exceeds native ray query limits", GL_INVALID_VALUE);
+    BuildBuffers transient(context);
+    vk::BufferHelper *boxes;
+    VkDeviceAddress address;
+    VkDeviceSize bytes = VkDeviceSize(aabbs.count - 1) * aabbs.stride + 24;
+    ANGLE_TRY(transient.copyGeometry(aabbs.buffer, aabbs.offset, bytes, &boxes, &address));
+    VkAccelerationStructureGeometryKHR geometry = {};
+    geometry.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR;
+    geometry.geometryType = VK_GEOMETRY_TYPE_AABBS_KHR;
+    geometry.geometry.aabbs.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_AABBS_DATA_KHR;
+    geometry.geometry.aabbs.data.deviceAddress = address;
+    geometry.geometry.aabbs.stride = aabbs.stride;
+    return build(context, geometry, aabbs.count, aabbs.flags, {boxes}, {});
+}
+
+angle::Result AccelerationStructureVk::buildTopLevel(
+    const gl::Context *glContext,
+    const std::deque<gl::AccelerationStructureInstance> &instances,
+    GLsizei count,
+    GLbitfield flags)
+{
+    auto *context = vk::GetImpl(glContext);
+    ANGLE_CHECK(glContext->getMutableErrorSetForValidation(),
+                uint64_t(count) <=
+                    context->getRenderer()->getAccelerationStructureProperties().maxInstanceCount,
+                "Instance count exceeds native ray query limits", GL_INVALID_VALUE);
+    std::vector<VkAccelerationStructureInstanceKHR> descriptors(count);
+    std::vector<std::shared_ptr<AccelerationStructureGenerationVk>> children;
+    for (GLsizei index = 0; index < count; ++index)
+    {
+        const auto &instance = instances[index];
+        const auto &generation =
+            static_cast<AccelerationStructureVk *>(instance.blas->getImplementation())
+                ->getGeneration();
+        ASSERT(generation);
+        children.push_back(generation);
+        auto &descriptor = descriptors[index];
+        ANGLE_UNSAFE_TODO(
+            memcpy(&descriptor.transform, instance.transform.data(), sizeof(descriptor.transform)));
+        descriptor.instanceCustomIndex                    = instance.customIndex;
+        descriptor.mask                                   = instance.mask;
+        descriptor.flags                                  = instance.flags;
+        descriptor.instanceShaderBindingTableRecordOffset = 0;
+        descriptor.accelerationStructureReference         = generation->address;
+    }
+    BuildBuffers transient(context);
+    vk::BufferHelper *buffer;
+    ANGLE_TRY(transient.allocate(
+        descriptors.size() * sizeof(descriptors[0]),
+        VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_BUILD_INPUT_READ_ONLY_BIT_KHR,
+        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, &buffer));
+    uint8_t *mapped;
+    ANGLE_TRY(buffer->map(context, &mapped));
+    ANGLE_UNSAFE_TODO(
+        memcpy(mapped, descriptors.data(), descriptors.size() * sizeof(descriptors[0])));
+    ANGLE_TRY(buffer->flush(context->getRenderer()));
+    VkAccelerationStructureGeometryKHR geometry = {};
+    geometry.sType        = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR;
+    geometry.geometryType = VK_GEOMETRY_TYPE_INSTANCES_KHR;
+    geometry.geometry.instances.sType =
+        VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_INSTANCES_DATA_KHR;
+    geometry.geometry.instances.data.deviceAddress =
+        buffer->getDeviceAddress(context) + buffer->getOffset();
+    return build(context, geometry, count, flags, {buffer}, std::move(children));
+}
