+// Query objects have invocation-private storage in SPIR-V. A Private OpAccessChain cannot be
+// passed to an OpFunctionCall, so make local arrays visible to function specialization while
+// preserving their per-invocation lifetime. GLSL forbids initializing or copying query objects.
+class HoistRayQueryArrays final : public TIntermTraverser
+{
+  public:
+    explicit HoistRayQueryArrays(TSymbolTable *symbols)
+        : TIntermTraverser(true, false, false, symbols)
+    {}
+
+    bool visitDeclaration(Visit, TIntermDeclaration *declaration) override
+    {
+        ASSERT(declaration->getSequence()->size() == 1u);
+        TIntermSymbol *symbol = declaration->getSequence()->front()->getAsSymbolNode();
+        if (!symbol || symbol->getBasicType() != EbtRayQueryNGE || !symbol->getType().isArray() ||
+            symbol->getQualifier() != EvqTemporary)
+        {
+            return true;
+        }
+
+        TVariable *global = CreateTempVariable(mSymbolTable, &symbol->getType(), EvqGlobal);
+        mReplaced[symbol->uniqueId()] = new TIntermSymbol(global);
+        mGlobals.push_back(global);
+        if (getParentNode()->getAsBlock())
+        {
+            TIntermSequence empty;
+            mMultiReplacements.emplace_back(getParentNode()->getAsBlock(), declaration,
+                                            std::move(empty));
+        }
+        else
+        {
+            ASSERT(getParentNode()->getAsLoopNode());
+            queueReplacement(nullptr, OriginalNode::IS_DROPPED);
+        }
+        return false;
+    }
+
+    bool apply(TCompiler *compiler, TIntermBlock *root)
+    {
+        root->traverse(this);
+        for (const TVariable *global : mGlobals)
+        {
+            DeclareGlobalVariable(root, global);
+        }
+        bool validateRefs = compiler->disableValidateVariableReferences();
+        bool ok = updateTree(compiler, root) && ReplaceVariables(compiler, root, mReplaced);
+        compiler->restoreValidateVariableReferences(validateRefs);
+        return ok && compiler->validateAST(root);
+    }
+
+  private:
+    VariableReplacementMap mReplaced;
+    TVector<const TVariable *> mGlobals;
+};
