diff --git a/src/tests/compiler_tests/NGERayQuery_test.cpp b/src/tests/compiler_tests/NGERayQuery_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..eb72e7ddc8819c8015dbcfece59714bf4eb80856
--- /dev/null
+++ b/src/tests/compiler_tests/NGERayQuery_test.cpp
@@ -0,0 +1,243 @@
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "tests/test_utils/compiler_test.h"
+
+namespace sh
+{
+namespace
+{
+class NGERayQueryTest : public testing::Test
+{
+  protected:
+    bool compile(GLenum stage,
+                 const std::string &declarations,
+                 const std::string &body,
+                 bool supported    = true,
+                 bool enabled      = true,
+                 int shaderVersion = 310)
+    {
+        ShBuiltInResources resources;
+        sh::InitBuiltInResources(&resources);
+        resources.NGE_ray_query                       = supported;
+        resources.MaxAccelerationStructureBindingsNGE = 4;
+        resources.MaxComputeWorkGroupSize[0]          = 128;
+        resources.MaxUniformBufferBindings            = 16;
+        resources.MaxFragmentUniformBlocks            = 16;
+        std::string source = "#version " + std::to_string(shaderVersion) + " es\n";
+        if (enabled)
+        {
+            source += "#extension GL_NGE_ray_query : require\n";
+        }
+        source += "precision highp float; precision highp int;\n";
+        if (stage == GL_COMPUTE_SHADER)
+        {
+            source += "layout(local_size_x=1) in;\n";
+        }
+        source += declarations + "\nvoid main() {\n" + body + "\n}\n";
+        ShCompileOptions options;
+        options.objectCode = false;
+        ShHandle compiler  = nullptr;
+        for (ShShaderOutput output :
+             {SH_MSL_METAL_OUTPUT, SH_SPIRV_VULKAN_OUTPUT, SH_ESSL_OUTPUT, SH_GLSL_450_CORE_OUTPUT})
+        {
+            compiler = sh::ConstructCompiler(stage, SH_GLES3_1_SPEC, output, &resources);
+            if (compiler)
+            {
+                break;
+            }
+        }
+        if (!compiler)
+        {
+            mLog = "No shader compiler is enabled in this configuration";
+            return false;
+        }
+        const char *strings[] = {source.c_str()};
+        bool success          = sh::Compile(compiler, strings, 1, options);
+        mLog                  = sh::GetInfoLog(compiler);
+        sh::Destruct(compiler);
+        return success;
+    }
+    std::string mLog;
+};
+
+TEST_F(NGERayQueryTest, TraversalAcceptedInAllStages)
+{
+    const std::string declarations = "layout(binding=0) uniform accelerationStructureEXT scene;";
+    const std::string body         = R"(
+        rayQueryEXT q;
+        rayQueryInitializeEXT(q, scene, gl_RayFlagsNoneEXT, 255u,
+                              vec3(0), 0.0, vec3(0, 0, 1), 100.0);
+        while (rayQueryProceedEXT(q)) {
+            if (rayQueryGetIntersectionTypeEXT(q, false) ==
+                gl_RayQueryCandidateIntersectionTriangleEXT)
+                rayQueryConfirmIntersectionEXT(q);
+        }
+        uint hit = rayQueryGetIntersectionTypeEXT(q, true);
+        float t = rayQueryGetIntersectionTEXT(q, true);
+        vec2 uv = rayQueryGetIntersectionBarycentricsEXT(q, true);
+        int id = rayQueryGetIntersectionInstanceCustomIndexEXT(q, true);
+        uint offset = rayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT(q, true);
+    )";
+    for (GLenum stage : {GL_VERTEX_SHADER, GL_FRAGMENT_SHADER, GL_COMPUTE_SHADER})
+    {
+        EXPECT_TRUE(compile(stage, declarations, body)) << stage << ": " << mLog;
+    }
+}
+
+TEST_F(NGERayQueryTest, MetalUsesNativeTraversalAndSeparateBindings)
+{
+    ShBuiltInResources resources;
+    sh::InitBuiltInResources(&resources);
+    resources.NGE_ray_query                       = 1;
+    resources.MaxAccelerationStructureBindingsNGE = 4;
+    const std::string source                      = R"(#version 310 es
+        #extension GL_NGE_ray_query : require
+        precision highp float;
+        precision highp int;
+        layout(binding=2) uniform accelerationStructureEXT scene;
+        layout(location=0) out vec4 color;
+        void main() {
+            rayQueryEXT q;
+            rayQueryInitializeEXT(q, scene, 0u, 255u, vec3(0), 0.0, vec3(0,0,1), 100.0);
+            while (rayQueryProceedEXT(q)) rayQueryConfirmIntersectionEXT(q);
+            color = vec4(rayQueryGetIntersectionTEXT(q, true),
+                         rayQueryGetWorldRayOriginEXT(q).x,
+                         rayQueryGetWorldRayDirectionEXT(q).z,
+                         float(rayQueryGetRayFlagsEXT(q)) + rayQueryGetRayTMinEXT(q));
+        })";
+    ShCompileOptions options;
+    options.objectCode = true;
+    // Match ShaderMtl's initialization pass: traversal state must remain an
+    // uninitialized native local until rayQueryInitializeEXT is called.
+    options.initializeUninitializedLocals       = true;
+    options.metal.driverUniformsBindingIndex    = 17;
+    options.metal.defaultUniformsBindingIndex   = 19;
+    options.metal.UBOArgumentBufferBindingIndex = 24;
+    ShHandle compiler =
+        sh::ConstructCompiler(GL_FRAGMENT_SHADER, SH_GLES3_1_SPEC, SH_MSL_METAL_OUTPUT, &resources);
+    if (!compiler)
+    {
+        GTEST_SKIP() << "Metal translator is not built";
+    }
+    const char *strings[] = {source.c_str()};
+    bool success          = sh::Compile(compiler, strings, 1, options);
+    std::string code      = sh::GetObjectCode(compiler);
+    mLog                  = sh::GetInfoLog(compiler);
+    sh::Destruct(compiler);
+    ASSERT_TRUE(success) << mLog;
+    EXPECT_NE(code.find("intersection_query<"), std::string::npos) << code;
+    EXPECT_NE(code.find("[[buffer(18)]]"), std::string::npos) << code;
+    EXPECT_NE(code.find("[[id(2)]]"), std::string::npos) << code;
+    EXPECT_NE(code.find("rayQueryInitializeEXT("), std::string::npos) << code;
+}
+
+TEST_F(NGERayQueryTest, ESSL300BindingExtensionAppliesOnlyToAccelerationStructures)
+{
+    EXPECT_TRUE(compile(GL_FRAGMENT_SHADER,
+                        "layout(binding=2) uniform accelerationStructureEXT scene;", "", true, true,
+                        300))
+        << mLog;
+    EXPECT_FALSE(compile(GL_FRAGMENT_SHADER, "layout(binding=2) uniform sampler2D image;", "", true,
+                         true, 300));
+    EXPECT_FALSE(compile(GL_FRAGMENT_SHADER,
+                         "layout(std140,binding=2) uniform Values { vec4 value; };", "", true, true,
+                         300));
+}
+
+TEST_F(NGERayQueryTest, CapabilityAndDirectiveRequired)
+{
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, "", "rayQueryEXT q;", false));
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, "", "rayQueryEXT q;", true, false));
+}
+
+TEST_F(NGERayQueryTest, ShaderUsesKhronosNames)
+{
+    const std::string scene = "layout(binding=0) uniform accelerationStructureEXT scene;";
+    const std::string args = "(q, scene, 0u, 255u, vec3(0), 0.0, vec3(0,0,1), 1.0);";
+    EXPECT_TRUE(compile(GL_COMPUTE_SHADER, scene, "rayQueryEXT q; rayQueryInitializeEXT" + args))
+        << mLog;
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, scene, "rayQueryNGE q;"));
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, scene, "rayQueryEXT q; rayQueryInitializeNGE" + args));
+}
+
+TEST_F(NGERayQueryTest, BindingMustBeExplicitAndInRange)
+{
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, "uniform accelerationStructureEXT scene;", ""));
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER,
+                         "layout(binding=4) uniform accelerationStructureEXT scene;", ""));
+    EXPECT_TRUE(
+        compile(GL_COMPUTE_SHADER, "layout(binding=3) uniform accelerationStructureEXT scene;", ""))
+        << mLog;
+}
+
+TEST_F(NGERayQueryTest, AccelerationStructureArrayBindingsAreContiguous)
+{
+    EXPECT_TRUE(compile(GL_COMPUTE_SHADER,
+                        "layout(binding=1) uniform accelerationStructureEXT scenes[2];",
+                        "rayQueryEXT q; rayQueryInitializeEXT(q, scenes[1], 0u, 255u, "
+                        "vec3(0), 0.0, vec3(0,0,1), 10.0);"))
+        << mLog;
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER,
+                         "layout(binding=3) uniform accelerationStructureEXT scenes[2];", ""));
+}
+
+TEST_F(NGERayQueryTest, AccelerationStructureCanBePassedToAFunction)
+{
+    EXPECT_TRUE(compile(GL_COMPUTE_SHADER, R"(
+        layout(binding=0) uniform accelerationStructureEXT scene;
+        void initialize(accelerationStructureEXT s) {
+            rayQueryEXT q;
+            rayQueryInitializeEXT(q, s, 0u, 255u, vec3(0), 0.0, vec3(0,0,1), 10.0);
+        }
+    )", "initialize(scene);")) << mLog;
+}
+
+TEST_F(NGERayQueryTest, TraversalStateCannotEscapeInvocation)
+{
+    EXPECT_TRUE(compile(GL_COMPUTE_SHADER, "rayQueryEXT q;", "")) << mLog;
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, "shared rayQueryEXT q;", ""));
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, "uniform rayQueryEXT q;", ""));
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, "struct S { rayQueryEXT q; };", ""));
+    EXPECT_TRUE(compile(GL_COMPUTE_SHADER, "void f(rayQueryEXT q) {}", "")) << mLog;
+    EXPECT_TRUE(compile(GL_COMPUTE_SHADER, "", "rayQueryEXT q[2];")) << mLog;
+}
+
+TEST_F(NGERayQueryTest, QueryStateCanBePassedAndIndexed)
+{
+    const std::string declarations = R"(
+        layout(binding=0) uniform accelerationStructureEXT scene;
+        void initQuery(rayQueryEXT query) {
+            rayQueryInitializeEXT(query, scene, 0u, 255u, vec3(0), 0.0, vec3(0,0,1), 10.0);
+        }
+    )";
+    EXPECT_TRUE(compile(GL_COMPUTE_SHADER, declarations, R"(
+        rayQueryEXT queries[2];
+        int index = 1;
+        initQuery(queries[index]);
+        bool found = rayQueryProceedEXT(queries[index]);
+    )")) << mLog;
+}
+
+TEST_F(NGERayQueryTest, TraversalStateCannotBeCopiedOrConstructed)
+{
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, "", "rayQueryEXT q; rayQueryEXT r=q;"));
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, "", "rayQueryEXT q; rayQueryEXT r; r=q;"));
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, "", "rayQueryEXT q=rayQueryEXT();"));
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, "", "rayQueryEXT q; bool x=(q==q);"));
+}
+
+TEST_F(NGERayQueryTest, IntersectionSelectorMustBeConstant)
+{
+    EXPECT_FALSE(compile(GL_COMPUTE_SHADER, "", R"(
+        rayQueryEXT q; bool committed = gl_LocalInvocationID.x == 0u;
+        uint t = rayQueryGetIntersectionTypeEXT(q, committed);
+    )"));
+    EXPECT_TRUE(compile(GL_COMPUTE_SHADER, "", R"(
+        rayQueryEXT q; const bool committed = true;
+        uint t = rayQueryGetIntersectionTypeEXT(q, committed);
+    )")) << mLog;
+}
+}  // namespace
+}  // namespace sh
