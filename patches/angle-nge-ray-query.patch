+PROGRAM_PRELUDE_DECLARE(rayQuery, R"(
+#include <metal_raytracing>
+using ANGLE_ray_query_native = metal::raytracing::intersection_query<metal::raytracing::instancing,
+                                                                     metal::raytracing::triangle_data>;
+struct ANGLE_ray_query {
+    thread ANGLE_ray_query_native *native;
+    thread uint *flags;
+};
+ANGLE_ALWAYS_INLINE void rayQueryInitializeEXT(ANGLE_ray_query q,
+    metal::raytracing::instance_acceleration_structure scene, uint flags, uint mask,
+    float3 origin, float tMin, float3 direction, float tMax)
+{
+    using namespace metal::raytracing;
+    *q.flags = flags;
+    intersection_params params;
+    params.set_triangle_front_facing_winding(metal::winding::clockwise);
+    params.set_triangle_cull_mode((flags & 16u) ? triangle_cull_mode::back :
+                                 (flags & 32u) ? triangle_cull_mode::front : triangle_cull_mode::none);
+    params.set_opacity_cull_mode((flags & 64u) ? opacity_cull_mode::opaque :
+                                (flags & 128u) ? opacity_cull_mode::non_opaque : opacity_cull_mode::none);
+    params.force_opacity((flags & 1u) ? forced_opacity::opaque :
+                         (flags & 2u) ? forced_opacity::non_opaque : forced_opacity::none);
+    params.set_geometry_cull_mode((flags & 256u) ? geometry_cull_mode::triangle :
+                                 (flags & 512u) ? geometry_cull_mode::bounding_box :
+                                 geometry_cull_mode::none);
+    params.accept_any_intersection((flags & 4u) != 0);
+    q.native->reset(ray(origin, direction, tMin, tMax), scene, mask & 255u, params);
+}
+ANGLE_ALWAYS_INLINE bool rayQueryProceedEXT(ANGLE_ray_query q) { return q.native->next(); }
+ANGLE_ALWAYS_INLINE void rayQueryTerminateEXT(ANGLE_ray_query q) { q.native->abort(); }
+ANGLE_ALWAYS_INLINE void rayQueryConfirmIntersectionEXT(ANGLE_ray_query q)
+{ q.native->commit_triangle_intersection(); }
+ANGLE_ALWAYS_INLINE void rayQueryGenerateIntersectionEXT(ANGLE_ray_query q, float t)
+{ q.native->commit_bounding_box_intersection(t); }
+ANGLE_ALWAYS_INLINE uint rayQueryGetRayFlagsEXT(ANGLE_ray_query q)
+{ return *q.flags; }
+ANGLE_ALWAYS_INLINE float rayQueryGetRayTMinEXT(ANGLE_ray_query q)
+{ return q.native->get_ray_min_distance(); }
+ANGLE_ALWAYS_INLINE float3 rayQueryGetWorldRayOriginEXT(ANGLE_ray_query q)
+{ return q.native->get_world_space_ray_origin(); }
+ANGLE_ALWAYS_INLINE float3 rayQueryGetWorldRayDirectionEXT(ANGLE_ray_query q)
+{ return q.native->get_world_space_ray_direction(); }
+ANGLE_ALWAYS_INLINE uint rayQueryGetIntersectionTypeEXT(ANGLE_ray_query q, bool committed)
