+bool ValidateAccelerationStructureBindings(const Context *context, angle::EntryPoint entryPoint)
+{
+    const auto *executable = context->getState().getProgramExecutable();
+    if (!executable)
+        return true;
+    // This cannot be cached: another sharing context may build a previously
+    // unbuilt object without changing this context's ordinary draw-state cache.
+    for (const auto &uniform : executable->getUniforms())
+    {
+        if (!uniform.isAccelerationStructure())
+            continue;
+        for (unsigned int element = 0; element < uniform.getBasicTypeElementCount(); ++element)
+        {
+            auto *structure = context->getAccelerationStructureBinding(
+                uniform.getBinding() + uniform.getOuterArrayOffset() + element);
+            if (!structure || !structure->isBuilt() ||
+                structure->getKind() != AccelerationStructure::Kind::Top)
+            {
+                ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, "Missing built top-level acceleration structure");
+                return false;
+            }
+        }
+    }
+    return true;
+}
