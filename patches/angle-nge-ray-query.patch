@@ -0,0 +1,71 @@
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "libANGLE/AccelerationStructure.h"
+#include "libANGLE/renderer/AccelerationStructureImpl.h"
+#include "libANGLE/renderer/GLImplFactory.h"
+namespace gl
+{
+AccelerationStructure::AccelerationStructure(rx::GLImplFactory *factory, AccelerationStructureID id)
+    : RefCountObject(factory->generateSerial(), id),
+      mImplementation(factory->createAccelerationStructure())
+{
+    ASSERT(mImplementation);
+}
+AccelerationStructure::~AccelerationStructure() = default;
+void AccelerationStructure::onDestroy(const Context *context)
+{
+    for (auto &instance : mInstances)
+    {
+        instance.blas.set(context, nullptr);
+    }
+    mInstances.clear();
+    mImplementation->onDestroy(context);
+}
+angle::Result AccelerationStructure::buildTriangles(const Context *context,
+                                                    const AccelerationStructureTriangles &triangles)
+{
+    ANGLE_TRY(mImplementation->buildTriangles(context, triangles));
+    mKind  = Kind::Bottom;
+    mBuilt = true;
+    return angle::Result::Continue;
+}
+angle::Result AccelerationStructure::buildAabbs(const Context *context,
+                                                const AccelerationStructureAabbs &aabbs)
+{
+    ANGLE_TRY(mImplementation->buildAabbs(context, aabbs));
+    mKind  = Kind::Bottom;
+    mBuilt = true;
+    return angle::Result::Continue;
+}
+void AccelerationStructure::setInstance(const Context *context,
+                                        GLuint slot,
+                                        AccelerationStructure *blas,
+                                        const GLfloat *transform,
+                                        GLuint customIndex,
+                                        GLuint mask,
+                                        GLbitfield flags)
+{
+    mKind = Kind::Top;
+    if (mInstances.size() <= slot)
+    {
+        mInstances.resize(slot + 1);
+    }
+    auto &instance = mInstances[slot];
+    instance.blas.set(context, blas);
+    std::copy(transform, transform + 12, instance.transform.begin());
+    instance.customIndex = customIndex;
+    instance.mask        = mask;
+    instance.flags       = flags;
+}
+angle::Result AccelerationStructure::buildTopLevel(const Context *context,
+                                                   GLsizei count,
+                                                   GLbitfield flags)
+{
+    ANGLE_TRY(mImplementation->buildTopLevel(context, mInstances, count, flags));
+    mKind  = Kind::Top;
+    mBuilt = true;
+    return angle::Result::Continue;
+}
+}  // namespace gl
