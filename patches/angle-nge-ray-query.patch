+bool ValidateRayQueryNGE(const Context *context, angle::EntryPoint entryPoint) {
+    if (!context->getExtensions().rayQueryNGE) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, "GL_NGE_ray_query is unavailable"); return false;
+    }
+    return true;
+}
+bool ValidateASObject(const Context *context, angle::EntryPoint entryPoint,
+    AccelerationStructureID id, AccelerationStructure::Kind excluded) {
+    auto *object = context->getAccelerationStructure(id);
+    if (!object) { ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Unknown acceleration structure"); return false; }
+    if (object->getKind() == excluded) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, "Acceleration structure kind cannot change"); return false;
+    }
+    return true;
+}
+bool ValidateASBuildFlags(const Context *context, angle::EntryPoint entryPoint, GLbitfield flags) {
+    if ((flags & ~3u) || flags == 3) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Invalid acceleration structure build flags"); return false;
+    }
+    return true;
+}
+bool ValidateASBufferRange(const Context *context, angle::EntryPoint entryPoint,
+    BufferID id, GLintptr offset, uint64_t bytes, GLuint alignment) {
+    auto *buffer = context->getBuffer(id);
+    if (!buffer) { ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Unknown geometry buffer"); return false; }
+    if (buffer->isMapped()) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, "Acceleration structure input is mapped"); return false;
+    }
+    if (offset < 0 || uint64_t(offset) % alignment ||
+        uint64_t(offset) > uint64_t(buffer->getSize()) ||
+        bytes > uint64_t(buffer->getSize()) - uint64_t(offset)) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Acceleration structure input exceeds buffer range or alignment"); return false;
+    }
+    return true;
+}
+}
+bool ValidateGenAccelerationStructures(const Context *context, angle::EntryPoint entryPoint,
+    GLsizei n, const AccelerationStructureID *structures) {
+    return ValidateRayQueryNGE(context, entryPoint) &&
+        ValidateGenOrDelete(context->getMutableErrorSetForValidation(), entryPoint, n, structures);
+}
+bool ValidateDeleteAccelerationStructures(const Context *context, angle::EntryPoint entryPoint,
+    GLsizei n, const AccelerationStructureID *structures) {
+    return ValidateGenAccelerationStructures(context, entryPoint, n, structures);
+}
+bool ValidateIsAccelerationStructure(const Context *context, angle::EntryPoint entryPoint,
+    AccelerationStructureID structure) {
+    return ValidateRayQueryNGE(context, entryPoint);
+}
+bool ValidateBuildTriangleAccelerationStructure(const Context *context, angle::EntryPoint entryPoint,
+    AccelerationStructureID structure, BufferID vertexBuffer, GLintptr vertexOffset,
+    GLsizei vertexStride, GLsizei vertexCount, BufferID indexBuffer, GLintptr indexOffset,
+    GLenum indexType, GLsizei indexCount, GLbitfield flags) {
+    if (!ValidateRayQueryNGE(context, entryPoint) ||
+        !ValidateASObject(context, entryPoint, structure, AccelerationStructure::Kind::Top) ||
+        !ValidateASBuildFlags(context, entryPoint, flags)) return false;
+    if (vertexCount < 3 || vertexStride < 12 || vertexStride % 4) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Invalid triangle vertex count or stride"); return false;
+    }
+    if (!ValidateASBufferRange(context, entryPoint, vertexBuffer, vertexOffset,
+        uint64_t(vertexCount - 1) * uint64_t(vertexStride) + 12, 4)) return false;
+    if (indexBuffer.value == 0) {
+        if (indexType != GL_NONE) { ANGLE_VALIDATION_ERROR(GL_INVALID_ENUM, "Non-indexed geometry requires NONE"); return false; }
+        if (indexCount != 0 || indexOffset != 0 || vertexCount % 3) {
+            ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Non-indexed geometry must contain complete triangles"); return false;
+        }
+    } else {
+        if (indexType != GL_UNSIGNED_SHORT && indexType != GL_UNSIGNED_INT) {
+            ANGLE_VALIDATION_ERROR(GL_INVALID_ENUM, "Triangle indices must be unsigned short or int"); return false;
+        }
+        if (indexCount <= 0 || indexCount % 3) {
+            ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Index count must contain complete triangles"); return false;
+        }
+        GLuint size = indexType == GL_UNSIGNED_SHORT ? 2 : 4;
+        if (!ValidateASBufferRange(context, entryPoint, indexBuffer, indexOffset,
+                                  uint64_t(indexCount) * size, size)) return false;
+    }
+    return true;
+}
+bool ValidateBuildAabbAccelerationStructure(const Context *context, angle::EntryPoint entryPoint,
+    AccelerationStructureID structure, BufferID buffer, GLintptr offset, GLsizei stride,
+    GLsizei count, GLbitfield flags) {
+    if (!ValidateRayQueryNGE(context, entryPoint) ||
+        !ValidateASObject(context, entryPoint, structure, AccelerationStructure::Kind::Top) ||
+        !ValidateASBuildFlags(context, entryPoint, flags)) return false;
+    if (count <= 0 || stride < 24 || stride % 4 || offset < 0 || offset % stride) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Invalid AABB count, stride or offset"); return false;
+    }
+    return ValidateASBufferRange(context, entryPoint, buffer, offset,
+                                 uint64_t(count - 1) * uint64_t(stride) + 24, 4);
+}
+bool ValidateSetAccelerationStructureInstance(const Context *context, angle::EntryPoint entryPoint,
+    AccelerationStructureID structure, GLuint instance, AccelerationStructureID blas,
+    const GLfloat *transform, GLuint customIndex, GLuint mask, GLbitfield flags) {
+    if (!ValidateRayQueryNGE(context, entryPoint) ||
+        !ValidateASObject(context, entryPoint, structure, AccelerationStructure::Kind::Bottom)) return false;
+    auto *bottom = context->getAccelerationStructure(blas);
+    if (!bottom || !bottom->isBuilt() || bottom->getKind() != AccelerationStructure::Kind::Bottom) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, "Instance requires a built BLAS"); return false;
+    }
+    if (!transform || instance >= 65536 || customIndex > 0xffffff || mask > 0xff ||
+        (flags & ~15u) || ((flags & 12u) == 12u)) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Invalid instance slot, transform, index, mask or flags"); return false;
+    }
+    for (int i=0; i<12; ++i) {
+        if (!std::isfinite(transform[i])) {
+            ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Instance transform must be finite"); return false;
+        }
+    }
+    double a=transform[0], b=transform[1], c=transform[2];
+    double d=transform[4], e=transform[5], f=transform[6];
+    double g=transform[8], h=transform[9], i=transform[10];
+    if (a*(e*i-f*h)-b*(d*i-f*g)+c*(d*h-e*g) == 0) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Instance transform must be invertible"); return false;
+    }
+    return true;
+}
+bool ValidateBuildTopLevelAccelerationStructure(const Context *context, angle::EntryPoint entryPoint,
+    AccelerationStructureID structure, GLsizei instanceCount, GLbitfield flags) {
+    if (!ValidateRayQueryNGE(context, entryPoint) ||
+        !ValidateASObject(context, entryPoint, structure, AccelerationStructure::Kind::Bottom) ||
+        !ValidateASBuildFlags(context, entryPoint, flags)) return false;
+    const auto &instances = context->getAccelerationStructure(structure)->getInstances();
+    if (instanceCount <= 0 || uint64_t(instanceCount) > instances.size()) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "TLAS requires configured instances"); return false;
+    }
+    for (int i=0; i<instanceCount; ++i) {
+        if (!instances[i].blas.get() || !instances[i].blas->isBuilt()) {
+            ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, "TLAS instance has no built BLAS"); return false;
+        }
+    }
+    return true;
+}
+bool ValidateBindAccelerationStructure(const Context *context, angle::EntryPoint entryPoint,
+    GLuint binding, AccelerationStructureID structure) {
+    if (!ValidateRayQueryNGE(context, entryPoint)) return false;
+    if (binding >= kMaxAccelerationStructureBindings) {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_VALUE, "Acceleration structure binding exceeds limit"); return false;
+    }
+    if (structure.value == 0) return true;
+    return ValidateASObject(context, entryPoint, structure, AccelerationStructure::Kind::Bottom);
+}
