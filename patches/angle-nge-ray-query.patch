+angle::Result ProgramExecutableMtl::encodeAccelerationStructures(
+    ContextMtl *context, gl::ShaderType stage, mtl::RenderCommandEncoder *render,
+    mtl::ComputeCommandEncoder *compute)
+{
+    bool active = false;
+    for (const auto &uniform : mExecutable->getUniforms())
+        active |= uniform.isAccelerationStructure() && uniform.isActive(stage);
+    if (!active)
+        return angle::Result::Continue;
+    auto *variant = mCurrentShaderVariants[stage];
+    if (!compute && !variant)
+        return angle::Result::Continue;
+    auto &encoder = compute ? mComputeAccelerationStructureEncoder : variant->accelerationStructureEncoder;
+    if (!encoder.metalArgBufferEncoder)
+        InitArgumentBufferEncoder(context, compute ? mComputeFunction.get() : variant->metalShader.get(),
+                                   18, &encoder);
+    ANGLE_CHECK(context, encoder.metalArgBufferEncoder, "Missing acceleration structure argument encoder",
+                GL_INVALID_OPERATION);
+    mtl::BufferSlice arguments;
+    encoder.bufferPool.releaseInFlightBuffers(context);
+    const size_t bytes = encoder.metalArgBufferEncoder.get().encodedLength;
+    ANGLE_TRY(encoder.bufferPool.allocate(context, bytes, &arguments));
+    ANGLE_UNUSED_VARIABLE(arguments.buffer()->mapNoSync(context));
+    [encoder.metalArgBufferEncoder setArgumentBuffer:arguments.buffer()->get() offset:arguments.offset()];
+    for (const auto &uniform : mExecutable->getUniforms())
+    {
+        if (!uniform.isAccelerationStructure() || !uniform.isActive(stage))
+            continue;
+        for (uint32_t element = 0; element < uniform.getBasicTypeElementCount(); ++element)
+        {
+            auto *structure = context->getState().getAccelerationStructureBinding(uniform.getBinding() + uniform.getOuterArrayOffset() + element);
+            ANGLE_CHECK(context, structure && structure->isBuilt() &&
+                        structure->getKind() == gl::AccelerationStructure::Kind::Top,
+                        "Missing built top-level acceleration structure", GL_INVALID_OPERATION);
+            auto *native = static_cast<AccelerationStructureMtl *>(structure->getImplementation());
+            const auto &generation = native->getGeneration();
+            ANGLE_CHECK(context, generation, "Missing acceleration structure generation", GL_INVALID_OPERATION);
+            [encoder.metalArgBufferEncoder setAccelerationStructure:generation->get() atIndex:uniform.getBinding() + uniform.getOuterArrayOffset() + element];
+            native->useForRead(render, compute, stage);
+        }
+    }
+    arguments.buffer()->unmapAndFlushSubset(context, arguments.offset(), bytes);
+    if (compute)
+        compute->setBuffer(arguments.buffer(), arguments.offset(), 18);
+    else
+        render->setBuffer(stage, arguments.buffer(), arguments.offset(), 18);
+    return angle::Result::Continue;
+}
