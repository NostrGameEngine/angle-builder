+        case EOpRayQueryGetIntersectionGeometryIndexEXT:
+            spirv::WriteRayQueryGetIntersectionGeometryIndexKHR(block, resultTypeId, result, query, parameters[0]); break;
+        case EOpRayQueryGetIntersectionPrimitiveIndexEXT:
+            spirv::WriteRayQueryGetIntersectionPrimitiveIndexKHR(block, resultTypeId, result, query, parameters[0]); break;
+        case EOpRayQueryGetIntersectionBarycentricsEXT:
+            spirv::WriteRayQueryGetIntersectionBarycentricsKHR(block, resultTypeId, result, query, parameters[0]); break;
+        case EOpRayQueryGetIntersectionFrontFaceEXT:
+            spirv::WriteRayQueryGetIntersectionFrontFaceKHR(block, resultTypeId, result, query, parameters[0]); break;
+        case EOpRayQueryGetIntersectionObjectRayOriginEXT:
