+spirv::IdRef OutputSPIRVTraverser::createRayQueryBuiltIn(TIntermOperator *node,
+                                                           spirv::IdRef resultTypeId)
+{
+    const size_t count = node->getChildCount();
+    ASSERT(count > 0);
+    // The traversal state operand is always a Function pointer, never OpLoad'ed.
+    NodeData &state = mNodeData[mNodeData.size() - count];
+    const spirv::IdRef query = accessChainCollapse(&state);
+    auto *block = mBuilder.getSpirvCurrentFunctionBlock();
+    const auto result = node->getType().getBasicType() == EbtVoid ? spirv::IdRef{} :
+        mBuilder.getNewId(mBuilder.getDecorations(node->getType()));
+    spirv::IdRefList parameters;
+    const bool selector = count == 2 &&
+        node->getChildNode(1)->getAsTyped()->getBasicType() == EbtBool;
+    for (size_t param = 1; param < count; ++param)
+    {
+        auto *operand = node->getChildNode(param)->getAsTyped();
+        if (selector)
+        {
+            ASSERT(operand->hasConstantValue());
+            parameters.push_back(mBuilder.getUintConstant(operand->getConstantValue()->getBConst() ? 1 : 0));
+        }
+        else
+        {
+            spirv::IdRef typeId;
+            parameters.push_back(accessChainLoad(&mNodeData[mNodeData.size() - count + param],
+                                                 operand->getType(), &typeId));
+        }
+    }
+    switch (node->getOp())
