+        case EOpRayQueryInitializeEXT:
+            spirv::WriteRayQueryInitializeKHR(block, query, parameters[0], parameters[1],
+                parameters[2], parameters[3], parameters[4], parameters[5], parameters[6]); break;
+        case EOpRayQueryProceedEXT:
+            spirv::WriteRayQueryProceedKHR(block, resultTypeId, result, query); break;
+        case EOpRayQueryTerminateEXT:
+            spirv::WriteRayQueryTerminateKHR(block, query); break;
+        case EOpRayQueryConfirmIntersectionEXT:
+            spirv::WriteRayQueryConfirmIntersectionKHR(block, query); break;
+        case EOpRayQueryGenerateIntersectionEXT:
+            spirv::WriteRayQueryGenerateIntersectionKHR(block, query, parameters[0]); break;
+        case EOpRayQueryGetRayTMinEXT:
+            spirv::WriteRayQueryGetRayTMinKHR(block, resultTypeId, result, query); break;
+        case EOpRayQueryGetRayFlagsEXT:
+            spirv::WriteRayQueryGetRayFlagsKHR(block, resultTypeId, result, query); break;
+        case EOpRayQueryGetWorldRayOriginEXT:
+            spirv::WriteRayQueryGetWorldRayOriginKHR(block, resultTypeId, result, query); break;
+        case EOpRayQueryGetWorldRayDirectionEXT:
+            spirv::WriteRayQueryGetWorldRayDirectionKHR(block, resultTypeId, result, query); break;
+        case EOpRayQueryGetIntersectionTypeEXT:
+            spirv::WriteRayQueryGetIntersectionTypeKHR(block, resultTypeId, result, query, parameters[0]); break;
+        case EOpRayQueryGetIntersectionTEXT:
+            spirv::WriteRayQueryGetIntersectionTKHR(block, resultTypeId, result, query, parameters[0]); break;
+        case EOpRayQueryGetIntersectionInstanceCustomIndexEXT:
+            spirv::WriteRayQueryGetIntersectionInstanceCustomIndexKHR(block, resultTypeId, result, query, parameters[0]); break;
+        case EOpRayQueryGetIntersectionInstanceIdEXT:
+            spirv::WriteRayQueryGetIntersectionInstanceIdKHR(block, resultTypeId, result, query, parameters[0]); break;
+        case EOpRayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT:
