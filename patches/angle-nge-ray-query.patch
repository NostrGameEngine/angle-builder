+void Context::deleteAccelerationStructures(GLsizei n, const AccelerationStructureID *structures) {
+    for (GLsizei i=0; i<n; ++i) {
+        auto *object = getAccelerationStructure(structures[i]);
+        if (!object) continue;
+        for (auto &binding : mState.mAccelerationStructureBindings) {
+            if (binding.get() == object) binding.set(this, nullptr);
+        }
+        mState.mAccelerationStructureManager->deleteAccelerationStructure(this, structures[i]);
+    }
