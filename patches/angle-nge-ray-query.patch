+// AccelerationStructureManager Implementation.
+
+AccelerationStructureManager::AccelerationStructureManager() {}
+
+AccelerationStructureManager::~AccelerationStructureManager()
+{
+    ASSERT(UnsafeResourceMapIter(mAccelerationStructures).empty());
+}
+
+void AccelerationStructureManager::reset(const Context *context)
+{
+    // Note: this function is called when the last context in the share group is destroyed.  Thus
+    // there are no thread safety concerns.
+    mHandleAllocator.reset();
+    for (const auto &accelerationStructure : UnsafeResourceMapIter(mAccelerationStructures))
+    {
+        if (accelerationStructure.second)
+        {
+            accelerationStructure.second->release(context);
+        }
+    }
+    mAccelerationStructures.clear();
+}
+
+bool AccelerationStructureManager::createAccelerationStructure(rx::GLImplFactory *factory,
+                                             AccelerationStructureID *outAccelerationStructure)
+{
+    if (!mHandleAllocator.allocate(&outAccelerationStructure->value))
+    {
+        return false;
+    }
+    AccelerationStructure *accelerationStructure = new AccelerationStructure(factory, *outAccelerationStructure);
+    accelerationStructure->addRef();
+    mAccelerationStructures.assign(*outAccelerationStructure, accelerationStructure);
+    return true;
+}
+
+void AccelerationStructureManager::deleteAccelerationStructure(const Context *context, AccelerationStructureID handle)
+{
+    AccelerationStructure *accelerationStructure = nullptr;
+    if (!mAccelerationStructures.erase(handle, &accelerationStructure))
+    {
+        return;
+    }
+
+    // Requires an explicit this-> because of C++ template rules.
+    this->mHandleAllocator.release(handle.value);
+
+    if (accelerationStructure)
+    {
+        accelerationStructure->release(context);
+    }
+}
+
+AccelerationStructure *AccelerationStructureManager::getAccelerationStructure(AccelerationStructureID handle) const
+{
+    return mAccelerationStructures.query(handle);
+}
