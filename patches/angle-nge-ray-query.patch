new file mode 100644
index 0000000000000000000000000000000000000000..1139e7a8f68dbcc134ca0c58de67f4eff13cc025
--- /dev/null
+++ b/src/libANGLE/renderer/metal/AccelerationStructureMtl.mm
@@ -0,0 +1,213 @@
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "libANGLE/renderer/metal/AccelerationStructureMtl.h"
+#include "common/unsafe_buffers.h"
+#include "libANGLE/renderer/metal/BufferMtl.h"
+#include "libANGLE/renderer/metal/ContextMtl.h"
+
+namespace rx
+{
+AccelerationStructureGenerationMtl::AccelerationStructureGenerationMtl(
+    id<MTLAccelerationStructure> structure,
+    size_t bytes)
+    : mStructure(structure), mBytes(bytes)
+{}
+
+void AccelerationStructureMtl::onDestroy(const gl::Context *)
+{
+    mGeneration.reset();
+}
+
+angle::Result AccelerationStructureMtl::build(
+    ContextMtl *context,
+    MTLAccelerationStructureDescriptor *descriptor,
+    const std::vector<mtl::ResourceRef> &inputs,
+    std::vector<std::shared_ptr<AccelerationStructureGenerationMtl>> children)
+{
+    const auto &device = context->getMetalDevice();
+    MTLAccelerationStructureSizes sizes =
+        [device.get() accelerationStructureSizesWithDescriptor:descriptor];
+    auto native = angle::adoptObjCPtr(
+        [device.get() newAccelerationStructureWithSize:sizes.accelerationStructureSize]);
+    ANGLE_CHECK(context, native, "Cannot allocate Metal acceleration structure", GL_OUT_OF_MEMORY);
+    device.setOwnerWithIdentity(native.get());
+    mtl::BufferRef scratch;
+    ANGLE_TRY(mtl::Buffer::MakeBufferWithStorageMode(context, MTLStorageModePrivate,
+                                                     sizes.buildScratchBufferSize, &scratch));
+    auto generation = std::make_shared<AccelerationStructureGenerationMtl>(
+        native.get(), sizes.accelerationStructureSize);
+    generation->children = std::move(children);
+    // Ending previous encoders orders GPU geometry writes and preceding builds.
+    // Metal's tracked resources also cover cross-command-buffer dependencies.
+    auto &commands = context->getAccelerationStructureCommandBuffer();
+    for (const auto &input : inputs)
+    {
+        commands.setReadDependency(input, false);
+    }
+    for (const auto &child : generation->children)
+    {
+        commands.setReadDependency(child, false);
+    }
+    commands.setWriteDependency(generation, false);
+    commands.setWriteDependency(scratch, false);
+    id<MTLAccelerationStructureCommandEncoder> encoder =
+        [commands.get() accelerationStructureCommandEncoder];
+    ANGLE_CHECK(context, encoder, "Cannot create Metal acceleration structure encoder",
+                GL_OUT_OF_MEMORY);
+    [encoder buildAccelerationStructure:native.get()
+                             descriptor:descriptor
+                          scratchBuffer:scratch->get()
+                    scratchBufferOffset:0];
+    [encoder endEncoding];
+    mGeneration = std::move(generation);
+    return angle::Result::Continue;
+}
+
+angle::Result AccelerationStructureMtl::buildTriangles(
+    const gl::Context *glContext,
+    const gl::AccelerationStructureTriangles &triangles)
+{
+    ContextMtl *context     = mtl::GetImpl(glContext);
+    mtl::BufferRef vertices = mtl::GetImpl(triangles.vertexBuffer)->getCurrentBuffer();
+    ANGLE_CHECK(context, vertices, "Missing Metal geometry storage", GL_INVALID_OPERATION);
+    auto geometry               = [MTLAccelerationStructureTriangleGeometryDescriptor descriptor];
+    geometry.vertexBuffer       = vertices->get();
+    geometry.vertexBufferOffset = triangles.vertexOffset;
+    geometry.vertexStride       = triangles.vertexStride;
+    geometry.vertexFormat       = MTLAttributeFormatFloat3;
+    geometry.opaque             = NO;
+    geometry.allowDuplicateIntersectionFunctionInvocation = NO;
+    std::vector<mtl::ResourceRef> inputs                  = {vertices};
+    if (triangles.indexBuffer)
+    {
+        mtl::BufferRef indices = mtl::GetImpl(triangles.indexBuffer)->getCurrentBuffer();
+        ANGLE_CHECK(context, indices, "Missing Metal index storage", GL_INVALID_OPERATION);
+        geometry.indexBuffer       = indices->get();
+        geometry.indexBufferOffset = triangles.indexOffset;
+        geometry.indexType =
+            triangles.indexType == GL_UNSIGNED_SHORT ? MTLIndexTypeUInt16 : MTLIndexTypeUInt32;
+        geometry.triangleCount = triangles.indexCount / 3;
+        inputs.push_back(indices);
+    }
+    else
+    {
+        geometry.triangleCount = triangles.vertexCount / 3;
+    }
+    auto descriptor                = [MTLPrimitiveAccelerationStructureDescriptor descriptor];
+    descriptor.geometryDescriptors = @[ geometry ];
+    descriptor.usage = (triangles.flags & GL_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT)
+                           ? MTLAccelerationStructureUsagePreferFastBuild
+                           : MTLAccelerationStructureUsageNone;
+    return build(context, descriptor, inputs, {});
+}
+
+angle::Result AccelerationStructureMtl::buildAabbs(
+    const gl::Context *glContext,
+    const gl::AccelerationStructureAabbs &aabbs)
+{
+    ContextMtl *context = mtl::GetImpl(glContext);
+    mtl::BufferRef buffer = mtl::GetImpl(aabbs.buffer)->getCurrentBuffer();
+    ANGLE_CHECK(context, buffer, "Missing Metal AABB storage", GL_INVALID_OPERATION);
+    auto geometry = [MTLAccelerationStructureBoundingBoxGeometryDescriptor descriptor];
+    geometry.boundingBoxBuffer = buffer->get();
+    geometry.boundingBoxBufferOffset = aabbs.offset;
+    geometry.boundingBoxStride = aabbs.stride;
+    geometry.boundingBoxCount = aabbs.count;
+    geometry.opaque = NO;
+    geometry.allowDuplicateIntersectionFunctionInvocation = NO;
+    auto descriptor = [MTLPrimitiveAccelerationStructureDescriptor descriptor];
+    descriptor.geometryDescriptors = @[ geometry ];
+    descriptor.usage = (aabbs.flags & GL_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT)
+                           ? MTLAccelerationStructureUsagePreferFastBuild
+                           : MTLAccelerationStructureUsageNone;
+    return build(context, descriptor, {buffer}, {});
+}
+
+angle::Result AccelerationStructureMtl::buildTopLevel(
+    const gl::Context *glContext,
+    const std::deque<gl::AccelerationStructureInstance> &instances,
+    GLsizei count,
+    GLbitfield flags)
+{
+    ContextMtl *context = mtl::GetImpl(glContext);
+    std::vector<MTLAccelerationStructureUserIDInstanceDescriptor> descriptors(count);
+    std::vector<std::shared_ptr<AccelerationStructureGenerationMtl>> children;
+    auto nativeChildren = angle::adoptObjCPtr([[NSMutableArray alloc] initWithCapacity:count]);
+    for (GLsizei index = 0; index < count; ++index)
+    {
+        const auto &instance = instances[index];
+        auto *blas = static_cast<AccelerationStructureMtl *>(instance.blas->getImplementation());
+        const auto &generation = blas->getGeneration();
+        ANGLE_CHECK(context, generation, "Unbuilt Metal BLAS", GL_INVALID_OPERATION);
+        children.push_back(generation);
+        [nativeChildren.get() addObject:generation->get()];
+        auto &descriptor = descriptors[index];
+        // GLES transforms are row-major 3x4; Metal's packed matrix is column-major.
+        float *matrix = reinterpret_cast<float *>(&descriptor.transformationMatrix);
+        for (size_t column = 0; column < 4; ++column)
+        {
+            for (size_t row = 0; row < 3; ++row)
+            {
+                ANGLE_UNSAFE_TODO(matrix[column * 3 + row] = instance.transform[row * 4 + column]);
+            }
+        }
+        // Both APIs use clockwise front faces by default. Metal's counterclockwise
+        // instance bit implements the extension's Vulkan-compatible facing flip.
+        descriptor.options = static_cast<MTLAccelerationStructureInstanceOptions>(instance.flags);
+        descriptor.mask    = instance.mask;
+        descriptor.intersectionFunctionTableOffset = 0;
+        descriptor.accelerationStructureIndex      = index;
+        descriptor.userID                          = instance.customIndex;
+    }
+    const size_t bytes = descriptors.size() * sizeof(descriptors[0]);
+    mtl::BufferRef buffer;
+    ANGLE_TRY(mtl::Buffer::MakeBuffer(context, bytes, &buffer));
+    auto mapped = buffer->mapNoSync(context);
+    ANGLE_UNSAFE_TODO(memcpy(mapped.data(), descriptors.data(), bytes));
+    buffer->unmapAndFlushSubset(context, 0, bytes);
+    auto descriptor = [MTLInstanceAccelerationStructureDescriptor descriptor];
+    descriptor.instancedAccelerationStructures = nativeChildren.get();
+    descriptor.instanceDescriptorBuffer        = buffer->get();
+    descriptor.instanceDescriptorStride        = sizeof(descriptors[0]);
+    descriptor.instanceDescriptorType = MTLAccelerationStructureInstanceDescriptorTypeUserID;
+    descriptor.instanceCount          = count;
+    descriptor.usage = (flags & GL_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT)
+                           ? MTLAccelerationStructureUsagePreferFastBuild
+                           : MTLAccelerationStructureUsageNone;
+    return build(context, descriptor, {buffer}, std::move(children));
+}
+
+namespace
+{
+void UseGeneration(const std::shared_ptr<AccelerationStructureGenerationMtl> &generation,
+                   mtl::RenderCommandEncoder *render,
+                   mtl::ComputeCommandEncoder *compute,
+                   gl::ShaderType stage)
+{
+    if (render)
+    {
+        render->useResource(
+            generation, MTLResourceUsageRead,
+            stage == gl::ShaderType::Vertex ? MTLRenderStageVertex : MTLRenderStageFragment);
+    }
+    else
+    {
+        compute->useResource(generation, MTLResourceUsageRead);
+    }
+    // The command buffer retains every indirect resource, including BLAS objects
+    // referenced by the TLAS, until the GPU has finished using that generation.
+    for (const auto &child : generation->children)
+    {
+        UseGeneration(child, render, compute, stage);
+    }
+}
+}  // namespace
+void AccelerationStructureMtl::useForRead(mtl::RenderCommandEncoder *render,
+                                          mtl::ComputeCommandEncoder *compute,
+                                          gl::ShaderType stage) const
+{
+    ASSERT(mGeneration);
+    UseGeneration(mGeneration, render, compute, stage);
+}
+}  // namespace rx
