+// Metal does not allow the same texture to be supplied to multiple arguments
+// of one shader when any of those arguments can write.  Until image aliases
+// are lowered to a shared read/write argument, reject overlapping writable
+// bindings instead of issuing an invalid Metal draw.  Use the translated
+// shader's access qualifier, not the image unit's potentially broader access.
+bool ImageBindingsOverlap(const gl::ImageUnit &a, const gl::ImageUnit &b)
+{
+    if (!a.texture.get() || a.texture.get() != b.texture.get() || a.level != b.level)
+    {
+        return false;
+    }
+    if (a.texture->getType() == gl::TextureType::_3D)
+    {
+        // Non-layered 3D images use an entire 3D Metal view plus a layer index.
+        return true;
+    }
+    return a.layered || b.layered || a.layer == b.layer ||
+           a.texture->getType() == gl::TextureType::_2D;
+}
+
+angle::Result ValidateGraphicsImageAliases(const gl::Context *glContext,
+                                           const gl::ProgramExecutable &executable,
+                                           const mtl::TranslatedShaderInfo &shaderInfo)
+{
+    ContextMtl *context    = mtl::GetImpl(glContext);
+    const gl::State &state = glContext->getState();
+    struct ImageUse
+    {
+        const gl::ImageUnit *unit;
+        bool readOnly;
+    };
+    std::array<ImageUse, mtl::kMaxComputeTextures> usedImages = {};
+    size_t usedImageCount = 0;
+    const auto &bindings = executable.getImageBindings();
+    for (size_t imageIndex = 0; imageIndex < bindings.size(); ++imageIndex)
+    {
+        if (imageIndex >= shaderInfo.actualComputeImageBindings.size())
+        {
+            continue;
+        }
+        const uint32_t reflectedSlot = shaderInfo.actualComputeImageBindings[imageIndex];
+        const uint32_t firstSlot = reflectedSlot & ~angle::metal::kReadOnlyImageBindingBit;
+        if (firstSlot >= mtl::kMaxComputeTextures)
+        {
+            continue;
+        }
+        const bool readOnly = (reflectedSlot & angle::metal::kReadOnlyImageBindingBit) != 0;
+        const auto &units = bindings[imageIndex].boundImageUnits;
+        for (size_t element = 0; element < units.size(); ++element)
+        {
+            const gl::ImageUnit &image = state.getImageUnit(units[element]);
+            if (!image.texture.get())
+            {
+                continue;
+            }
+            for (size_t index = 0; index < usedImageCount; ++index)
+            {
+                const ImageUse &other = usedImages[index];
+                ANGLE_CHECK(context,
+                            !ImageBindingsOverlap(image, *other.unit) ||
+                                (readOnly && other.readOnly),
+                            "Overlapping writable Metal graphics images are not supported",
+                            GL_INVALID_OPERATION);
+            }
+            ASSERT(usedImageCount < usedImages.size());
+            usedImages[usedImageCount++] = {&image, readOnly};
+            if (readOnly)
+            {
+                continue;
+            }
+            for (size_t samplerIndex = 0; samplerIndex < executable.getSamplerBindings().size();
+                 ++samplerIndex)
+            {
+                const auto &metalSampler = shaderInfo.actualSamplerBindings[samplerIndex];
+                if (metalSampler.samplerBinding >= mtl::kMaxShaderSamplers ||
+                    metalSampler.textureBinding >= mtl::kMaxComputeTextures)
+                {
+                    continue;
+                }
+                const auto &sampler = executable.getSamplerBindings()[samplerIndex];
+                for (uint32_t samplerElement = 0; samplerElement < sampler.textureUnitsCount;
+                     ++samplerElement)
+                {
+                    const GLuint unit = sampler.getTextureUnit(
+                        executable.getSamplerBoundTextureUnits(), samplerElement);
+                    ANGLE_CHECK(context, state.getActiveTexturesCache()[unit] != image.texture.get(),
+                                "Sampling a writable Metal graphics image is not supported",
+                                GL_INVALID_OPERATION);
+                }
+            }
+        }
+    }
+    return angle::Result::Continue;
+}
