+angle::Result TextureMtl::bindToGraphicsAliasedImage(const gl::Context *context,
+                                                     mtl::RenderCommandEncoder *encoder,
+                                                     gl::ShaderType shaderType,
+                                                     int textureSlotIndex,
+                                                     int level,
+                                                     GLenum format)
+{
+    return bindToAliasedImageImpl(context, encoder, shaderType, textureSlotIndex, level, format);
+}
+
+angle::Result TextureMtl::bindToComputeAliasedImage(const gl::Context *context,
+                                                    mtl::ComputeCommandEncoder *encoder,
+                                                    int textureSlotIndex,
+                                                    int level,
+                                                    GLenum format)
+{
+    return bindToAliasedImageImpl(context, encoder, gl::ShaderType::Compute, textureSlotIndex,
+                                  level, format);
+}
+
+template <typename Encoder>
+angle::Result TextureMtl::bindToAliasedImageImpl(const gl::Context *context,
+                                                 Encoder *encoder,
+                                                 gl::ShaderType shaderType,
+                                                 int textureSlotIndex,
+                                                 int level,
+                                                 GLenum format)
+{
+    ASSERT(mNativeTextureStorage);
+    ASSERT(mState.getImmutableFormat());
+    ASSERT(0 <= level && static_cast<uint32_t>(level) < mState.getImmutableLevels());
+    ContextMtl *contextMtl = mtl::GetImpl(context);
+    const auto imageFormat =
+        contextMtl->getPixelFormat(angle::Format::InternalFormatToID(format));
+    auto &views = mAliasedShaderImageViews[imageFormat.metalFormat];
+    views.resize(mState.getImmutableLevels());
+    auto &view = views[level];
+    if (!view)
+    {
+        view = mNativeTextureStorage->createAliasedShaderImageView(level, imageFormat.metalFormat);
+    }
+    ANGLE_CHECK(contextMtl, view && view->valid(), "Cannot create Metal image alias view",
+                GL_INVALID_OPERATION);
+    encoder->setRWTexture(shaderType, view, textureSlotIndex);
+    return angle::Result::Continue;
+}
