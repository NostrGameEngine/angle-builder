+TextureRef Texture::createAliasedShaderImageView(const MipmapNativeLevel &level,
+                                                 MTLPixelFormat format)
+{
+    ASSERT(isShaderReadable());
+    ASSERT(isShaderWritable());
+    ASSERT(format == pixelFormat() || supportFormatView());
+    const MTLTextureType aliasType = textureType() == MTLTextureType3D
+                                         ? MTLTextureType3D : MTLTextureType2DArray;
+    return TextureRef(new Texture(this, format, aliasType, NSMakeRange(level.get(), 1),
+                                  NSMakeRange(0, cubeFacesOrArrayLength())));
+}
